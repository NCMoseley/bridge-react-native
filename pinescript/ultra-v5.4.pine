// A range session must be HHMM-HHMM. A bare length check admits any 9-char
// string — including a range name like "SACRAMENT" pasted into the session
// override — which crashes time() at runtime with an invalid-session error.
f_isValidSession(string _s) =>
    bool _ok = false
    if str.length(_s) == 9
        if str.substring(_s, 4, 5) == "-"
            float _h1 = str.tonumber(str.substring(_s, 0, 2))
            float _m1 = str.tonumber(str.substring(_s, 2, 4))
            float _h2 = str.tonumber(str.substring(_s, 5, 7))
            float _m2 = str.tonumber(str.substring(_s, 7, 9))
            _ok := not na(_h1) and _h1 >= 0 and _h1 <= 23 and not na(_m1) and _m1 >= 0 and _m1 <= 59 and not na(_h2) and _h2 >= 0 and _h2 <= 23 and not na(_m2) and _m2 >= 0 and _m2 <= 59
    _ok

f_hhmmToMinutes(string _hhmm) =>
    str.tonumber(str.substring(_hhmm, 0, 2)) * 60 + str.tonumber(str.substring(_hhmm, 2, 4))

