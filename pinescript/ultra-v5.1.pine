//─── Alert Configuration ───────────────────────────────────────────────────────
// Controls that affect when and how alerts fire
riskAmountUsd = riskAmountUsdOverride >= 0 ? riskAmountUsdOverride : presetRiskAmountUsd
string beStopOverrideInput = input.string("Preset", title = "BE Stop", options = ["Preset", "On", "Off"], group = "Break-Even Stop", tooltip = "On/Off forces the break-even stop; Preset uses the preset default.")
int beTriggerTicksOverrideInput = input.int(-1, title = "BE Trigger (override: -1 = use preset, 0+ = ticks)", minval = -1, group = "Break-Even Stop", tooltip = "Set to -1 to use the preset default, or a positive number of ticks the trade must move in your favor before the BE stop is applied.")
int beOffsetTicksOverrideInput = input.int(-1, title = "BE Offset (override: -1 = use preset, -100+ = ticks)", minval = -100, group = "Break-Even Stop", tooltip = "Set to -1 to use the preset default, 0 to move stop to exact entry, positive for profit, negative for below/above entry.")

bool useBeStop = beStopOverrideInput == "Preset" ? presetUseBeStopEnabled : beStopOverrideInput == "On"
int beTriggerTicks = beTriggerTicksOverrideInput >= 0 ? beTriggerTicksOverrideInput : presetBeTriggerTicks
int beOffsetTicks = beOffsetTicksOverrideInput != -1 ? beOffsetTicksOverrideInput : presetBeOffsetTicks
bool beStopOverridden = beStopOverrideInput != "Preset"
bool beTriggerOverridden = beTriggerTicksOverrideInput >= 0
bool beOffsetOverridden = beOffsetTicksOverrideInput != -1

//─── Range Bracket Orders ──────────────────────────────────────────────────────
bracketEntryOffsetTicks = input.int(1, title = "Entry Offset (ticks)", step = 1, group = "Range Bracket Orders", tooltip = "Signed offset from each range edge. Positive values move entries outside the range beyond ORH/ORL. Negative values move entries inside the range for earlier fills. Ultra sends a stop order when the entry is beyond the current price, otherwise a limit order.")
maxBracketEntriesPerRange = maxBracketEntriesOverride >= 0 ? maxBracketEntriesOverride : presetEntriesPerRange
oneFillPerSidePerRange = input.bool(false, title = "One Fill Per Side Per Range", group = "Range Bracket Orders", tooltip = "When enabled, each range can fill at most one long bracket and one short bracket. Same-side re-arms are blocked once that side has already filled.")
rearmSameSideStopAfterSl = input.bool(true, title = "Rearm Same-Side Stop After SL", group = "Range Bracket Orders", tooltip = "After a bracket trade reaches its stop-loss, sends a new pending stop-order alert at the same range edge with the current TP and SL settings.")
rearmSameSideStopAfterTp = input.bool(false, title = "Rearm Same-Side Stop After TP", group = "Range Bracket Orders", tooltip = "After a bracket trade reaches its final take-profit, waits for price to return through that range edge, then sends a new same-side pending stop-order alert. This avoids immediately re-entering while price remains beyond the edge.")
rearmSameSideStopAfterBe = input.bool(true, title = "Rearm Same-Side After BE Stop", group = "Range Bracket Orders", tooltip = "After a breakeven stop-out, waits for price to trade back inside the range on a later bar, then re-arms the same-side entry. The range-return wait prevents churn: a BE exit happens at/near the entry price, so an instant rearm would re-fill on the next bar.")
suppressOppositeAfterTp = input.bool(true, title = "Suppress Opposite Side After TP", group = "Range Bracket Orders", tooltip = "When a bracket trade reaches take-profit, marks the opposite side inactive in the strategy model. Configure the Bridge destination to perform actual pending-order cancellation.")
slCooldownBars = input.int(0, title = "SL Cooldown (bars)", minval = 0, group = "Range Bracket Orders", tooltip = "After a same-side stop-loss, block new entries on that side for N bars. 0 disables the cooldown.")

//─── Alert Reporting ───────────────────────────────────────────────────────────
// Lifecycle reporting is always on so bracket and trade lifecycle events are always emitted.
bool enablePineAlertLogs = true
bool sendLifecycleAlerts = true

//─── Strategy Settings ─────────────────────────────────────────────────────────
tpStyle = tpStyleOverride != "Preset" ? tpStyleOverride : presetTpStyle
tpTicksOverride = tpTicksOverrideInput >= 0 ? tpTicksOverrideInput : presetTpTicksOverride
slStyle = slStyleOverride != "Preset" ? slStyleOverride : presetSlStyle
slTicksOverride = slTicksOverrideInput >= 0 ? slTicksOverrideInput : presetSlTicksOverride
crSesh = str.length(rangeSessionOverride) > 0 ? rangeSessionOverride : activeRangeSession
activeRangeEnabled := str.length(crSesh) == 9 and crSesh != "0000-0000"

//─── Display ───────────────────────────────────────────────────────────────────
// Visual and cosmetic controls
showPresetInfo = input.bool(true, title = "Show Settings Info", group = "Display", tooltip = "Displays a panel on the chart showing the active configuration.")
useLightTableTheme = input.bool(false, title = "Use Light Table Theme", group = "Display", tooltip = "Uses a light blue and gray palette for the settings table. Disable for the dark blue and gray palette.")
sigTog = input.bool(true, title = "Show Signals", group = "Display")
showEntryIcons = input.bool(true, title = "Show Entry Icons", group = "Display", tooltip = "Plots a non-repainting icon below/above the bar where a long/short entry alert fires.")
sigSize = "huge"
upSigColor = #089981
downSigColor = #f23645

//─── Style ─────────────────────────────────────────────────────────────────────
color orColor = #9932cc
color orFillColor = color.new(color.gray,90)
string txtSize = "small"

invis = color.rgb(0,0,0,100)

//---------------------------------------------------------------------------------------------------------------------}
//Error
//---------------------------------------------------------------------------------------------------------------------{
if timeframe.in_seconds(timeframe.period) >= timeframe.in_seconds("D")
    runtime.error("Timeframe is too High! Please Reduce Timeframe to be Less-Than 1 Day.")

//---------------------------------------------------------------------------------------------------------------------}
//Functions
//---------------------------------------------------------------------------------------------------------------------{
// True when the bar's range actually contains the level — price traded at it.
// A bar entirely beyond the level does not qualify (e.g., price crossed while
// the order was not yet armed: cooldown, deferred rearm, or a range return).
barSpansLevel(float _level) =>
    not na(_level) and low <= _level and high >= _level

//─── Alert helpers (ported from 4.8.3 — payload structure unchanged) ────────────
isMiniProxyRoot() =>
    syminfo.root == "NQ" or syminfo.root == "ES" or syminfo.root == "YM" or syminfo.root == "GC" or syminfo.root == "BT"

quantityStep() =>
    syminfo.type == "futures" ? (isMiniProxyRoot() ? 0.1 : 1.0) : 0.01

quantityUnitSize() =>
    1.0 / quantityStep()

roundSizedQuantity(float _quantity) =>
    float _step = quantityStep()
    float _unitSize = quantityUnitSize()
    float _rounded = math.round(_quantity * _unitSize) / _unitSize
    math.max(_step, _rounded)

alertPriceIncrement() =>
    syminfo.type == "futures" and (syminfo.root == "MGC" or syminfo.root == "GC") ? 0.1 : 0.25

roundAlertPrice(float _price) =>
    math.round(_price / alertPriceIncrement()) * alertPriceIncrement()

lifecycleEscape(string _value) =>
    string _escaped = str.replace_all(_value, "\\", "\\\\")
    _escaped := str.replace_all(_escaped, "\"", "\\\"")
    str.replace_all(_escaped, "\n", "\\n")
    // NOTE: \\r is not a recognized escape in Pine and "\\r" would be interpreted as the literal letter r,
    // which corrupted every r in tradeId/eventId strings into a carriage return. We do not escape CRs here
    // because Pine strings built from code do not contain literal CRs.

alertTimeMs() =>
    na(time_close) ? time : time_close

rangeBracketAlertJson(string _action, float _quantity, float _entry, float _strategyStopPrice, string _id, string _side, string _exitFields, string _beStopFields, string _leg) =>
    float _roundedEntry = roundAlertPrice(_entry)
    float _roundedStrategyStop = roundAlertPrice(_strategyStopPrice)
    bool _isStop = _action == "buy" ? _roundedEntry > close : _roundedEntry < close
    string _orderFields = _isStop ? ',"orderType":"stop","stopPrice":' + str.tostring(_roundedEntry, format.mintick) : ',"orderType":"limit","limitPrice":' + str.tostring(_roundedEntry, format.mintick)
    string _strategyStopMode = "intrabar"
    '{"ticker":"' + syminfo.ticker + '","action":"' + _action + '","quantity":' + str.tostring(_quantity) + ',"quantityType":"fixed_quantity","price":' + str.tostring(_roundedEntry, format.mintick) + ',"signalPrice":' + str.tostring(_roundedEntry, format.mintick) + _orderFields + ',"bracketId":"' + _id + '","bracketSide":"' + _side + '","time":"' + str.tostring(alertTimeMs()) + '","interval":"' + timeframe.period + '"' + _exitFields + _beStopFields + ',"extras":{"source":"' + ultraSource + '","strategyStopPrice":' + str.tostring(_roundedStrategyStop, format.mintick) + ',"strategyStopMode":"' + _strategyStopMode + '","orderRole":"range_bracket","orderLeg":"' + _leg + '","rangeName":"' + lifecycleEscape(activeRangeName) + '"}}'

tradersPostRangeBracketExitFields(bool _isBuy, float _entry, float _tpDistance, float _slDistance, float _tpPercent, float _slPercent) =>
    string _takeProfit = ',"takeProfit":{"percent":' + str.tostring(_tpPercent) + '}'
    string _stopLoss = ',"stopLoss":{"type":"stop","percent":' + str.tostring(_slPercent) + '}'
    _takeProfit + _stopLoss

lifecycleSide(int _side) =>
    _side == 1 ? "long" : "short"

lifecycleNumber(float _value) =>
    float _rounded = math.round(_value * 100.0) / 100.0
    str.tostring(_rounded == 0 ? 0.0 : _rounded, "#.##")

lifecycleQuantity(float _quantity) =>
    str.tostring(_quantity, "#.######")

lifecycleTime() =>
    // Always use the bar close time for lifecycle timestamps.
    // Using timenow in realtime made every trade_closed payload different on each tick,
    // bypassing the per-bar alertFiredThisBar dedupe and causing duplicate/crashing alerts.
    int _barTime = na(time_close) ? time : time_close
    str.format_time(_barTime, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")

lifecycleBracketTradeId(string _bracketId, int _side, int _armIndex) =>
    _bracketId + "-lifecycle-" + lifecycleSide(_side) + "-" + str.tostring(_armIndex)

lifecycleEventId(string _tradeId, string _eventType, int _leg) =>
    _tradeId + "-" + _eventType + "-leg-" + str.tostring(_leg)

lifecycleEventJson(string _eventType, string _eventId, string _tradeId, int _side, string _action, float _quantity, float _entryPrice, float _exitPrice, float _realizedTicks, float _realizedDollars, string _outcome, bool _isClosed, string _exitReason) =>
    string _entryField = na(_entryPrice) ? "" : ',"entryPrice":' + str.tostring(_entryPrice, format.mintick)
    string _exitField = na(_exitPrice) ? "" : ',"exitPrice":' + str.tostring(_exitPrice, format.mintick)
    string _closeFields = _isClosed ? ',"closedAt":"' + lifecycleTime() + '","realizedTicks":' + lifecycleNumber(_realizedTicks) + ',"realizedDollars":' + lifecycleNumber(_realizedDollars) + ',"outcome":"' + _outcome + '"' : ""
    string _exitReasonField = _isClosed ? ',"exitReason":"' + _exitReason + '"' : ""
    '{"eventType":"' + _eventType + '","eventId":"' + lifecycleEscape(_eventId) + '","tradeId":"' + lifecycleEscape(_tradeId) + '","ticker":"' + lifecycleEscape(syminfo.ticker) + '","side":"' + lifecycleSide(_side) + '","action":"' + _action + '","quantity":' + lifecycleQuantity(_quantity) + _entryField + _exitField + _closeFields + ',"extras":{"source":"' + ultraSource + '","rangeName":"' + lifecycleEscape(activeRangeName) + '"' + _exitReasonField + '}}'

lifecycleEntryJson(string _eventType, string _tradeId, int _side, float _quantity, float _entryPrice, string _action) =>
    lifecycleEventJson(_eventType, lifecycleEventId(_tradeId, _eventType, 0), _tradeId, _side, _action, _quantity, _entryPrice, na, na, na, "", false, "")

lifecycleTradeClosedJson(string _tradeId, int _side, int _leg, float _quantity, float _entryPrice, float _exitPrice, string _exitReason) =>
    float _signedMove = (_exitPrice - _entryPrice) * (_side == 1 ? 1.0 : -1.0)
    float _realizedTicks = _signedMove / syminfo.mintick
    float _realizedDollars = _signedMove * pointValue * _quantity
    string _outcome = _realizedTicks > 0 ? "win" : _realizedTicks < 0 ? "loss" : "breakeven"
    lifecycleEventJson("trade_closed", lifecycleEventId(_tradeId, "trade_closed", _leg), _tradeId, _side, "exit", _quantity, _entryPrice, _exitPrice, _realizedTicks, _realizedDollars, _outcome, true, _exitReason)

logAlertFiring(string _alertType, string _condition) =>
    if enablePineAlertLogs
        log.info("ULTRA 5.1 FIRE side=" + _alertType + " reason=" + _condition + " bar=" + str.tostring(bar_index))

logAlertBlocked(string _alertType, string _reason) =>
    if enablePineAlertLogs
        log.info("ULTRA 5.1 BLOCK side=" + _alertType + " reason=" + _reason + " bar=" + str.tostring(bar_index))

targetStyleMultiplier(string _style) =>
    _style == "½ range" ? 0.5 :
     _style == "2/3 range" ? 2.0 / 3.0 :
     _style == "1× range" ? 1.0 :
     _style == "1.272 range" ? 0.272 :
     _style == "1.414 range" ? 0.414 :
     _style == "1.5× range" ? 1.5 :
     _style == "2× range" ? 2.0 :
     _style == "2.8× range" ? 2.8 :
     _style == "3× range" ? 3.0 :
     _style == "4× range" ? 4.0 :
     _style == "5× range" ? 5.1 :
     _style == "6× range" ? 6.0 :
     _style == "7× range" ? 7.0 :
     1.0

stopStyleMultiplier(string _style) =>
    _style == "¼ range" ? 0.25 :
     _style == "½ range" ? 0.5 :
     _style == "2/3 range" ? 2.0 / 3.0 :
     _style == "0.728 range" ? 0.728 :
     _style == "0.862 range" ? 0.862 :
     _style == "1× range" ? 0.95 :
     _style == "1.5× range" ? 1.5 :
     1.0

stopStyleDistance(string _style, int _ticks, float _rangeDistance, float _mintick) =>
    _style == "Ticks" ? _ticks * _mintick :
     _rangeDistance * stopStyleMultiplier(_style) + (_style == "Range + buffer" ? _rangeDistance * 0.272 : 0.0)

tpDistance(bool _isBuy, string _style, int _ticks, float _rangeDistance, float _rangeHigh, float _rangeLow, float _entryPrice, float _mintick) =>
    _style == "Ticks" ? _ticks * _mintick :
     _isBuy ? (_rangeHigh + _rangeDistance * targetStyleMultiplier(_style) - _entryPrice) :
      (_entryPrice - (_rangeLow - _rangeDistance * targetStyleMultiplier(_style)))

type target
    line ln
    label lab

int rangeLabelOffsetBars = 2

var bool or_sesh = false
varip int longRearmAfterBar = na
varip int shortRearmAfterBar = na
varip int longCooldownAfterBar = na
varip int shortCooldownAfterBar = na

var float orh = na
var float orl = na
float orm = math.avg(orh, orl)

var box or_bx = na
var target h_ln = target.new(na, na)
var target l_ln = target.new(na, na)
var line m_ln = na
var target long_tp_tg = target.new(na, na)
var target long_sl_tg = target.new(na, na)
var target short_tp_tg = target.new(na, na)
var target short_sl_tg = target.new(na, na)
var float long_tp = na
var float long_sl = na
var float short_tp = na
var float short_sl = na
var float longEntry = na
var float shortEntry = na
// Lifecycle state is varip so it is NOT rolled back between ticks on the
// realtime bar — fills, exits, and rearms sequence genuinely tick-by-tick.
// On historical bars varip behaves exactly like var.
int ORDER_INACTIVE = 0
int ORDER_ARMED = 1
int ORDER_ACTIVE = 2
int ORDER_AWAITING_REARM = 3
varip int entriesThisRange = 0
varip int longOrderState = ORDER_INACTIVE
varip int shortOrderState = ORDER_INACTIVE
varip bool longFilledThisRange = false
varip bool shortFilledThisRange = false
varip int longEntryBar = na
varip int shortEntryBar = na
varip bool longBeActive = false
varip bool shortBeActive = false
varip float longBeSl = na
varip float shortBeSl = na
var array<label> signalLabels = array.new_label()
varip int executionSeq = 0
varip int longEntryExecutionSeq = na
varip int shortEntryExecutionSeq = na
varip float longEntryBarHigh = na
varip float longEntryBarLow = na
varip float shortEntryBarHigh = na
varip float shortEntryBarLow = na
varip int signalEventsBar = na
varip array<float> longEntrySignals = array.new<float>(0)
varip array<float> shortEntrySignals = array.new<float>(0)
varip array<float> longTpSignals = array.new<float>(0)
varip array<float> shortTpSignals = array.new<float>(0)
varip array<float> longSlSignals = array.new<float>(0)
varip array<float> shortSlSignals = array.new<float>(0)
varip array<float> longBeSignals = array.new<float>(0)
varip array<float> shortBeSignals = array.new<float>(0)

//─── Bracket order alert state (4.8.3 port) ────────────────────────────────────
// varip so order identity/state survives realtime-bar recalculation.
var int currentRangeId = 0
var int rangeStartTime = na
varip int alertFiredBar = -1
varip array<string> alertFiredThisBar = array.new<string>(0)
varip array<string> alertQueue = array.new<string>(0)
varip int bracketPlacedBar = na
varip string bracketId = ""
varip int bracketRangeId = na
varip int bracketPlacementAlertBar = na
varip float bracketLongEntryPrice = na
varip float bracketShortEntryPrice = na
varip float bracketLongTpDistance = na
varip float bracketShortTpDistance = na
varip float bracketLongSlDistance = na
varip float bracketShortSlDistance = na
varip float bracketLongQuantity = na
varip float bracketShortQuantity = na
varip string bracketLongArmId = ""
varip string bracketShortArmId = ""
varip string bracketLongLifecycleTradeId = ""
varip string bracketShortLifecycleTradeId = ""
varip int bracketLongLifecycleArmIndex = 0
varip int bracketShortLifecycleArmIndex = 0

fireAlert(string _payload) =>
    if not na(_payload) and not array.includes(alertFiredThisBar, _payload)
        array.push(alertFiredThisBar, _payload)
        array.push(alertQueue, _payload)

executionSeq += 1
float _mintick = na(syminfo.mintick) or syminfo.mintick <= 0 ? 0.01 : syminfo.mintick
float effectiveLow = math.min(low, close)
float effectiveHigh = math.max(high, close)

if na(signalEventsBar) or signalEventsBar != bar_index
    array.clear(longEntrySignals)
    array.clear(shortEntrySignals)
    array.clear(longTpSignals)
    array.clear(shortTpSignals)
    array.clear(longSlSignals)
    array.clear(shortSlSignals)
    array.clear(longBeSignals)
    array.clear(shortBeSignals)
    signalEventsBar := bar_index

// Reset per-bar alert dedupe before any fireAlert calls
if bar_index != alertFiredBar
    array.clear(alertFiredThisBar)
    alertFiredBar := bar_index

or_sesh := activeRangeEnabled and not na(time(timeframe.period, crSesh, tz))
or_start = or_sesh and not or_sesh[1]
or_end = or_sesh[1] and not or_sesh

// Background wash for the active preset range session.
bgcolor(or_sesh ? color.new(orColor, 90) : na, title = "Active Preset Range", editable = true)

// On the first bar of the range session, seed the opening range from that bar.
if or_start
    orh := effectiveHigh
    orl := effectiveLow
    orm := math.avg(orh, orl)
    currentRangeId += 1
    rangeStartTime := time
    longRearmAfterBar := na
    shortRearmAfterBar := na
    longCooldownAfterBar := na
    shortCooldownAfterBar := na
    longEntry := na
    shortEntry := na
    entriesThisRange := 0
    longOrderState := ORDER_INACTIVE
    shortOrderState := ORDER_INACTIVE
    longFilledThisRange := false
    shortFilledThisRange := false
    longBeActive := false
    shortBeActive := false
    longBeSl := na
    shortBeSl := na
    longEntryBar := na
    shortEntryBar := na
    // Remove previous range drawings and signals so only the current range is visible.
    if not na(or_bx)
        or_bx.delete()
    if not na(h_ln.ln)
        h_ln.ln.delete()
    if not na(h_ln.lab)
        h_ln.lab.delete()
    if not na(l_ln.ln)
        l_ln.ln.delete()
    if not na(l_ln.lab)
        l_ln.lab.delete()
    if not na(m_ln)
        m_ln.delete()
    if not na(long_tp_tg.ln)
        long_tp_tg.ln.delete()
    if not na(long_tp_tg.lab)
        long_tp_tg.lab.delete()
    if not na(long_sl_tg.ln)
        long_sl_tg.ln.delete()
    if not na(long_sl_tg.lab)
        long_sl_tg.lab.delete()
    if not na(short_tp_tg.ln)
        short_tp_tg.ln.delete()
    if not na(short_tp_tg.lab)
        short_tp_tg.lab.delete()
    if not na(short_sl_tg.ln)
        short_sl_tg.ln.delete()
    if not na(short_sl_tg.lab)
        short_sl_tg.lab.delete()
    for lab in signalLabels
        lab.delete()
    array.clear(signalLabels)
    or_bx := box.new(bar_index, orh, bar_index, orl, border_color = orColor, bgcolor = orFillColor, border_width = 2)
    h_ln := target.new(line.new(bar_index, orh, bar_index, orh, color = orColor), na)
    l_ln := target.new(line.new(bar_index, orl, bar_index, orl, color = orColor), na)
    m_ln := line.new(bar_index, orm, bar_index, orm, style = line.style_dashed, color = orColor)

// Expand the range if price breaks the current bounds, and update the box/lines.
if or_sesh
    orh := math.max(orh, effectiveHigh)
    orl := math.min(orl, effectiveLow)
    orm := math.avg(orh, orl)
    if not na(or_bx)
        or_bx.set_top(orh)
        or_bx.set_bottom(orl)
        or_bx.set_right(bar_index)
        or_bx.set_border_color(orColor)
    if not na(h_ln.ln)
        h_ln.ln.set_xy1(h_ln.ln.get_x1(), orh)
        h_ln.ln.set_xy2(bar_index, orh)
    if not na(l_ln.ln)
        l_ln.ln.set_xy1(l_ln.ln.get_x1(), orl)
        l_ln.ln.set_xy2(bar_index, orl)
    if not na(m_ln)
        m_ln.set_xy1(m_ln.get_x1(), orm)
        m_ln.set_xy2(bar_index, orm)

// When the range session ends, pin the right edge of the box to the last range bar.
if not or_sesh and not na(or_bx)
    or_bx.set_right(bar_index)

// When the range forms, compute and draw the long/short TP and SL target levels.
if or_end and not na(orh) and not na(orl)
    float _rangeDistance = orh - orl
    long_tp := orh + tpDistance(true, tpStyle, tpTicksOverride, _rangeDistance, orh, orl, orh, _mintick)
    long_sl := orh - stopStyleDistance(slStyle, slTicksOverride, _rangeDistance, _mintick)
    short_tp := orl - tpDistance(false, tpStyle, tpTicksOverride, _rangeDistance, orh, orl, orl, _mintick)
    short_sl := orl + stopStyleDistance(slStyle, slTicksOverride, _rangeDistance, _mintick)
    longEntry := orh + bracketEntryOffsetTicks * _mintick
    shortEntry := orl - bracketEntryOffsetTicks * _mintick
    if not na(or_bx)
        or_bx.set_border_color(color.new(orColor, 100))
    long_tp_tg := target.new(line.new(bar_index, long_tp, bar_index, long_tp, color = color.new(#089981, 0), style = line.style_dotted), label.new(bar_index + rangeLabelOffsetBars, long_tp, text = "L TP", tooltip = str.tostring(long_tp, format.mintick), style = label.style_label_left, color = invis, textcolor = color.new(#089981, 0), size = txtSize))
    long_sl_tg := target.new(line.new(bar_index, long_sl, bar_index, long_sl, color = color.new(#f23645, 0), style = line.style_dotted), label.new(bar_index + rangeLabelOffsetBars, long_sl, text = "L SL", tooltip = str.tostring(long_sl, format.mintick), style = label.style_label_left, color = invis, textcolor = color.new(#f23645, 0), size = txtSize))
    short_tp_tg := target.new(line.new(bar_index, short_tp, bar_index, short_tp, color = color.new(#089981, 0), style = line.style_dotted), label.new(bar_index + rangeLabelOffsetBars, short_tp, text = "S TP", tooltip = str.tostring(short_tp, format.mintick), style = label.style_label_left, color = invis, textcolor = color.new(#089981, 0), size = txtSize))
    short_sl_tg := target.new(line.new(bar_index, short_sl, bar_index, short_sl, color = color.new(#f23645, 0), style = line.style_dotted), label.new(bar_index + rangeLabelOffsetBars, short_sl, text = "S SL", tooltip = str.tostring(short_sl, format.mintick), style = label.style_label_left, color = invis, textcolor = color.new(#f23645, 0), size = txtSize))

    //─── Place bracket orders on both sides of the formed range (4.8.3 port) ────
    // Distances derive from the already-computed TP/SL levels — no SL/TP logic change.
    // Gate: or_end is true on every tick of the boundary bar — run placement once
    // so arm indexes don't inflate and payloads stay identical across ticks.
    bool _bracketPlacementSignal = na(bracketPlacementAlertBar) or bracketPlacementAlertBar != bar_index
    if _bracketPlacementSignal
        bracketPlacementAlertBar := bar_index
        bracketPlacedBar := bar_index
        bracketId := ultraIdPrefix + syminfo.ticker + "-" + str.tostring(rangeStartTime) + "-" + str.tostring(currentRangeId)
        bracketRangeId := currentRangeId
        bracketLongEntryPrice := longEntry
        bracketShortEntryPrice := shortEntry
        bracketLongTpDistance := long_tp - longEntry
        bracketShortTpDistance := shortEntry - short_tp
        bracketLongSlDistance := longEntry - long_sl
        bracketShortSlDistance := short_sl - shortEntry
        float _longRiskPerUnit = bracketLongSlDistance * pointValue
        float _shortRiskPerUnit = bracketShortSlDistance * pointValue
        bracketLongQuantity := _longRiskPerUnit > 0 ? roundSizedQuantity(riskAmountUsd / _longRiskPerUnit) : quantityStep()
        bracketShortQuantity := _shortRiskPerUnit > 0 ? roundSizedQuantity(riskAmountUsd / _shortRiskPerUnit) : quantityStep()
        int _entryCapacity = oneFillPerSidePerRange ? math.min(maxBracketEntriesPerRange, 2) : maxBracketEntriesPerRange
        bool _longArmAllowed = _entryCapacity > 0 and bracketLongQuantity > 0
        bool _shortArmAllowed = _entryCapacity > 0 and bracketShortQuantity > 0
        string _beStopField = ""
        if _longArmAllowed
            bracketLongLifecycleArmIndex += 1
            bracketLongArmId := bracketId + "-long-arm-" + str.tostring(bracketLongLifecycleArmIndex)
            bracketLongLifecycleTradeId := lifecycleBracketTradeId(bracketLongArmId, 1, 0)
            longOrderState := ORDER_ARMED
            float _longTpPercent = longEntry != 0 ? math.abs(long_tp - longEntry) / math.abs(longEntry) * 100.0 : 0.0
            float _longSlPercent = longEntry != 0 ? math.abs(longEntry - long_sl) / math.abs(longEntry) * 100.0 : 0.0
            string _bracketBuyJson = rangeBracketAlertJson("buy", bracketLongQuantity, longEntry, long_sl, bracketLongArmId, "long", tradersPostRangeBracketExitFields(true, longEntry, bracketLongTpDistance, bracketLongSlDistance, _longTpPercent, _longSlPercent), _beStopField, "single")
            logAlertFiring("bracket_buy", "range_end/single qty=" + str.tostring(bracketLongQuantity, "#.##"))
            fireAlert(_bracketBuyJson)
            if sendLifecycleAlerts
                fireAlert(lifecycleEntryJson("entry_armed", bracketLongLifecycleTradeId, 1, bracketLongQuantity, longEntry, "buy"))
        else
            longOrderState := ORDER_INACTIVE
            logAlertBlocked("bracket_buy", "not_armed")
        if _shortArmAllowed
            bracketShortLifecycleArmIndex += 1
            bracketShortArmId := bracketId + "-short-arm-" + str.tostring(bracketShortLifecycleArmIndex)
            bracketShortLifecycleTradeId := lifecycleBracketTradeId(bracketShortArmId, -1, 0)
            shortOrderState := ORDER_ARMED
            float _shortTpPercent = shortEntry != 0 ? math.abs(shortEntry - short_tp) / math.abs(shortEntry) * 100.0 : 0.0
            float _shortSlPercent = shortEntry != 0 ? math.abs(short_sl - shortEntry) / math.abs(shortEntry) * 100.0 : 0.0
            string _bracketSellJson = rangeBracketAlertJson("sell", bracketShortQuantity, shortEntry, short_sl, bracketShortArmId, "short", tradersPostRangeBracketExitFields(false, shortEntry, bracketShortTpDistance, bracketShortSlDistance, _shortTpPercent, _shortSlPercent), _beStopField, "single")
            logAlertFiring("bracket_sell", "range_end/single qty=" + str.tostring(bracketShortQuantity, "#.##"))
            fireAlert(_bracketSellJson)
            if sendLifecycleAlerts
                fireAlert(lifecycleEntryJson("entry_armed", bracketShortLifecycleTradeId, -1, bracketShortQuantity, shortEntry, "sell"))
        else
            shortOrderState := ORDER_INACTIVE
            logAlertBlocked("bracket_sell", "not_armed")

// Extend bracket target lines and labels after the range has formed.
if not or_sesh and not na(long_tp_tg.ln)
    long_tp_tg.ln.set_xy2(bar_index, long_tp)
    long_tp_tg.lab.set_x(bar_index + rangeLabelOffsetBars)
    long_tp_tg.lab.set_y(long_tp)
    long_tp_tg.lab.set_text("L TP")
    long_sl_tg.ln.set_xy2(bar_index, long_sl)
    long_sl_tg.lab.set_x(bar_index + rangeLabelOffsetBars)
    long_sl_tg.lab.set_y(long_sl)
    long_sl_tg.lab.set_text("L SL")
    short_tp_tg.ln.set_xy2(bar_index, short_tp)
    short_tp_tg.lab.set_x(bar_index + rangeLabelOffsetBars)
    short_tp_tg.lab.set_y(short_tp)
    short_tp_tg.lab.set_text("S TP")
    short_sl_tg.ln.set_xy2(bar_index, short_sl)
    short_sl_tg.lab.set_x(bar_index + rangeLabelOffsetBars)
    short_sl_tg.lab.set_y(short_sl)
    short_sl_tg.lab.set_text("S SL")

// Visual trade lifecycle for the formed range. Respects max entries per range, one-fill-per-side, and rearm settings.
int maxEntriesThisRange = oneFillPerSidePerRange ? (maxBracketEntriesPerRange < 2 ? maxBracketEntriesPerRange : 2) : maxBracketEntriesPerRange

// Post-close re-entry gating. A side is not ARMED until a fresh bracket order is dispatched.
bool _longRearmEligible = longOrderState == ORDER_AWAITING_REARM and entriesThisRange < maxEntriesThisRange and (not oneFillPerSidePerRange or not longFilledThisRange)
bool _longRearmCooldownReady = na(longCooldownAfterBar) or bar_index > longCooldownAfterBar
bool _longRearmRangeReady = not na(longRearmAfterBar) and bar_index > longRearmAfterBar and not na(orh) and low <= orh
if longOrderState == ORDER_AWAITING_REARM and not _longRearmEligible
    longOrderState := ORDER_INACTIVE
if _longRearmEligible and ((na(longRearmAfterBar) and _longRearmCooldownReady) or _longRearmRangeReady)
    bracketLongLifecycleArmIndex += 1
    bracketLongArmId := bracketId + "-long-arm-" + str.tostring(bracketLongLifecycleArmIndex)
    bracketLongLifecycleTradeId := lifecycleBracketTradeId(bracketLongArmId, 1, 0)
    bracketPlacedBar := bar_index
    float _longRiskPerUnit = bracketLongSlDistance * pointValue
    bracketLongQuantity := _longRiskPerUnit > 0 ? roundSizedQuantity(riskAmountUsd / _longRiskPerUnit) : quantityStep()
    if bracketLongQuantity > 0
        float _longTpPercent = longEntry != 0 ? math.abs(bracketLongTpDistance) / math.abs(longEntry) * 100.0 : 0.0
        float _longSlPercent = longEntry != 0 ? math.abs(bracketLongSlDistance) / math.abs(longEntry) * 100.0 : 0.0
        string _bracketBuyJson = rangeBracketAlertJson("buy", bracketLongQuantity, longEntry, long_sl, bracketLongArmId, "long", tradersPostRangeBracketExitFields(true, longEntry, bracketLongTpDistance, bracketLongSlDistance, _longTpPercent, _longSlPercent), "", "single")
        longOrderState := ORDER_ARMED
        longRearmAfterBar := na
        longCooldownAfterBar := na
        logAlertFiring("bracket_buy", "rearm/single qty=" + str.tostring(bracketLongQuantity, "#.##"))
        fireAlert(_bracketBuyJson)
        if sendLifecycleAlerts
            fireAlert(lifecycleEntryJson("entry_armed", bracketLongLifecycleTradeId, 1, bracketLongQuantity, longEntry, "buy"))
    else
        longOrderState := ORDER_INACTIVE
        longRearmAfterBar := na
        longCooldownAfterBar := na
        logAlertBlocked("bracket_buy", "rearm_zero_quantity")

bool _shortRearmEligible = shortOrderState == ORDER_AWAITING_REARM and entriesThisRange < maxEntriesThisRange and (not oneFillPerSidePerRange or not shortFilledThisRange)
bool _shortRearmCooldownReady = na(shortCooldownAfterBar) or bar_index > shortCooldownAfterBar
bool _shortRearmRangeReady = not na(shortRearmAfterBar) and bar_index > shortRearmAfterBar and not na(orl) and high >= orl
if shortOrderState == ORDER_AWAITING_REARM and not _shortRearmEligible
    shortOrderState := ORDER_INACTIVE
if _shortRearmEligible and ((na(shortRearmAfterBar) and _shortRearmCooldownReady) or _shortRearmRangeReady)
    bracketShortLifecycleArmIndex += 1
    bracketShortArmId := bracketId + "-short-arm-" + str.tostring(bracketShortLifecycleArmIndex)
    bracketShortLifecycleTradeId := lifecycleBracketTradeId(bracketShortArmId, -1, 0)
    bracketPlacedBar := bar_index
    float _shortRiskPerUnit = bracketShortSlDistance * pointValue
    bracketShortQuantity := _shortRiskPerUnit > 0 ? roundSizedQuantity(riskAmountUsd / _shortRiskPerUnit) : quantityStep()
    if bracketShortQuantity > 0
        float _shortTpPercent = shortEntry != 0 ? math.abs(bracketShortTpDistance) / math.abs(shortEntry) * 100.0 : 0.0
        float _shortSlPercent = shortEntry != 0 ? math.abs(bracketShortSlDistance) / math.abs(shortEntry) * 100.0 : 0.0
        string _bracketSellJson = rangeBracketAlertJson("sell", bracketShortQuantity, shortEntry, short_sl, bracketShortArmId, "short", tradersPostRangeBracketExitFields(false, shortEntry, bracketShortTpDistance, bracketShortSlDistance, _shortTpPercent, _shortSlPercent), "", "single")
        shortOrderState := ORDER_ARMED
        shortRearmAfterBar := na
        shortCooldownAfterBar := na
        logAlertFiring("bracket_sell", "rearm/single qty=" + str.tostring(bracketShortQuantity, "#.##"))
        fireAlert(_bracketSellJson)
        if sendLifecycleAlerts
            fireAlert(lifecycleEntryJson("entry_armed", bracketShortLifecycleTradeId, -1, bracketShortQuantity, shortEntry, "sell"))
    else
        shortOrderState := ORDER_INACTIVE
        shortRearmAfterBar := na
        shortCooldownAfterBar := na
        logAlertBlocked("bracket_sell", "rearm_zero_quantity")

// Entry permission: a side may fill only when its order is armed, no trade is
// running, the per-range cap has room, and any post-SL cooldown has elapsed.
bool longEntryAllowed = not or_sesh and longOrderState == ORDER_ARMED and shortOrderState != ORDER_ACTIVE and entriesThisRange < maxEntriesThisRange and (na(longCooldownAfterBar) or bar_index > longCooldownAfterBar)

// Long side. A fill happens when the armed order's level is traded on this bar.
if longEntryAllowed and barSpansLevel(longEntry)
    longOrderState := ORDER_ACTIVE
    longFilledThisRange := true
    longBeActive := false
    longBeSl := na
    entriesThisRange := entriesThisRange + 1
    longEntryBar := bar_index
    longEntryExecutionSeq := executionSeq
    longEntryBarHigh := high
    longEntryBarLow := low
    if sendLifecycleAlerts and bracketLongQuantity > 0
        fireAlert(lifecycleEntryJson("entry_filled", bracketLongLifecycleTradeId, 1, bracketLongQuantity, bracketLongEntryPrice, "buy"))
    if showEntryIcons
        array.push(longEntrySignals, longEntry)
for entryPrice in longEntrySignals
    array.push(signalLabels, label.new(bar_index, entryPrice, text = "▲", style = label.style_label_center, color = invis, textcolor = upSigColor, size = sigSize))
// On the fill bar, OHLC cannot sequence a stop-entry against its own target
// and stop when they all trade in one candle. Defer those ambiguous fills;
// a gap fill at the bar's open (open >= longEntry) is deterministic, so only
// a stop touch without a same-bar target touch can resolve it.
bool _deferLongFill = not barstate.isrealtime and not na(longEntryBar) and bar_index == longEntryBar and not na(long_sl) and low <= long_sl and ((not na(long_tp) and high >= long_tp) or open < longEntry)
bool _longRealtimeEntryBar = barstate.isrealtime and not na(longEntryBar) and bar_index == longEntryBar
bool _longExitReady = not _longRealtimeEntryBar or (not na(longEntryExecutionSeq) and executionSeq > longEntryExecutionSeq)
bool _longNewEntryBarHigh = _longRealtimeEntryBar and not na(longEntryBarHigh) and high > longEntryBarHigh
bool _longNewEntryBarLow = _longRealtimeEntryBar and not na(longEntryBarLow) and low < longEntryBarLow
bool _longTpHit = _longRealtimeEntryBar ? close >= long_tp or (_longNewEntryBarHigh and high >= long_tp) : high >= long_tp
bool _longBeTriggerHit = _longRealtimeEntryBar ? close >= longEntry + beTriggerTicks * _mintick or (_longNewEntryBarHigh and high >= longEntry + beTriggerTicks * _mintick) : high >= longEntry + beTriggerTicks * _mintick
bool _longBeSlHit = _longRealtimeEntryBar ? close <= longBeSl or (_longNewEntryBarLow and low <= longBeSl) : low <= longBeSl
bool _longSlHit = _longRealtimeEntryBar ? close <= long_sl or (_longNewEntryBarLow and low <= long_sl) : low <= long_sl
if longOrderState == ORDER_ACTIVE and not _deferLongFill and _longExitReady
    if not na(long_tp) and _longTpHit
        bool _longCanRearmAfterTp = rearmSameSideStopAfterTp and entriesThisRange < maxEntriesThisRange and (not oneFillPerSidePerRange or not longFilledThisRange)
        longOrderState := _longCanRearmAfterTp ? ORDER_AWAITING_REARM : ORDER_INACTIVE
        longBeActive := false
        if sendLifecycleAlerts and bracketLongQuantity > 0
            fireAlert(lifecycleTradeClosedJson(bracketLongLifecycleTradeId, 1, 1, bracketLongQuantity, bracketLongEntryPrice, long_tp, "take_profit"))
        if sigTog
            array.push(longTpSignals, long_tp)
        // After TP, the next entry cannot trigger until price trades back inside the range on a later bar.
        if _longCanRearmAfterTp
            longRearmAfterBar := bar_index
        if suppressOppositeAfterTp
            shortOrderState := ORDER_INACTIVE
            shortRearmAfterBar := na
            shortCooldownAfterBar := na
    else if useBeStop and longBeActive and not na(longBeSl) and _longBeSlHit
        longOrderState := ORDER_INACTIVE
        longBeActive := false
        longRearmAfterBar := na
        if sendLifecycleAlerts and bracketLongQuantity > 0
            fireAlert(lifecycleTradeClosedJson(bracketLongLifecycleTradeId, 1, 1, bracketLongQuantity, bracketLongEntryPrice, longBeSl, "protected_stop"))
        if sigTog
            array.push(longBeSignals, longBeSl)
    else if not na(long_sl) and _longSlHit
        bool _longCanRearmAfterSl = rearmSameSideStopAfterSl and entriesThisRange < maxEntriesThisRange and (not oneFillPerSidePerRange or not longFilledThisRange)
        longOrderState := _longCanRearmAfterSl ? ORDER_AWAITING_REARM : ORDER_INACTIVE
        longBeActive := false
        longRearmAfterBar := na
        if sendLifecycleAlerts and bracketLongQuantity > 0
            fireAlert(lifecycleTradeClosedJson(bracketLongLifecycleTradeId, 1, 1, bracketLongQuantity, bracketLongEntryPrice, long_sl, "stop_loss"))
        if sigTog
            array.push(longSlSignals, long_sl)
        longCooldownAfterBar := slCooldownBars > 0 ? bar_index + slCooldownBars : na
if longOrderState == ORDER_ACTIVE and not _deferLongFill and _longExitReady and useBeStop and not longBeActive and not na(longEntry) and _longBeTriggerHit
    longBeActive := true
    longBeSl := longEntry + beOffsetTicks * _mintick
if longOrderState == ORDER_ACTIVE and not _deferLongFill and _longExitReady and useBeStop and longBeActive and not na(longBeSl) and _longBeSlHit
    longOrderState := ORDER_INACTIVE
    longBeActive := false
    longRearmAfterBar := na
    if sendLifecycleAlerts and bracketLongQuantity > 0
        fireAlert(lifecycleTradeClosedJson(bracketLongLifecycleTradeId, 1, 1, bracketLongQuantity, bracketLongEntryPrice, longBeSl, "protected_stop"))
    if sigTog
        array.push(longBeSignals, longBeSl)

// Short side. A fill happens when the armed order's level is traded on this bar.
bool shortEntryAllowed = not or_sesh and shortOrderState == ORDER_ARMED and longOrderState != ORDER_ACTIVE and entriesThisRange < maxEntriesThisRange and (na(shortCooldownAfterBar) or bar_index > shortCooldownAfterBar)
if shortEntryAllowed and barSpansLevel(shortEntry)
    shortOrderState := ORDER_ACTIVE
    shortFilledThisRange := true
    shortBeActive := false
    shortBeSl := na
    entriesThisRange := entriesThisRange + 1
    shortEntryBar := bar_index
    shortEntryExecutionSeq := executionSeq
    shortEntryBarHigh := high
    shortEntryBarLow := low
    if sendLifecycleAlerts and bracketShortQuantity > 0
        fireAlert(lifecycleEntryJson("entry_filled", bracketShortLifecycleTradeId, -1, bracketShortQuantity, bracketShortEntryPrice, "sell"))
    if showEntryIcons
        array.push(shortEntrySignals, shortEntry)
for entryPrice in shortEntrySignals
    array.push(signalLabels, label.new(bar_index, entryPrice, text = "▼", style = label.style_label_center, color = invis, textcolor = downSigColor, size = sigSize))
// Same fill-bar ambiguity rule as the long side: defer the exit unless the
// short filled at the bar's open and its target did not also trade.
bool _deferShortFill = not barstate.isrealtime and not na(shortEntryBar) and bar_index == shortEntryBar and not na(short_sl) and high >= short_sl and ((not na(short_tp) and low <= short_tp) or open > shortEntry)
bool _shortRealtimeEntryBar = barstate.isrealtime and not na(shortEntryBar) and bar_index == shortEntryBar
bool _shortExitReady = not _shortRealtimeEntryBar or (not na(shortEntryExecutionSeq) and executionSeq > shortEntryExecutionSeq)
bool _shortNewEntryBarHigh = _shortRealtimeEntryBar and not na(shortEntryBarHigh) and high > shortEntryBarHigh
bool _shortNewEntryBarLow = _shortRealtimeEntryBar and not na(shortEntryBarLow) and low < shortEntryBarLow
bool _shortTpHit = _shortRealtimeEntryBar ? close <= short_tp or (_shortNewEntryBarLow and low <= short_tp) : low <= short_tp
bool _shortBeTriggerHit = _shortRealtimeEntryBar ? close <= shortEntry - beTriggerTicks * _mintick or (_shortNewEntryBarLow and low <= shortEntry - beTriggerTicks * _mintick) : low <= shortEntry - beTriggerTicks * _mintick
bool _shortBeSlHit = _shortRealtimeEntryBar ? close >= shortBeSl or (_shortNewEntryBarHigh and high >= shortBeSl) : high >= shortBeSl
bool _shortSlHit = _shortRealtimeEntryBar ? close >= short_sl or (_shortNewEntryBarHigh and high >= short_sl) : high >= short_sl
if shortOrderState == ORDER_ACTIVE and not _deferShortFill and _shortExitReady
    if not na(short_tp) and _shortTpHit
        bool _shortCanRearmAfterTp = rearmSameSideStopAfterTp and entriesThisRange < maxEntriesThisRange and (not oneFillPerSidePerRange or not shortFilledThisRange)
        shortOrderState := _shortCanRearmAfterTp ? ORDER_AWAITING_REARM : ORDER_INACTIVE
        shortBeActive := false
        if sendLifecycleAlerts and bracketShortQuantity > 0
            fireAlert(lifecycleTradeClosedJson(bracketShortLifecycleTradeId, -1, 1, bracketShortQuantity, bracketShortEntryPrice, short_tp, "take_profit"))
        if sigTog
            array.push(shortTpSignals, short_tp)
        // After TP, the next entry cannot trigger until price trades back inside the range on a later bar.
        if _shortCanRearmAfterTp
            shortRearmAfterBar := bar_index
        if suppressOppositeAfterTp
            longOrderState := ORDER_INACTIVE
            longRearmAfterBar := na
            longCooldownAfterBar := na
    else if useBeStop and shortBeActive and not na(shortBeSl) and _shortBeSlHit
        shortOrderState := ORDER_INACTIVE
        shortBeActive := false
        shortRearmAfterBar := na
        if sendLifecycleAlerts and bracketShortQuantity > 0
            fireAlert(lifecycleTradeClosedJson(bracketShortLifecycleTradeId, -1, 1, bracketShortQuantity, bracketShortEntryPrice, shortBeSl, "protected_stop"))
        if sigTog
            array.push(shortBeSignals, shortBeSl)
    else if not na(short_sl) and _shortSlHit
        bool _shortCanRearmAfterSl = rearmSameSideStopAfterSl and entriesThisRange < maxEntriesThisRange and (not oneFillPerSidePerRange or not shortFilledThisRange)
        shortOrderState := _shortCanRearmAfterSl ? ORDER_AWAITING_REARM : ORDER_INACTIVE
        shortBeActive := false
        shortRearmAfterBar := na
        if sendLifecycleAlerts and bracketShortQuantity > 0
            fireAlert(lifecycleTradeClosedJson(bracketShortLifecycleTradeId, -1, 1, bracketShortQuantity, bracketShortEntryPrice, short_sl, "stop_loss"))
        if sigTog
            array.push(shortSlSignals, short_sl)
        shortCooldownAfterBar := slCooldownBars > 0 ? bar_index + slCooldownBars : na
if shortOrderState == ORDER_ACTIVE and not _deferShortFill and _shortExitReady and useBeStop and not shortBeActive and not na(shortEntry) and _shortBeTriggerHit
    shortBeActive := true
    shortBeSl := shortEntry - beOffsetTicks * _mintick
if shortOrderState == ORDER_ACTIVE and not _deferShortFill and _shortExitReady and useBeStop and shortBeActive and not na(shortBeSl) and _shortBeSlHit
    shortOrderState := ORDER_INACTIVE
    shortBeActive := false
    shortRearmAfterBar := na
    if sendLifecycleAlerts and bracketShortQuantity > 0
        fireAlert(lifecycleTradeClosedJson(bracketShortLifecycleTradeId, -1, 1, bracketShortQuantity, bracketShortEntryPrice, shortBeSl, "protected_stop"))
    if sigTog
        array.push(shortBeSignals, shortBeSl)

// Current-bar exit icons are redrawn from persisted prices after realtime rollback.
for exitPrice in longTpSignals
    array.push(signalLabels, label.new(bar_index, exitPrice, text = "◆", style = label.style_label_center, color = invis, textcolor = #089981, size = sigSize))
for exitPrice in shortTpSignals
    array.push(signalLabels, label.new(bar_index, exitPrice, text = "◆", style = label.style_label_center, color = invis, textcolor = #089981, size = sigSize))
for exitPrice in longSlSignals
    array.push(signalLabels, label.new(bar_index, exitPrice, text = "✕", style = label.style_label_center, color = invis, textcolor = #f23645, size = sigSize))
for exitPrice in shortSlSignals
    array.push(signalLabels, label.new(bar_index, exitPrice, text = "✕", style = label.style_label_center, color = invis, textcolor = #f23645, size = sigSize))
for exitPrice in longBeSignals
    array.push(signalLabels, label.new(bar_index, exitPrice, text = "✕", style = label.style_label_center, color = invis, textcolor = color.black, size = sigSize))
for exitPrice in shortBeSignals
    array.push(signalLabels, label.new(bar_index, exitPrice, text = "✕", style = label.style_label_center, color = invis, textcolor = color.black, size = sigSize))

//---------------------------------------------------------------------------------------------------------------------}
//Settings Info Panel
//---------------------------------------------------------------------------------------------------------------------{

renderPresetInfoPanel() =>
    color panelBg = useLightTableTheme ? #f1f5f9 : #111827
    color panelBorder = useLightTableTheme ? #94a3b8 : #334155
    color panelHeader = useLightTableTheme ? #2563eb : #1d4ed8
    color panelLabel = useLightTableTheme ? #475569 : #94a3b8
    color panelValue = useLightTableTheme ? #0f172a : #e2e8f0
    color panelMuted = useLightTableTheme ? #64748b : #64748b
    color panelAccent = useLightTableTheme ? #0f5cc0 : #38bdf8
    color panelWarning = useLightTableTheme ? #b45309 : #fbbf24
    bool rangeSessionOverridden = crSesh != activeRangeSession
    bool riskOverridden = riskAmountUsd != presetRiskAmountUsd
    bool entriesOverridden = maxBracketEntriesPerRange != presetEntriesPerRange
    bool tpStyleOverridden = tpStyle != presetTpStyle
    bool tpTicksOverridden = tpTicksOverride != presetTpTicksOverride
    bool slStyleOverridden = slStyle != presetSlStyle
    bool slTicksOverridden = slTicksOverride != presetSlTicksOverride
    string presetTpLabel = presetTpStyle == "Ticks" ? str.tostring(presetTpTicksOverride) + " ticks" : presetTpStyle
    string tpLabel = tpStyle == "Ticks" ? str.tostring(tpTicksOverride) + " ticks" : tpStyle
    string presetSlLabel = presetSlStyle == "Ticks" ? str.tostring(presetSlTicksOverride) + " ticks" : presetSlStyle
    string slLabel = slStyle == "Ticks" ? str.tostring(slTicksOverride) + " ticks" : slStyle
    string riskLabel = "$" + str.tostring(riskAmountUsd, "#.##") + (riskOverridden ? " / P $" + str.tostring(presetRiskAmountUsd, "#.##") : "")
    string entriesLabel = str.tostring(maxBracketEntriesPerRange) + (entriesOverridden ? " / P " + str.tostring(presetEntriesPerRange) : "")
    float _buyQty = na
    float _sellQty = na
    if not na(orh) and not na(orl)
        float _rangeDistance = orh - orl
        float _buySlDist = stopStyleDistance(slStyle, slTicksOverride, _rangeDistance, _mintick)
        float _sellSlDist = stopStyleDistance(slStyle, slTicksOverride, _rangeDistance, _mintick)
        _buyQty := _buySlDist > 0 ? riskAmountUsd / (_buySlDist * pointValue) : na
        _sellQty := _sellSlDist > 0 ? riskAmountUsd / (_sellSlDist * pointValue) : na
    string quantityLabel = not na(_buyQty) and not na(_sellQty) ? str.tostring(_buyQty, "#.##") + " / " + str.tostring(_sellQty, "#.##") : "N/A / N/A"
    string afterTpLabel = rearmSameSideStopAfterTp ? "Rearm Same (Range Return)" : suppressOppositeAfterTp ? "Suppress Opposite" : "Keep Opposite"
    string beStopLabel = useBeStop ? "On" : "Off"
    string beTriggerLabel = useBeStop ? str.tostring(beTriggerTicks) + " ticks" : "N/A"
    string beOffsetLabel = useBeStop ? str.tostring(beOffsetTicks) + " ticks" : "N/A"
    string presetBeStopLabel = presetUseBeStopEnabled ? "On" : "Off"
    string presetStatusLabel = activeRangeEnabled ? "Active" : "Inactive: no range"
    color presetStatusColor = activeRangeEnabled ? panelAccent : panelWarning
    var table info = table.new(position.bottom_right, 2, 16, bgcolor = panelBg, border_width = 1, border_color = panelBorder)
    table.cell(info, 0, 0, "ULTRA", text_color = color.white, bgcolor = orColor, text_size = size.large, text_halign = text.align_left)
    table.cell(info, 1, 0, "5.1", text_color = color.white, bgcolor = orColor, text_size = size.large, text_halign = text.align_right)
    table.cell(info, 0, 1, "Range", text_color = color.black, bgcolor = color.from_gradient(1.0, 0.0, 3.0, #ff00ff, #ffff00), text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 1, activeRangeName, text_color = color.black, bgcolor = color.from_gradient(1.0, 0.0, 3.0, #ff00ff, #ffff00), text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 2, "Preset Status", text_color = color.black, bgcolor = color.from_gradient(2.0, 0.0, 3.0, #ff00ff, #ffff00), text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 2, presetStatusLabel, text_color = color.black, bgcolor = color.from_gradient(2.0, 0.0, 3.0, #ff00ff, #ffff00), text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 3, "Chart / Preset", text_color = color.black, bgcolor = color.from_gradient(3.0, 0.0, 3.0, #ff00ff, #ffff00), text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 3, syminfo.ticker + " / " + presetInstrument, text_color = color.black, bgcolor = color.from_gradient(3.0, 0.0, 3.0, #ff00ff, #ffff00), text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 4, "Range Session", text_color = panelLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 4, crSesh + (rangeSessionOverridden ? " / P " + activeRangeSession : ""), text_color = rangeSessionOverridden ? panelAccent : activeRangeEnabled ? panelValue : panelMuted, text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 5, "Risk / Trade", text_color = panelLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 5, riskLabel, text_color = riskOverridden ? panelAccent : panelValue, text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 6, "Entries / Range", text_color = panelLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 6, entriesLabel, text_color = entriesOverridden ? panelAccent : panelValue, text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 7, "TP", text_color = panelLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 7, tpLabel + ((tpStyleOverridden or tpTicksOverridden) ? " / P " + presetTpLabel : ""), text_color = tpStyleOverridden or tpTicksOverridden ? panelAccent : panelValue, text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 8, "SL", text_color = panelLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 8, slLabel + ((slStyleOverridden or slTicksOverridden) ? " / P " + presetSlLabel : ""), text_color = slStyleOverridden or slTicksOverridden ? panelAccent : panelValue, text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 9, "Buy / Sell Qty", text_color = panelLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 9, quantityLabel, text_color = panelValue, text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 10, "Entry Offset", text_color = panelLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 10, str.tostring(bracketEntryOffsetTicks) + " ticks", text_color = bracketEntryOffsetTicks != 0 ? panelAccent : panelMuted, text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 11, "After SL", text_color = panelLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 11, rearmSameSideStopAfterSl ? "Rearm Same Side" : "No Re-entry", text_color = rearmSameSideStopAfterSl ? panelAccent : panelMuted, text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 12, "After TP", text_color = panelLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 12, afterTpLabel, text_color = rearmSameSideStopAfterTp or true ? panelAccent : panelMuted, text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 13, "BE Stop", text_color = panelLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 13, beStopLabel + (beStopOverridden ? " / P " + presetBeStopLabel : ""), text_color = beStopOverridden ? panelAccent : (useBeStop ? panelValue : panelMuted), text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 14, "BE Trigger", text_color = panelLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 14, beTriggerLabel + (beTriggerOverridden ? " / P " + str.tostring(presetBeTriggerTicks) + " ticks" : ""), text_color = beTriggerOverridden ? panelAccent : (useBeStop ? panelValue : panelMuted), text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 15, "BE Offset", text_color = panelLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 15, beOffsetLabel + (beOffsetOverridden ? " / P " + str.tostring(presetBeOffsetTicks) + " ticks" : ""), text_color = beOffsetOverridden ? panelAccent : (useBeStop ? panelValue : panelMuted), text_size = size.normal, text_halign = text.align_right)

// Dispatch any queued, de-duplicated alerts
if array.size(alertQueue) > 0
    for i = 0 to array.size(alertQueue) - 1
        alert(array.get(alertQueue, i), alert.freq_all)
array.clear(alertQueue)

if showPresetInfo and barstate.islast
    renderPresetInfoPanel()

