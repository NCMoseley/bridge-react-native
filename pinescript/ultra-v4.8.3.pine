bool fillSellRetestLimit = false

// Track active same-side trades for range outcome bookkeeping
var float activeBuyTp  = na  // TP price of active buy (na = no active buy)
var float activeSellTp = na  // TP price of active sell (na = no active sell)

// Track first signal outcome to color the range
var linefill rangeFill = na
var int rangeWins = 0            // count of TP hits this session
var int rangeLosses = 0          // count of SL hits this session
var float rangeR = 0.0           // net R earned this session
var bool recoveryMode = false  // After first SL hit, use 1:1 range TP/SL


// Cumulative R tracker across all signals on the chart
var float totalR = 0.0
var float totalTicks = 0.0
var int totalWins = 0
var int totalLosses = 0
var float peakTotalR = 0.0
var float maxDrawdownR = 0.0
var float maxStartToTroughDrawdownR = 0.0

// Track most recent signal for outcome detection
var float lastSignalEntry = na
var int   lastSignalSide  = 0    // 1 = buy, -1 = sell
var float lastSignalTpDist = na  // TP distance from entry
var float lastSignalSlDist = na  // SL distance from entry
