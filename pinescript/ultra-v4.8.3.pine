maxBracketEntriesOverride = input.int(-1, title = "Entries / Range", minval = -1, group = "Preset Overrides", tooltip = "Optional override for preset entries per range.\nSet to -1 to keep the preset value.")
tpStyleOverride = input.string("Preset", title = "TP Style", options = ["Preset", "Ticks", "½ range", "2/3 range", "1× range", "1.272 range", "1.414 range", "1.5× range", "2× range", "2.8× range", "3× range", "4× range", "5× range", "6× range", "7× range"], group = "Preset Overrides", tooltip = "Optional override for preset TP style.\nUse Preset to keep the preset value.")
