                array.set(tradeHalfTp2Hit, tradeIndex, halfTp2HitVal)
                array.set(tradeBeTriggered, tradeIndex, beTriggeredVal)
        else
            if not na(tradeTpDist) and tradeTpDist > 0 and favorableMove >= tradeTpDist
                if true and not bracketTpCancellationSignal and tradeBracketId == (tradeSide == 1 ? bracketLongArmId : bracketShortArmId)
                    if tradeSide == 1 and bracketShortPending
                        // bridge records entry_cancelled after successful cancel
                
                        bracketShortPending := false
                        bracketTpCancellationSignal := true
                    else if tradeSide == -1 and bracketLongPending
                        // bridge records entry_cancelled after successful cancel
                
                        bracketLongPending := false
                        bracketTpCancellationSignal := true
                    bracketOrdersActive := bracketLongPending or bracketShortPending

                float tradeR = tradeSlDist > 0 ? tradeTpDist / tradeSlDist : 1.0
                totalWins += 1
                totalR += tradeR
                totalTicks += tradeTpDist / syminfo.mintick
                int trackedRangeIdx = tradeIndex < array.size(tradeRangeResultIdxs) ? array.get(tradeRangeResultIdxs, tradeIndex) : na
                if trackedRangeIdx >= 0
                    float trackedRangeR = array.get(rangeResultValues, trackedRangeIdx) + tradeR
                    array.set(rangeResultValues, trackedRangeIdx, trackedRangeR)
                    trackedRangeLabel = array.get(rangeResultLabels, trackedRangeIdx)
                    if not na(trackedRangeLabel)
                        label.set_text(trackedRangeLabel, formatRangeR(trackedRangeR))
                        label.set_textcolor(trackedRangeLabel, rangeRColor(trackedRangeR))
                if tradeInCurrentRange
                    rangeWins += 1
                    rangeR += tradeR
                tradeResolved := true
                if tradingDayEntryAllowed and rearmSameSideStopAfterTp and bracketEntriesThisRange < maxBracketEntriesPerRange and tradeBracketId == (tradeSide == 1 ? bracketLongArmId : bracketShortArmId)
                    if tradeSide == 1
                        bracketLongRearmAwaitingReset := true
                        bracketLongRearmEligibleAfterBar := bar_index
                    else
                        bracketShortRearmAwaitingReset := true
                        bracketShortRearmEligibleAfterBar := bar_index
                float lifecycleTpPrice = tradeSide == 1 ? tradeEntry + tradeTpDist : tradeEntry - tradeTpDist
                if sendLifecycleAlerts and tradeQuantity > 0
                    fireAlert(lifecycleTradeClosedJson(tradeLifecycleId, tradeSide, 1, tradeQuantity, tradeEntry, lifecycleTpPrice, "take_profit"))
                if sigTog
                    signals.push(label.new(bar_index, lifecycleTpPrice, style = label.style_label_center, text = "◆", color = invis, textcolor = #089981, size = sigSize))
                if tradeResolved and tradeInCurrentRange and not na(rangeFill)
                    rangeFill.set_color(hideRangePaint ? color.new(orFillColor, 100) : rangeR > 0 ? rangeWinColor : rangeR < 0 ? rangeLossColor : orFillColor)
            bool beStopActive = beTriggeredVal
            float beStopPrice = tradeSide == 1 ? tradeEntry + tradeBeOffsetDist : tradeEntry - tradeBeOffsetDist
            bool beStopHit = beStopActive and (tradeSide == 1 ? low <= beStopPrice : high >= beStopPrice)
            float effectiveSlPrice = beStopActive ? beStopPrice : tradeSide == 1 ? tradeEntry - tradeSlDist : tradeEntry + tradeSlDist
            bool closeConfirmedSlHit = tradeSlNeedsCloseConfirm and barstate.isconfirmed and (tradeSide == 1 ? close < effectiveSlPrice : close > effectiveSlPrice)
            bool slHit = beStopActive ? beStopHit : tradeSlNeedsCloseConfirm ? closeConfirmedSlHit : adverseMove >= tradeSlDist
            if not tradeResolved and slHit
                if beStopHit
                    float beOffsetR = tradeSlDist > 0 ? tradeBeOffsetDist / tradeSlDist : 0.0
                    totalR += beOffsetR
                    totalTicks += tradeBeOffsetDist / syminfo.mintick
                    int trackedRangeIdx = tradeIndex < array.size(tradeRangeResultIdxs) ? array.get(tradeRangeResultIdxs, tradeIndex) : na
                    if trackedRangeIdx >= 0
                        float trackedRangeR = array.get(rangeResultValues, trackedRangeIdx) + beOffsetR
                        array.set(rangeResultValues, trackedRangeIdx, trackedRangeR)
                        trackedRangeLabel = array.get(rangeResultLabels, trackedRangeIdx)
                        if not na(trackedRangeLabel)
                            label.set_text(trackedRangeLabel, formatRangeR(trackedRangeR))
                            label.set_textcolor(trackedRangeLabel, rangeRColor(trackedRangeR))
                else
                    totalLosses += 1
                    totalR -= 1.0
                    totalTicks -= tradeSlDist / syminfo.mintick
                    int trackedRangeIdx = tradeIndex < array.size(tradeRangeResultIdxs) ? array.get(tradeRangeResultIdxs, tradeIndex) : na
                    if trackedRangeIdx >= 0
                        float trackedRangeR = array.get(rangeResultValues, trackedRangeIdx) - 1.0
                        array.set(rangeResultValues, trackedRangeIdx, trackedRangeR)
                        trackedRangeLabel = array.get(rangeResultLabels, trackedRangeIdx)
                        if not na(trackedRangeLabel)
                            label.set_text(trackedRangeLabel, formatRangeR(trackedRangeR))
                            label.set_textcolor(trackedRangeLabel, rangeRColor(trackedRangeR))
                if tradeInCurrentRange
                    if beStopHit
                        float beOffsetR = tradeSlDist > 0 ? tradeBeOffsetDist / tradeSlDist : 0.0
                        rangeR += beOffsetR
                    else
                        rangeLosses += 1
                        rangeR -= 1.0
                        recoveryMode := true
                    if tradeSide == 1
                        up_check := true
                        if not beStopHit
                            upCooldownUntilBar := bar_index + 1
                    else
                        down_check := true
                        if not beStopHit
                            downCooldownUntilBar := bar_index + 1
                string lifecycleStopExitReason = beStopHit ? "protected_stop" : "stop_loss"
                if sendLifecycleAlerts and tradeQuantity > 0
                    fireAlert(lifecycleTradeClosedJson(tradeLifecycleId, tradeSide, 1, tradeQuantity, tradeEntry, effectiveSlPrice, lifecycleStopExitReason))
                tradeResolved := true
                if tradingDayEntryAllowed and rearmSameSideStopAfterSl and bracketEntriesThisRange < maxBracketEntriesPerRange and not beStopHit and tradeBracketId == (tradeSide == 1 ? bracketLongArmId : bracketShortArmId)
                    if tradeSide == 1 and (na(rearmLongAlertBar) or rearmLongAlertBar != bar_index)
                        bracketLongPending := true
                        bracketLongLifecycleArmIndex += 1
                        bracketLongArmId := bracketId + "-arm-" + str.tostring(bracketLongLifecycleArmIndex)
                        bracketLongLifecycleTradeId := lifecycleBracketTradeId(bracketLongArmId, 1, 0)
                        bracketLongIsStop := bracketLongEntryPrice > close
                        bracketOrdersActive := true
                        bracketPlacedBar := bar_index
                        rearmLongAlertBar := bar_index
                        rearmLongBracketOrder := true
                    else if tradeSide == -1 and (na(rearmShortAlertBar) or rearmShortAlertBar != bar_index)
                        bracketShortPending := true
                        bracketShortLifecycleArmIndex += 1
                        bracketShortArmId := bracketId + "-arm-" + str.tostring(bracketShortLifecycleArmIndex)
                        bracketShortLifecycleTradeId := lifecycleBracketTradeId(bracketShortArmId, -1, 0)
                        bracketShortIsStop := bracketShortEntryPrice < close
                        bracketOrdersActive := true
                        bracketPlacedBar := bar_index
                        rearmShortAlertBar := bar_index
                        rearmShortBracketOrder := true
                if tradeSlNeedsCloseConfirm and not beStopHit
                    sl_exit_signal := true
                if beStopHit and sendBeStopExitAlerts
                    be_exit_signal := true
                if sigTog
                    float slPrice = effectiveSlPrice
                    signals.push(label.new(bar_index, slPrice, style = label.style_label_center, text = "✕", color = invis, textcolor = beStopHit ? color.black : #f23645, size = sigSize))
                if tradeInCurrentRange and not na(rangeFill)
                    rangeFill.set_color(hideRangePaint ? color.new(orFillColor, 100) : rangeR > 0 ? rangeWinColor : rangeR < 0 ? rangeLossColor : orFillColor)

            if tradeResolved
                lastResolvedEntrySideCount := tradeSide == lastResolvedEntrySide ? lastResolvedEntrySideCount + 1 : 1
                lastResolvedEntrySide := tradeSide
                array.remove(tradeEntries, tradeIndex)
                array.remove(tradeRangeResultIdxs, tradeIndex)
                array.remove(tradeEntryBars, tradeIndex)
                array.remove(tradeSides, tradeIndex)
                array.remove(tradeTpDists, tradeIndex)
                array.remove(tradeSlDists, tradeIndex)
                array.remove(tradeSlRequireCloseConfirm, tradeIndex)
                array.remove(tradeBeTriggerDists, tradeIndex)
                array.remove(tradeBeOffsetDists, tradeIndex)
                array.remove(tradeBeRequireCloseConfirm, tradeIndex)
                array.remove(tradeUsesMarketBe, tradeIndex)
                array.remove(tradeRangeIds, tradeIndex)
                array.remove(tradeBracketIds, tradeIndex)
                array.remove(tradeLifecycleIds, tradeIndex)
                array.remove(tradeQuantities, tradeIndex)
                array.remove(tradeIsSplit, tradeIndex)
                array.remove(tradeIsHalfOut, tradeIndex)
                array.remove(tradeSplitTp1Dist, tradeIndex)
                array.remove(tradeSplitTp2Dist, tradeIndex)
                array.remove(tradeSplitTp3Dist, tradeIndex)
                array.remove(tradeSplitTp4Dist, tradeIndex)
                array.remove(tradeSplitTp1Hit, tradeIndex)
                array.remove(tradeSplitTp2Hit, tradeIndex)
                array.remove(tradeSplitTp3Hit, tradeIndex)
                array.remove(tradeSplitTp4Hit, tradeIndex)
                array.remove(tradeSplitNewSlDist, tradeIndex)
                array.remove(tradeHalfTp1Dist, tradeIndex)
                array.remove(tradeHalfTp2Dist, tradeIndex)
                array.remove(tradeHalfTp1Hit, tradeIndex)
                array.remove(tradeHalfTp2Hit, tradeIndex)
                array.remove(tradeHalfNewSlDist, tradeIndex)
                array.remove(tradeBeTriggered, tradeIndex)
            else
                array.set(tradeBeTriggered, tradeIndex, beTriggeredVal)

        tradeIndex -= 1

if eodFlattenActiveBar
    if array.size(tradeEntries) > 0
        int eodTradeIndex = 0
        while eodTradeIndex < array.size(tradeEntries)
            float eodEntry = array.get(tradeEntries, eodTradeIndex)
            int eodSide = array.get(tradeSides, eodTradeIndex)
            float eodSlDist = array.get(tradeSlDists, eodTradeIndex)
            int eodRangeId = array.get(tradeRangeIds, eodTradeIndex)
            string eodLifecycleTradeId = array.get(tradeLifecycleIds, eodTradeIndex)
            float eodTradeQuantity = array.get(tradeQuantities, eodTradeIndex)
            bool eodIsSplit = array.get(tradeIsSplit, eodTradeIndex)
            bool eodIsHalfOut = array.get(tradeIsHalfOut, eodTradeIndex)
            float eodRemainingFraction = 1.0
            if eodIsSplit
                eodRemainingFraction := 0.0
                if not array.get(tradeSplitTp1Hit, eodTradeIndex)
                    eodRemainingFraction += 0.25
                if not array.get(tradeSplitTp2Hit, eodTradeIndex)
                    eodRemainingFraction += 0.25
                if not array.get(tradeSplitTp3Hit, eodTradeIndex)
                    eodRemainingFraction += 0.25
                if not array.get(tradeSplitTp4Hit, eodTradeIndex)
                    eodRemainingFraction += 0.25
            else if eodIsHalfOut and array.get(tradeHalfTp1Hit, eodTradeIndex)
                eodRemainingFraction := 0.5
            if sendLifecycleAlerts
                if eodIsSplit
                    if not array.get(tradeSplitTp1Hit, eodTradeIndex)
                        float eodTp1Quantity = lifecycleLegQuantity(eodTradeQuantity, 4, 0)
                        if eodTp1Quantity > 0
                            fireAlert(lifecycleTradeClosedJson(eodLifecycleTradeId, eodSide, 1, eodTp1Quantity, eodEntry, close, "eod_flatten"))
                    if not array.get(tradeSplitTp2Hit, eodTradeIndex)
                        float eodTp2Quantity = lifecycleLegQuantity(eodTradeQuantity, 4, 1)
                        if eodTp2Quantity > 0
                            fireAlert(lifecycleTradeClosedJson(eodLifecycleTradeId, eodSide, 2, eodTp2Quantity, eodEntry, close, "eod_flatten"))
                    if not array.get(tradeSplitTp3Hit, eodTradeIndex)
                        float eodTp3Quantity = lifecycleLegQuantity(eodTradeQuantity, 4, 2)
                        if eodTp3Quantity > 0
                            fireAlert(lifecycleTradeClosedJson(eodLifecycleTradeId, eodSide, 3, eodTp3Quantity, eodEntry, close, "eod_flatten"))
                    if not array.get(tradeSplitTp4Hit, eodTradeIndex)
                        float eodTp4Quantity = lifecycleLegQuantity(eodTradeQuantity, 4, 3)
                        if eodTp4Quantity > 0
                            fireAlert(lifecycleTradeClosedJson(eodLifecycleTradeId, eodSide, 4, eodTp4Quantity, eodEntry, close, "eod_flatten"))
                else if eodIsHalfOut
                    if not array.get(tradeHalfTp1Hit, eodTradeIndex)
                        float eodTp1Quantity = lifecycleLegQuantity(eodTradeQuantity, 2, 0)
                        if eodTp1Quantity > 0
                            fireAlert(lifecycleTradeClosedJson(eodLifecycleTradeId, eodSide, 1, eodTp1Quantity, eodEntry, close, "eod_flatten"))
                    if not array.get(tradeHalfTp2Hit, eodTradeIndex)
                        float eodTp2Quantity = lifecycleLegQuantity(eodTradeQuantity, 2, 1)
                        if eodTp2Quantity > 0
                            fireAlert(lifecycleTradeClosedJson(eodLifecycleTradeId, eodSide, 2, eodTp2Quantity, eodEntry, close, "eod_flatten"))
                else if eodTradeQuantity > 0
                    fireAlert(lifecycleTradeClosedJson(eodLifecycleTradeId, eodSide, 1, eodTradeQuantity, eodEntry, close, "eod_flatten"))
            float eodMove = eodSide == 1 ? close - eodEntry : eodEntry - close
            float eodR = eodSlDist > 0 ? eodRemainingFraction * eodMove / eodSlDist : 0.0
            float eodTicks = eodRemainingFraction * eodMove / syminfo.mintick
            totalR += eodR
            totalTicks += eodTicks
            if eodR > 0
                totalWins += 1
            else if eodR < 0
                totalLosses += 1
            int eodRangeIdx = eodTradeIndex < array.size(tradeRangeResultIdxs) ? array.get(tradeRangeResultIdxs, eodTradeIndex) : na
            if eodRangeIdx >= 0
                float eodTrackedRangeR = array.get(rangeResultValues, eodRangeIdx) + eodR
                array.set(rangeResultValues, eodRangeIdx, eodTrackedRangeR)
                eodTrackedRangeLabel = array.get(rangeResultLabels, eodRangeIdx)
                if not na(eodTrackedRangeLabel)
                    label.set_text(eodTrackedRangeLabel, formatRangeR(eodTrackedRangeR))
                    label.set_textcolor(eodTrackedRangeLabel, rangeRColor(eodTrackedRangeR))
            if eodRangeId == currentRangeId
                rangeR += eodR
                if eodR > 0
                    rangeWins += 1
                else if eodR < 0
                    rangeLosses += 1
            eodTradeIndex += 1
    if bracketLongPending
        cancelLongBracketOrder := true
        cancelLongBracketIsStop := bracketLongIsStop
        cancelLongBracketId := bracketLongArmId
        cancelLongLifecycleTradeId := bracketLongLifecycleTradeId
    if bracketShortPending
        cancelShortBracketOrder := true
        cancelShortBracketIsStop := bracketShortIsStop
        cancelShortBracketId := bracketShortArmId
        cancelShortLifecycleTradeId := bracketShortLifecycleTradeId
    bracketOrdersActive := false
    bracketLongPending := false
    bracketShortPending := false
    bracketPlacedBar := na
    bracketId := ""
    bracketLongFillPendingConfirmation := false
    bracketShortFillPendingConfirmation := false
    bracketLongRearmAwaitingReset := false
    bracketShortRearmAwaitingReset := false
    bracketLongRearmEligibleAfterBar := na
    bracketShortRearmEligibleAfterBar := na
    bracketLongTpDistance := na
    bracketShortTpDistance := na
    bracketLongSlDistance := na
    bracketShortSlDistance := na
    bracketLongRunner1Distance := na
    bracketShortRunner1Distance := na
    bracketLongRunner2Distance := na
    bracketShortRunner2Distance := na
    bracketLongRunner3Distance := na
    bracketShortRunner3Distance := na
    pendingRetestActive := false
    array.clear(tradeEntries)
    array.clear(tradeEntryBars)
    array.clear(tradeSides)
    array.clear(tradeTpDists)
    array.clear(tradeSlDists)
    array.clear(tradeSlRequireCloseConfirm)
    array.clear(tradeBeTriggerDists)
    array.clear(tradeBeOffsetDists)
    array.clear(tradeBeRequireCloseConfirm)
    array.clear(tradeUsesMarketBe)
    array.clear(tradeRangeIds)
    array.clear(tradeRangeResultIdxs)
    array.clear(tradeBracketIds)
    array.clear(tradeLifecycleIds)
    array.clear(tradeQuantities)
    array.clear(tradeIsSplit)
    array.clear(tradeIsHalfOut)
    array.clear(tradeSplitTp1Dist)
    array.clear(tradeSplitTp2Dist)
    array.clear(tradeSplitTp3Dist)
    array.clear(tradeSplitTp4Dist)
    array.clear(tradeSplitTp1Hit)
    array.clear(tradeSplitTp2Hit)
    array.clear(tradeSplitTp3Hit)
    array.clear(tradeSplitTp4Hit)
    array.clear(tradeSplitNewSlDist)
    array.clear(tradeHalfTp1Dist)
    array.clear(tradeHalfTp2Dist)
    array.clear(tradeHalfTp1Hit)
    array.clear(tradeHalfTp2Hit)
    array.clear(tradeHalfNewSlDist)
    array.clear(tradeBeTriggered)

activeBuyTp := na
activeSellTp := na
if array.size(tradeSides) > 0
    int gateIndex = 0
    while gateIndex < array.size(tradeSides)
        int openSide = array.get(tradeSides, gateIndex)
        if openSide == 1
            activeBuyTp := 0.0
        if openSide == -1
            activeSellTp := 0.0
        gateIndex += 1

cancelLongBracketJson := '{"ticker":"' + syminfo.ticker + '","action":"cancel","cancelOrderType":"' + (cancelLongBracketIsStop ? "stop" : "limit") + '","bracketId":"' + cancelLongBracketId + '","bracketSide":"long","time":"' + str.tostring(alertTimeMs()) + '","interval":"' + timeframe.period + '","extras":{"reason":"bracket_cancel_pending_order","source":"ultra-v4.8","rangeName":"' + lifecycleEscape(activeRangeName) + '"}}'
cancelShortBracketJson := '{"ticker":"' + syminfo.ticker + '","action":"cancel","cancelOrderType":"' + (cancelShortBracketIsStop ? "stop" : "limit") + '","bracketId":"' + cancelShortBracketId + '","bracketSide":"short","time":"' + str.tostring(alertTimeMs()) + '","interval":"' + timeframe.period + '","extras":{"reason":"bracket_cancel_pending_order","source":"ultra-v4.8","rangeName":"' + lifecycleEscape(activeRangeName) + '"}}'

bool cancelLongFired = dispatchCancelAlert(cancelLongBracketOrder and not eodFlattenActiveBar, sendLifecycleAlerts, cancelLongBracketJson, cancelLongLifecycleTradeId, cancelLongBracketId, 1, bracketLongQuantity, bracketLongEntryPrice)
if cancelLongFired
    cancelLongAlertFired := true
    lastCancelLongAlertBar := bar_index
bool cancelShortFired = dispatchCancelAlert(cancelShortBracketOrder and not eodFlattenActiveBar, sendLifecycleAlerts, cancelShortBracketJson, cancelShortLifecycleTradeId, cancelShortBracketId, -1, bracketShortQuantity, bracketShortEntryPrice)
if cancelShortFired
    cancelShortAlertFired := true
    lastCancelShortAlertBar := bar_index

bool dispatchBracketBuy = not eodFlattenActiveBar and (bracketPlacementSignal or rearmLongBracketOrder)
bool dispatchBracketSell = not eodFlattenActiveBar and (bracketPlacementSignal or rearmShortBracketOrder)
dispatchBracketBuyAlerts(dispatchBracketBuy, effectiveSplit, effectiveHalfOut, bracketBuySplitTp1Quantity, bracketBuySplitTp2Quantity, bracketBuySplitTp3Quantity, bracketBuySplitTp4Quantity, bracketBuyHalfTp1Quantity, bracketBuyHalfRunnerQuantity, bracketLongQuantity, bracketBuySplitTp1Json, bracketBuySplitTp2Json, bracketBuySplitTp3Json, bracketBuySplitTp4Json, bracketBuyHalfTp1Json, bracketBuyHalfRunnerJson, bracketBuyJson, sendLifecycleAlerts, bracketLongLifecycleTradeId, bracketLongEntryPrice)
if dispatchBracketBuy
    rearmLongBracketOrder := false
dispatchBracketSellAlerts(dispatchBracketSell, effectiveSplit, effectiveHalfOut, bracketSellSplitTp1Quantity, bracketSellSplitTp2Quantity, bracketSellSplitTp3Quantity, bracketSellSplitTp4Quantity, bracketSellHalfTp1Quantity, bracketSellHalfRunnerQuantity, bracketShortQuantity, bracketSellSplitTp1Json, bracketSellSplitTp2Json, bracketSellSplitTp3Json, bracketSellSplitTp4Json, bracketSellHalfTp1Json, bracketSellHalfRunnerJson, bracketSellJson, sendLifecycleAlerts, bracketShortLifecycleTradeId, bracketShortEntryPrice)
if dispatchBracketSell
    rearmShortBracketOrder := false
int exitFiredMask = dispatchExitAlerts(eodFlattenNow, eodCancelLongJson, eodCancelShortJson, eodFlattenExitJson, sl_exit_signal, be_exit_signal, eodFlattenActiveBar, useCloseConfirmedSl, sendBeStopExitAlerts, exit_json, be_exit_json)
if exitFiredMask == 1 or exitFiredMask == 3 or exitFiredMask == 5 or exitFiredMask == 7
    eodExitAlertFired := true
    lastEodExitAlertBar := bar_index
if exitFiredMask == 2 or exitFiredMask == 3 or exitFiredMask == 6 or exitFiredMask == 7
    slExitAlertFired := true
    lastSlExitAlertBar := bar_index
if exitFiredMask == 4 or exitFiredMask == 5 or exitFiredMask == 6 or exitFiredMask == 7
    beExitAlertFired := true
    lastBeExitAlertBar := bar_index
bool buySignalAlertFiredThisBar = dispatchBuySignalAlerts(not bracketOrdersForcedOn and placeBuyRetestLimit, not bracketOrdersForcedOn and up_signal, eodFlattenActiveBar, "Wick", fillBuyRetestLimit, buy_json)
if buySignalAlertFiredThisBar
    upAlertFireCount := upAlertFireCount + 1
    lastUpAlertBar := bar_index
bool sellSignalAlertFiredThisBar = dispatchSellSignalAlerts(not bracketOrdersForcedOn and placeSellRetestLimit, not bracketOrdersForcedOn and down_signal, eodFlattenActiveBar, "Wick", fillSellRetestLimit, sell_json)
if sellSignalAlertFiredThisBar
    downAlertFireCount := downAlertFireCount + 1
    lastDownAlertBar := bar_index

for guide in be_guides
    guide.ln.delete()
    guide.lab.delete()
be_guides.clear()

for guide in trade_guides
    guide.ln.delete()
    guide.lab.delete()
trade_guides.clear()

if showTradeLevels and array.size(tradeEntries) > 0
    int tradeGuideCount = array.size(tradeEntries)
    for tradeGuideIndex = 0 to tradeGuideCount - 1
        float guideEntry = array.get(tradeEntries, tradeGuideIndex)
        int guideEntryBar = array.get(tradeEntryBars, tradeGuideIndex)
        int guideSide = array.get(tradeSides, tradeGuideIndex)
        float guideTpDist = array.get(tradeTpDists, tradeGuideIndex)
        float guideSlDist = array.get(tradeSlDists, tradeGuideIndex)
        float guideBeOffsetDist = array.get(tradeBeOffsetDists, tradeGuideIndex)
        bool guideBeTriggered = array.get(tradeBeTriggered, tradeGuideIndex)
        bool guideIsSplit = array.get(tradeIsSplit, tradeGuideIndex)
        bool guideIsHalfOut = array.get(tradeIsHalfOut, tradeGuideIndex)
        bool guideTp1MovedToBe = (guideIsSplit and array.get(tradeSplitTp1Hit, tradeGuideIndex)) or (guideIsHalfOut and array.get(tradeHalfTp1Hit, tradeGuideIndex))
        float guideSlPrice = guideTp1MovedToBe ? guideEntry : guideBeTriggered ? (guideSide == 1 ? guideEntry + guideBeOffsetDist : guideEntry - guideBeOffsetDist) : guideSide == 1 ? guideEntry - guideSlDist : guideEntry + guideSlDist
        string guideSlText = guideTp1MovedToBe or guideBeTriggered ? formatGuideLabel("BE", guideSlPrice) : formatGuideLabel("SL", guideSlPrice)
        pushPriceGuide(trade_guides, guideEntryBar, guideSlPrice, color.new(#f23645, 0), guideSlText)

        if guideIsSplit
            float guideTp1Price = guideSide == 1 ? guideEntry + array.get(tradeSplitTp1Dist, tradeGuideIndex) : guideEntry - array.get(tradeSplitTp1Dist, tradeGuideIndex)
            float guideTp2Price = guideSide == 1 ? guideEntry + array.get(tradeSplitTp2Dist, tradeGuideIndex) : guideEntry - array.get(tradeSplitTp2Dist, tradeGuideIndex)
            float guideTp3Price = guideSide == 1 ? guideEntry + array.get(tradeSplitTp3Dist, tradeGuideIndex) : guideEntry - array.get(tradeSplitTp3Dist, tradeGuideIndex)
            float guideTp4Price = guideSide == 1 ? guideEntry + array.get(tradeSplitTp4Dist, tradeGuideIndex) : guideEntry - array.get(tradeSplitTp4Dist, tradeGuideIndex)
            pushPriceGuide(trade_guides, guideEntryBar, guideTp1Price, color.new(#089981, 0), formatGuideLabel("TP1", guideTp1Price))
            pushPriceGuide(trade_guides, guideEntryBar, guideTp2Price, color.new(#089981, 0), formatGuideLabel("TP2", guideTp2Price))
            pushPriceGuide(trade_guides, guideEntryBar, guideTp3Price, color.new(#089981, 0), formatGuideLabel("TP3", guideTp3Price))
            pushPriceGuide(trade_guides, guideEntryBar, guideTp4Price, color.new(#089981, 0), formatGuideLabel("TP4", guideTp4Price))
        else if guideIsHalfOut
            float guideTp1Price = guideSide == 1 ? guideEntry + array.get(tradeHalfTp1Dist, tradeGuideIndex) : guideEntry - array.get(tradeHalfTp1Dist, tradeGuideIndex)
            float guideTp2Price = guideSide == 1 ? guideEntry + array.get(tradeHalfTp2Dist, tradeGuideIndex) : guideEntry - array.get(tradeHalfTp2Dist, tradeGuideIndex)
            pushPriceGuide(trade_guides, guideEntryBar, guideTp1Price, color.new(#089981, 0), formatGuideLabel("TP1", guideTp1Price))
            pushPriceGuide(trade_guides, guideEntryBar, guideTp2Price, color.new(#089981, 0), formatGuideLabel("TP2", guideTp2Price))
        else
            float guideTpPrice = guideSide == 1 ? guideEntry + guideTpDist : guideEntry - guideTpDist
            pushPriceGuide(trade_guides, guideEntryBar, guideTpPrice, color.new(#089981, 0), formatGuideLabel("TP", guideTpPrice))

bool showActiveBeGuides = false
if showActiveBeGuides and array.size(tradeEntries) > 0
    int guideCount = array.size(tradeEntries)
    for guideIndex = 0 to guideCount - 1
        if array.get(tradeUsesMarketBe, guideIndex)
            float guideEntry = array.get(tradeEntries, guideIndex)
            int guideEntryBar = array.get(tradeEntryBars, guideIndex)
            int guideSide = array.get(tradeSides, guideIndex)
            float guideBeOffsetDist = array.get(tradeBeOffsetDists, guideIndex)
            bool guideBeTriggered = array.get(tradeBeTriggered, guideIndex)
            bool guideIsSplit = array.get(tradeIsSplit, guideIndex)
            bool guideIsHalfOut = array.get(tradeIsHalfOut, guideIndex)
            bool guideTp1MovedToBe = (guideIsSplit and array.get(tradeSplitTp1Hit, guideIndex)) or (guideIsHalfOut and array.get(tradeHalfTp1Hit, guideIndex))
            float guidePrice = guideTp1MovedToBe ? guideEntry : guideSide == 1 ? guideEntry + guideBeOffsetDist : guideEntry - guideBeOffsetDist
            color guideColor = guideBeTriggered or guideTp1MovedToBe ? color.aqua : color.new(color.aqua, 35)
            string guideText = guideTp1MovedToBe ? "Protected (TP1)" : guideBeTriggered ? "Protected Active" : "Protected Target"
            be_guides.push(target.new(
              line.new(guideEntryBar, guidePrice, bar_index + guideLabelOffsetBars, guidePrice, color = guideColor, style = line.style_dashed),
              label.new(bar_index + guideLabelOffsetBars, guidePrice, text = guideText, tooltip = str.tostring(guidePrice, format.mintick), style = label.style_label_left, color = invis, textcolor = guideColor, size = txtSize)
              ))

// Exit alertconditions remain available for placeholder-based TradingView alerts.
alertcondition(sl_exit_signal, title = "Ultra Exit", message = '{\n    "ticker": "{{ticker}}",\n    "action": "exit",\n    "orderType": "market",\n    "price": "{{close}}",\n    "time": "{{timenow}}",\n    "interval": "{{interval}}"\n}')
alertcondition(be_exit_signal and sendBeStopExitAlerts, title = "Ultra Protected Exit", message = '{\n    "ticker": "{{ticker}}",\n    "action": "exit",\n    "orderType": "market",\n    "price": "{{close}}",\n    "time": "{{timenow}}",\n    "interval": "{{interval}}"\n}')

plot(sl_exit_signal ? 1 : 0, "SlExitSignal", display = display.none)
plot(or_token ? orh : na, "ORH", display = display.none)
plot(or_token ? orl : na, "ORL", display = display.none)
plot(be_exit_signal and sendBeStopExitAlerts ? 1 : 0, "ProtectedExitSignal", display = display.none)

//---------------------------------------------------------------------------------------------------------------------}
// Performance Summary
//---------------------------------------------------------------------------------------------------------------------{

if totalR > peakTotalR
    peakTotalR := totalR
float currentDrawdownR = math.max(0.0, peakTotalR - totalR)
if currentDrawdownR > maxDrawdownR
    maxDrawdownR := currentDrawdownR
float currentStartToTroughDrawdownR = math.max(0.0, -totalR)
if currentStartToTroughDrawdownR > maxStartToTroughDrawdownR
    maxStartToTroughDrawdownR := currentStartToTroughDrawdownR

if showPerformanceSummary and barstate.islast
    color performanceBg = useLightTableTheme ? #f1f5f9 : #111827
    color performanceBorder = useLightTableTheme ? #94a3b8 : #334155
    color performanceHeader = useLightTableTheme ? #2563eb : #1d4ed8
    color performanceLabel = useLightTableTheme ? #475569 : #94a3b8
    color performanceValue = useLightTableTheme ? #0f172a : #e2e8f0
    color performanceMuted = useLightTableTheme ? #64748b : #64748b
    color performancePositive = useLightTableTheme ? #047857 : #34d399
    color performanceNegative = useLightTableTheme ? #b91c1c : #fb7185
    color headerBg = useLightTableTheme ?  #111827 : #f1f5f9
    float totalDollars = totalR * riskAmountUsd
    float currentDrawdownDollars = currentDrawdownR * riskAmountUsd
    float maxDrawdownDollars = maxDrawdownR * riskAmountUsd
    float maxStartToTroughDrawdownDollars = maxStartToTroughDrawdownR * riskAmountUsd
    float bracketRiskUsed = not na(bracketBuyQuantity) and not na(bracketBuyRiskPerUnit) ? bracketBuyQuantity * bracketBuyRiskPerUnit : na
    string performanceContractsLabel = not na(bracketBuyQuantity) ? str.tostring(bracketBuyQuantity, "#.##") : "--"
    string performanceRiskUsedLabel = not na(bracketRiskUsed) ? "$" + str.tostring(bracketRiskUsed, "#.##") : "--"
    color totalRColor = totalR > 0 ? performancePositive : totalR < 0 ? performanceNegative : performanceValue
    color totalTicksColor = totalTicks > 0 ? performancePositive : totalTicks < 0 ? performanceNegative : performanceValue
    var table performance = table.new(position.top_left, 2, 16, bgcolor = performanceBg, border_width = 1, border_color = performanceBorder)
    table.cell(performance, 0, 1, "", text_color = color.white, bgcolor = performanceValue)
    table.cell(performance, 1, 1, "", text_color = color.white, bgcolor = performanceValue)
    table.cell(performance, 0, 2, "", text_color = color.white, bgcolor = performanceValue)
    table.cell(performance, 1, 2, "", text_color = color.white, bgcolor = performanceValue)
    table.cell(performance, 0, 3, "4.8.3", text_color = color.white, bgcolor = performanceHeader, text_size = size.normal, text_halign = text.align_left)
    table.cell(performance, 1, 3, "PERFORMANCE", text_color = #dbeafe, bgcolor = performanceHeader, text_size = size.normal, text_halign = text.align_right)
    table.cell(performance, 0, 4, "Range", text_color = performanceLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(performance, 1, 4, activeRangeName + " " + crSesh, text_color = activeRangeEnabled ? performanceValue : performanceMuted, text_size = size.normal, text_halign = text.align_right)
    table.cell(performance, 0, 5, "Symbol", text_color = performanceLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(performance, 1, 5, syminfo.ticker, text_color = performanceMuted, text_size = size.normal, text_halign = text.align_right)
    table.cell(performance, 0, 6, "Risk / Trade", text_color = performanceLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(performance, 1, 6, "$" + str.tostring(riskAmountUsd, "#.##"), text_color = performanceValue, text_size = size.normal, text_halign = text.align_right)
    table.cell(performance, 0, 7, "Contracts", text_color = performanceLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(performance, 1, 7, performanceContractsLabel, text_color = performanceValue, text_size = size.normal, text_halign = text.align_right)
    table.cell(performance, 0, 8, "Risk Used", text_color = performanceLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(performance, 1, 8, performanceRiskUsedLabel, text_color = performanceValue, text_size = size.normal, text_halign = text.align_right)
    table.cell(performance, 0, 9, "R Earned", text_color = performanceLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(performance, 1, 9, (totalR >= 0 ? "+" : "") + str.tostring(totalR, "#.##") + "R", text_color = totalRColor, text_size = size.normal, text_halign = text.align_right)
    table.cell(performance, 0, 10, "Ticks Earned", text_color = performanceLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(performance, 1, 10, (totalTicks >= 0 ? "+" : "") + str.tostring(totalTicks, "#.##"), text_color = totalTicksColor, text_size = size.normal, text_halign = text.align_right)
    table.cell(performance, 0, 11, "Dollars Earned", text_color = performanceLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(performance, 1, 11, (totalDollars >= 0 ? "+" : "-") + "$" + str.tostring(math.abs(totalDollars), "#.##"), text_color = totalRColor, text_size = size.normal, text_halign = text.align_right)
    table.cell(performance, 0, 12, "Current Drawdown", text_color = performanceLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(performance, 1, 12, "-$" + str.tostring(currentDrawdownDollars, "#.##") + " / -" + str.tostring(currentDrawdownR, "#.##") + "R", text_color = currentDrawdownR > 0 ? performanceNegative : performanceMuted, text_size = size.normal, text_halign = text.align_right)
    table.cell(performance, 0, 13, "Peak-to-Trough DD", text_color = performanceLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(performance, 1, 13, "-$" + str.tostring(maxDrawdownDollars, "#.##") + " / -" + str.tostring(maxDrawdownR, "#.##") + "R", text_color = maxDrawdownR > 0 ? performanceNegative : performanceMuted, text_size = size.normal, text_halign = text.align_right)
    table.cell(performance, 0, 14, "Start-to-Trough DD", text_color = performanceLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(performance, 1, 14, "-$" + str.tostring(maxStartToTroughDrawdownDollars, "#.##") + " / -" + str.tostring(maxStartToTroughDrawdownR, "#.##") + "R", text_color = maxStartToTroughDrawdownR > 0 ? performanceNegative : performanceMuted, text_size = size.normal, text_halign = text.align_right)
    table.cell(performance, 0, 15, "Win / Loss", text_color = performanceLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(performance, 1, 15, str.tostring(totalWins) + "W / " + str.tostring(totalLosses) + "L", text_color = performanceValue, text_size = size.normal, text_halign = text.align_right)

//---------------------------------------------------------------------------------------------------------------------}
//Settings Info Panel
//---------------------------------------------------------------------------------------------------------------------{

renderPresetInfoPanel() =>
    color panelBg = useLightTableTheme ? #f1f5f9 : #111827
    color panelBorder = useLightTableTheme ? #94a3b8 : #334155
    color panelHeader = useLightTableTheme ? #2563eb : #1d4ed8
    color panelLabel = useLightTableTheme ? #475569 : #94a3b8
    color panelValue = useLightTableTheme ? #0f172a : #e2e8f0
    color panelMuted = useLightTableTheme ? #64748b : #64748b
    color panelAccent = useLightTableTheme ? #0f5cc0 : #38bdf8
    color panelWarning = useLightTableTheme ? #b45309 : #fbbf24
    string presetTradingSessionLabel = str.length(presetTradingSession) > 0 ? presetTradingSession : "None"
    string tradingSessionLabel = str.length(tradingSession) > 0 ? tradingSession : "None"
    bool rangeSessionOverridden = crSesh != activeRangeSession
    bool tradingSessionOverridden = tradingSession != presetTradingSession
    bool riskOverridden = riskAmountUsd != presetRiskAmountUsd
    bool entriesOverridden = maxBracketEntriesPerRange != presetEntriesPerRange
    bool eodOverridden = eodFlattenTime != presetEodFlattenTime
    bool tpStyleOverridden = tpStyle != presetTpStyle
    bool tpTicksOverridden = tpTicksOverride != presetTpTicksOverride
    bool slStyleOverridden = slStyle != presetSlStyle
    bool slTicksOverridden = slTicksOverride != presetSlTicksOverride
    string presetTpLabel = presetTpStyle == "Ticks" ? str.tostring(presetTpTicksOverride) + " ticks" : presetTpStyle
    string tpLabel = tpIsTicks ? str.tostring(tpTicksOverride) + " ticks" : effectiveTpStyle
    string presetSlLabel = presetSlStyle == "Ticks" ? str.tostring(presetSlTicksOverride) + " ticks" : presetSlStyle
    string slLabel = slStyle == "Ticks" ? str.tostring(slTicksOverride) + " ticks" : slStyle
    string riskLabel = "$" + str.tostring(riskAmountUsd, "#.##") + (riskOverridden ? " / P $" + str.tostring(presetRiskAmountUsd, "#.##") : "")
    string entriesLabel = str.tostring(maxBracketEntriesPerRange) + (entriesOverridden ? " / P " + str.tostring(presetEntriesPerRange) : "")
    string quantityLabel = str.tostring(bracketBuyQuantity, "#.##") + " / " + str.tostring(bracketSellQuantity, "#.##")
    string presetStatusLabel = activeRangeEnabled ? "Active" : "Inactive: no range"
    color presetStatusColor = activeRangeEnabled ? panelAccent : panelWarning
    string afterTpLabel = rearmSameSideStopAfterTp ? "Rearm Same / Cancel" : "Cancel Opposite"
    string staleBracketLabel = bracketOrdersActive and bracketId != nextBracketId ? "Retained (safe)" : bracketOrdersActive ? "New Bracket" : "No Bracket"
    var table info = table.new(position.bottom_right, 2, 18, bgcolor = panelBg, border_width = 1, border_color = panelBorder)
    table.cell(info, 0, 0, "ULTRA", text_color = color.white, bgcolor = panelHeader, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 0, "4.8.3", text_color = #dbeafe, bgcolor = panelHeader, text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 1, "Range", text_color = panelLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 1, activeRangeName, text_color = panelValue, text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 2, "Preset Status", text_color = panelLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 2, presetStatusLabel, text_color = presetStatusColor, text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 3, "Chart / Preset", text_color = panelLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 3, syminfo.ticker + " / " + presetInstrument, text_color = panelValue, text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 4, "Range Session", text_color = panelLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 4, crSesh + (rangeSessionOverridden ? " / P " + activeRangeSession : ""), text_color = rangeSessionOverridden ? panelAccent : activeRangeEnabled ? panelValue : panelMuted, text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 5, "Trading Session", text_color = panelLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 5, tradingSessionLabel + (tradingSessionOverridden ? " / P " + presetTradingSessionLabel : ""), text_color = tradingSessionOverridden ? panelAccent : str.length(tradingSession) > 0 ? panelValue : panelMuted, text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 6, "Risk / Trade", text_color = panelLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 6, riskLabel, text_color = riskOverridden ? panelAccent : panelValue, text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 7, "Entries / Range", text_color = panelLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 7, entriesLabel, text_color = entriesOverridden ? panelAccent : panelValue, text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 8, "TP", text_color = panelLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 8, tpLabel + ((tpStyleOverridden or tpTicksOverridden) ? " / P " + presetTpLabel : ""), text_color = tpStyleOverridden or tpTicksOverridden ? panelAccent : panelValue, text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 9, "SL", text_color = panelLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 9, slLabel + ((slStyleOverridden or slTicksOverridden) ? " / P " + presetSlLabel : ""), text_color = slStyleOverridden or slTicksOverridden ? panelAccent : panelValue, text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 10, "EOD Flatten", text_color = panelLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 10, eodFlattenTime + (eodOverridden ? " / P " + presetEodFlattenTime : ""), text_color = eodOverridden ? panelAccent : panelValue, text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 11, "Buy / Sell Qty", text_color = panelLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 11, quantityLabel, text_color = panelValue, text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 12, "Entry Offset", text_color = panelLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 12, str.tostring(bracketEntryOffsetTicks) + " ticks", text_color = bracketEntryOffsetTicks != 0 ? panelAccent : panelMuted, text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 13, "After SL", text_color = panelLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 13, rearmSameSideStopAfterSl ? "Rearm Same Side" : "No Re-entry", text_color = rearmSameSideStopAfterSl ? panelAccent : panelMuted, text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 14, "After TP", text_color = panelLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 14, afterTpLabel, text_color = rearmSameSideStopAfterTp or true ? panelAccent : panelMuted, text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 15, "Next Range", text_color = panelLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 15, staleBracketLabel, text_color = staleBracketLabel == "Retained (safe)" ? panelAccent : panelValue, text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 16, "Fallback SL at:", text_color = panelLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 16, slRangeTickThreshold >= 0 ? str.tostring(slRangeTickThreshold) + " ticks" : "Off", text_color = slRangeTickThreshold >= 0 ? panelValue : panelMuted, text_size = size.normal, text_halign = text.align_right)
    table.cell(info, 0, 17, "Fallback SL Style", text_color = panelLabel, text_size = size.normal, text_halign = text.align_left)
    table.cell(info, 1, 17, slRangeTickThreshold >= 0 ? slAboveThresholdStyle : "N/A", text_color = slRangeTickThreshold >= 0 ? panelValue : panelMuted, text_size = size.normal, text_halign = text.align_right)

// Dispatch any queued, de-duplicated alerts
if array.size(alertQueue) > 0
    for i = 0 to array.size(alertQueue) - 1
        alert(array.get(alertQueue, i), alert.freq_all)
array.clear(alertQueue)

if showPresetInfo and barstate.islast
    renderPresetInfoPanel()

//---------------------------------------------------------------------------------------------------------------------}
