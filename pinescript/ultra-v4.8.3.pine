    array.push(tradeSplitTp2Dist, pendingRetestIsSplit ? pendingRetestRunner1Dist : na)
    array.push(tradeSplitTp3Dist, pendingRetestIsSplit ? pendingRetestRunner2Dist : na)
    array.push(tradeSplitTp4Dist, pendingRetestIsSplit ? pendingRetestRunner3Dist : na)
    array.push(tradeSplitTp1Hit, false)
    array.push(tradeSplitTp2Hit, false)
    array.push(tradeSplitTp3Hit, false)
    array.push(tradeSplitTp4Hit, false)
    array.push(tradeSplitNewSlDist, pendingRetestIsSplit ? 0.0 : na)
    array.push(tradeHalfTp1Dist, pendingRetestIsHalfOut ? pendingRetestTpDist : na)
    array.push(tradeHalfTp2Dist, pendingRetestIsHalfOut ? pendingRetestRunner1Dist : na)
    array.push(tradeHalfTp1Hit, false)
    array.push(tradeHalfTp2Hit, false)
    array.push(tradeHalfNewSlDist, pendingRetestIsHalfOut ? 0.0 : na)
    array.push(tradeBeTriggered, false)
    if sendLifecycleAlerts and sellQuantity > 0
        fireAlert(lifecycleEntryJson("entry_filled", lifecycleTradeId, -1, sellQuantity, pendingRetestEntry, "sell"))
    pendingRetestEntry := na
    pendingRetestTpDist := na
    pendingRetestSlDist := na
    pendingRetestRunner1Dist := na
    pendingRetestRunner2Dist := na
    pendingRetestRunner3Dist := na
    pendingRetestBeTriggerDist := na
    pendingRetestBeOffsetDist := na
    pendingRetestBeRequireClose := false
    pendingRetestRangeId := 0
    pendingRetestIsSplit := false
    pendingRetestIsHalfOut := false

if up_signal and not fillBuyRetestLimit
    activeBuyTp := buy_tp
    float trackEntry = not na(signalBuyEntryLevel) ? signalBuyEntryLevel : orh
    string lifecycleTradeId = lifecycleMarketTradeId(rangeStartTime, currentRangeId, bar_index, 1, trackEntry)
    float trackedTpDist = na
    if buyAcrossRange
        trackedTpDist := fibBuyTpDist
    else if tpIsOverridden or tpIsTicks
        trackedTpDist := fibBuyTpDist
    else if buyBreakoutWickTrigger
        trackedTpDist := fibBuyTpDist
    else if or_token
        trackedTpDist := up_signal_deep ? rangeDistance * tpMultiplier : orh + rangeDistance * tpMultiplier - trackEntry
    else
        trackedTpDist := fibBuyTpDist
    float trackedSlDist = na
    if buyAcrossRange
        trackedSlDist := fibBuySlDist
    else if not na(signalBuySlOverride)
        trackedSlDist := signalBuySlOverride
    else
        if slIsOverridden or slIsTicks
            trackedSlDist := fibBuySlDist
        else if buyBreakoutWickTrigger
            trackedSlDist := fibBuySlDist
        else if or_token
            trackedSlDist := up_signal_deep ? rangeDistance + slExtra : trackEntry - orl + slExtra
        else
            trackedSlDist := fibBuySlDist
    array.push(tradeEntries, trackEntry)
    array.push(tradeEntryBars, bar_index)
    array.push(tradeSides, 1)
    array.push(tradeTpDists, trackedTpDist)
    array.push(tradeSlDists, trackedSlDist)
    array.push(tradeSlRequireCloseConfirm, useCloseConfirmedSl)
    array.push(tradeBeTriggerDists, beTriggerDistance)
    array.push(tradeBeOffsetDists, beOffsetDistance)
    array.push(tradeBeRequireCloseConfirm, beTriggerConfirmation == "Candle Close Beyond Trigger")
    array.push(tradeUsesMarketBe, not buyUseStopOrder and not buyUseLimitOrder)
    array.push(tradeRangeIds, currentRangeId)
    array.push(tradeRangeResultIdxs, currentRangeResultIdx)
    array.push(tradeBracketIds, "")
    array.push(tradeLifecycleIds, lifecycleTradeId)
    array.push(tradeQuantities, buyQuantity)
    array.push(tradeIsSplit, effectiveSplit)
    array.push(tradeIsHalfOut, effectiveHalfOut)
    array.push(tradeSplitTp1Dist, effectiveSplit ? trackedTpDist : na)
    array.push(tradeSplitTp2Dist, effectiveSplit ? buyRunner1Dist : na)
    array.push(tradeSplitTp3Dist, effectiveSplit ? buyRunner2Dist : na)
    array.push(tradeSplitTp4Dist, effectiveSplit ? buyRunner3Dist : na)
    array.push(tradeSplitTp1Hit, false)
    array.push(tradeSplitTp2Hit, false)
    array.push(tradeSplitTp3Hit, false)
    array.push(tradeSplitTp4Hit, false)
    array.push(tradeSplitNewSlDist, effectiveSplit ? 0.0 : na)
    array.push(tradeHalfTp1Dist, effectiveHalfOut ? trackedTpDist : na)
    array.push(tradeHalfTp2Dist, effectiveHalfOut ? buyRunner1Dist : na)
    array.push(tradeHalfTp1Hit, false)
    array.push(tradeHalfTp2Hit, false)
    array.push(tradeHalfNewSlDist, effectiveHalfOut ? 0.0 : na)
    array.push(tradeBeTriggered, false)
    if sendLifecycleAlerts and buyQuantity > 0
        fireAlert(lifecycleEntryJson("entry_filled", lifecycleTradeId, 1, buyQuantity, trackEntry, "buy"))
if down_signal and not fillSellRetestLimit
    activeSellTp := sell_tp
    float trackEntry = not na(signalSellEntryLevel) ? signalSellEntryLevel : orl
    string lifecycleTradeId = lifecycleMarketTradeId(rangeStartTime, currentRangeId, bar_index, -1, trackEntry)
    float trackedTpDist = na
    if sellAcrossRange
        trackedTpDist := fibSellTpDist
    else if tpIsOverridden or tpIsTicks
        trackedTpDist := fibSellTpDist
    else if sellBreakoutWickTrigger
        trackedTpDist := fibSellTpDist
    else if or_token
        trackedTpDist := down_signal_deep ? rangeDistance * tpMultiplier : trackEntry - (orl - rangeDistance * tpMultiplier)
    else
        trackedTpDist := fibSellTpDist
    float trackedSlDist = na
    if sellAcrossRange
        trackedSlDist := fibSellSlDist
    else if not na(signalSellSlOverride)
        trackedSlDist := signalSellSlOverride
    else
        if slIsOverridden or slIsTicks
            trackedSlDist := fibSellSlDist
        else if sellBreakoutWickTrigger
            trackedSlDist := fibSellSlDist
        else if or_token
            trackedSlDist := down_signal_deep ? rangeDistance + slExtra : orh + slExtra - trackEntry
        else
            trackedSlDist := fibSellSlDist
    array.push(tradeEntries, trackEntry)
    array.push(tradeEntryBars, bar_index)
    array.push(tradeSides, -1)
    array.push(tradeTpDists, trackedTpDist)
    array.push(tradeSlDists, trackedSlDist)
    array.push(tradeSlRequireCloseConfirm, useCloseConfirmedSl)
    array.push(tradeBeTriggerDists, beTriggerDistance)
    array.push(tradeBeOffsetDists, beOffsetDistance)
    array.push(tradeBeRequireCloseConfirm, beTriggerConfirmation == "Candle Close Beyond Trigger")
    array.push(tradeUsesMarketBe, not sellUseStopOrder and not sellUseLimitOrder)
    array.push(tradeRangeIds, currentRangeId)
    array.push(tradeRangeResultIdxs, currentRangeResultIdx)
    array.push(tradeBracketIds, "")
    array.push(tradeLifecycleIds, lifecycleTradeId)
    array.push(tradeQuantities, sellQuantity)
    array.push(tradeIsSplit, effectiveSplit)
    array.push(tradeIsHalfOut, effectiveHalfOut)
    array.push(tradeSplitTp1Dist, effectiveSplit ? trackedTpDist : na)
    array.push(tradeSplitTp2Dist, effectiveSplit ? sellRunner1Dist : na)
    array.push(tradeSplitTp3Dist, effectiveSplit ? sellRunner2Dist : na)
    array.push(tradeSplitTp4Dist, effectiveSplit ? sellRunner3Dist : na)
    array.push(tradeSplitTp1Hit, false)
    array.push(tradeSplitTp2Hit, false)
    array.push(tradeSplitTp3Hit, false)
    array.push(tradeSplitTp4Hit, false)
    array.push(tradeSplitNewSlDist, effectiveSplit ? 0.0 : na)
    array.push(tradeHalfTp1Dist, effectiveHalfOut ? trackedTpDist : na)
    array.push(tradeHalfTp2Dist, effectiveHalfOut ? sellRunner1Dist : na)
    array.push(tradeHalfTp1Hit, false)
    array.push(tradeHalfTp2Hit, false)
    array.push(tradeHalfNewSlDist, effectiveHalfOut ? 0.0 : na)
    array.push(tradeBeTriggered, false)
    if sendLifecycleAlerts and sellQuantity > 0
        fireAlert(lifecycleEntryJson("entry_filled", lifecycleTradeId, -1, sellQuantity, trackEntry, "sell"))

bool bracketLongTpHitOnFill = bracketLongFilled and high >= bracketLongEntryPrice + bracketLongTpDistance
bool bracketShortTpHitOnFill = bracketShortFilled and low <= bracketShortEntryPrice - bracketShortTpDistance
if true and not bracketTpCancellationSignal
    if bracketLongTpHitOnFill and bracketShortPending
        // bridge records entry_cancelled after successful cancel

        bracketShortPending := false
        bracketTpCancellationSignal := true
    else if bracketShortTpHitOnFill and bracketLongPending
        // bridge records entry_cancelled after successful cancel

        bracketLongPending := false
        bracketTpCancellationSignal := true
    bracketOrdersActive := bracketLongPending or bracketShortPending

bool bracketLongTradeStarted = bracketLongFillPendingConfirmation and barstate.isconfirmed
bool bracketShortTradeStarted = bracketShortFillPendingConfirmation and barstate.isconfirmed

if bracketLongTradeStarted
    activeBuyTp := bracketLongEntryPrice + bracketLongTpDistance
    array.push(tradeEntries, bracketLongEntryPrice)
    array.push(tradeEntryBars, bar_index)
    array.push(tradeSides, 1)
    array.push(tradeTpDists, bracketLongTpDistance)
    array.push(tradeSlDists, bracketLongSlDistance)
    array.push(tradeSlRequireCloseConfirm, useCloseConfirmedSl)
    array.push(tradeBeTriggerDists, beTriggerDistance)
    array.push(tradeBeOffsetDists, beOffsetDistance)
    array.push(tradeBeRequireCloseConfirm, beTriggerConfirmation == "Candle Close Beyond Trigger")
    array.push(tradeUsesMarketBe, true)
    array.push(tradeRangeIds, bracketRangeId)
    array.push(tradeRangeResultIdxs, bracketRangeResultIdx)
    array.push(tradeBracketIds, bracketLongArmId)
    array.push(tradeLifecycleIds, bracketLongLifecycleTradeId)
    array.push(tradeQuantities, bracketLongQuantity)
    array.push(tradeIsSplit, effectiveSplit)
    array.push(tradeIsHalfOut, effectiveHalfOut)
    array.push(tradeSplitTp1Dist, effectiveSplit ? bracketLongTpDistance : na)
    array.push(tradeSplitTp2Dist, effectiveSplit ? bracketLongRunner1Distance : na)
    array.push(tradeSplitTp3Dist, effectiveSplit ? bracketLongRunner2Distance : na)
    array.push(tradeSplitTp4Dist, effectiveSplit ? bracketLongRunner3Distance : na)
    array.push(tradeSplitTp1Hit, false)
    array.push(tradeSplitTp2Hit, false)
    array.push(tradeSplitTp3Hit, false)
    array.push(tradeSplitTp4Hit, false)
    array.push(tradeSplitNewSlDist, effectiveSplit ? 0.0 : na)
    array.push(tradeHalfTp1Dist, effectiveHalfOut ? bracketLongTpDistance : na)
    array.push(tradeHalfTp2Dist, effectiveHalfOut ? bracketLongRunner1Distance : na)
    array.push(tradeHalfTp1Hit, false)
    array.push(tradeHalfTp2Hit, false)
    array.push(tradeHalfNewSlDist, effectiveHalfOut ? 0.0 : na)
    array.push(tradeBeTriggered, false)
    if sendLifecycleAlerts and bracketLongQuantity > 0
        fireAlert(lifecycleEntryJson("entry_filled", bracketLongLifecycleTradeId, 1, bracketLongQuantity, bracketLongEntryPrice, "buy"))
    bracketLongFillPendingConfirmation := false

if bracketShortTradeStarted
    activeSellTp := bracketShortEntryPrice - bracketShortTpDistance
    array.push(tradeEntries, bracketShortEntryPrice)
    array.push(tradeEntryBars, bar_index)
    array.push(tradeSides, -1)
    array.push(tradeTpDists, bracketShortTpDistance)
    array.push(tradeSlDists, bracketShortSlDistance)
    array.push(tradeSlRequireCloseConfirm, useCloseConfirmedSl)
    array.push(tradeBeTriggerDists, beTriggerDistance)
    array.push(tradeBeOffsetDists, beOffsetDistance)
    array.push(tradeBeRequireCloseConfirm, beTriggerConfirmation == "Candle Close Beyond Trigger")
    array.push(tradeUsesMarketBe, true)
    array.push(tradeRangeIds, bracketRangeId)
    array.push(tradeRangeResultIdxs, bracketRangeResultIdx)
    array.push(tradeBracketIds, bracketShortArmId)
    array.push(tradeLifecycleIds, bracketShortLifecycleTradeId)
    array.push(tradeQuantities, bracketShortQuantity)
    array.push(tradeIsSplit, effectiveSplit)
    array.push(tradeIsHalfOut, effectiveHalfOut)
    array.push(tradeSplitTp1Dist, effectiveSplit ? bracketShortTpDistance : na)
    array.push(tradeSplitTp2Dist, effectiveSplit ? bracketShortRunner1Distance : na)
    array.push(tradeSplitTp3Dist, effectiveSplit ? bracketShortRunner2Distance : na)
    array.push(tradeSplitTp4Dist, effectiveSplit ? bracketShortRunner3Distance : na)
    array.push(tradeSplitTp1Hit, false)
    array.push(tradeSplitTp2Hit, false)
    array.push(tradeSplitTp3Hit, false)
    array.push(tradeSplitTp4Hit, false)
    array.push(tradeSplitNewSlDist, effectiveSplit ? 0.0 : na)
    array.push(tradeHalfTp1Dist, effectiveHalfOut ? bracketShortTpDistance : na)
    array.push(tradeHalfTp2Dist, effectiveHalfOut ? bracketShortRunner1Distance : na)
    array.push(tradeHalfTp1Hit, false)
    array.push(tradeHalfTp2Hit, false)
    array.push(tradeHalfNewSlDist, effectiveHalfOut ? 0.0 : na)
    array.push(tradeBeTriggered, false)
    if sendLifecycleAlerts and bracketShortQuantity > 0
        fireAlert(lifecycleEntryJson("entry_filled", bracketShortLifecycleTradeId, -1, bracketShortQuantity, bracketShortEntryPrice, "sell"))
    bracketShortFillPendingConfirmation := false

// Resolve newly confirmed bracket fills on their fill bar before alert dispatch.
if array.size(tradeEntries) > 0
    int tradeIndex = array.size(tradeEntries) - 1
    while tradeIndex >= 0
        float tradeEntry = array.get(tradeEntries, tradeIndex)
        int tradeSide = array.get(tradeSides, tradeIndex)
        float tradeTpDist = array.get(tradeTpDists, tradeIndex)
        float tradeSlDist = array.get(tradeSlDists, tradeIndex)
        float tradeBeTriggerDist = array.get(tradeBeTriggerDists, tradeIndex)
        float tradeBeOffsetDist = array.get(tradeBeOffsetDists, tradeIndex)
        bool tradeSlNeedsCloseConfirm = array.get(tradeSlRequireCloseConfirm, tradeIndex)
        bool tradeBeNeedsCloseConfirm = array.get(tradeBeRequireCloseConfirm, tradeIndex)
        int tradeEntryBar = array.get(tradeEntryBars, tradeIndex)
        int tradeRangeId = array.get(tradeRangeIds, tradeIndex)
        string tradeBracketId = array.get(tradeBracketIds, tradeIndex)
        string tradeLifecycleId = array.get(tradeLifecycleIds, tradeIndex)
        float tradeQuantity = array.get(tradeQuantities, tradeIndex)
        bool tradeInCurrentRange = tradeRangeId == currentRangeId
        bool isSplitTrade = array.get(tradeIsSplit, tradeIndex)
        bool isHalfOutTrade = array.get(tradeIsHalfOut, tradeIndex)
        float favorableMove = tradeSide == 1 ? (high - tradeEntry) : (tradeEntry - low)
        float adverseMove   = tradeSide == 1 ? (tradeEntry - low) : (high - tradeEntry)
        bool tradeResolved = false
        bool beStopEnabled = useBeStop and array.get(tradeUsesMarketBe, tradeIndex)
        bool beTriggeredVal = array.get(tradeBeTriggered, tradeIndex)
        bool beTriggeredBefore = beTriggeredVal
        bool beTriggerReached = tradeBeNeedsCloseConfirm ? (tradeSide == 1 ? close >= tradeEntry + tradeBeTriggerDist : close <= tradeEntry - tradeBeTriggerDist) : favorableMove >= tradeBeTriggerDist
        float fillBarFirstTargetDistance = isSplitTrade ? array.get(tradeSplitTp1Dist, tradeIndex) : isHalfOutTrade ? array.get(tradeHalfTp1Dist, tradeIndex) : tradeTpDist
        bool fillBarIsBracketEntry = tradeEntryBar == bar_index and str.length(tradeBracketId) > 0
        bool fillBarTargetTouched = not na(fillBarFirstTargetDistance) and favorableMove >= fillBarFirstTargetDistance
        float fillBarBeStopPrice = tradeSide == 1 ? tradeEntry + tradeBeOffsetDist : tradeEntry - tradeBeOffsetDist
        bool fillBarStopTouched = beStopEnabled and beTriggerReached ? (tradeSide == 1 ? low <= fillBarBeStopPrice : high >= fillBarBeStopPrice) : tradeSlNeedsCloseConfirm ? (tradeSide == 1 ? close < tradeEntry - tradeSlDist : close > tradeEntry + tradeSlDist) : adverseMove >= tradeSlDist
        bool fillBarFilledAtOpen = tradeSide == 1 ? open >= tradeEntry : open <= tradeEntry
        // OHLC cannot sequence a stop-entry, its target, and its stop when they all trade in one bar.
        // Defer those ambiguous fills; target-only fills and gap-filled stop exits remain deterministic.
        bool deferAmbiguousBracketFill = fillBarIsBracketEntry and fillBarStopTouched and (fillBarTargetTouched or not fillBarFilledAtOpen)
        if beStopEnabled and not beTriggeredVal and beTriggerReached and not deferAmbiguousBracketFill
            beTriggeredVal := true
        if deferAmbiguousBracketFill
            favorableMove := -1.0
            adverseMove := -1.0
            tradeSlNeedsCloseConfirm := false
            beTriggeredVal := false

        if isSplitTrade
            float splitTp1DistVal = array.get(tradeSplitTp1Dist, tradeIndex)
            float splitTp2DistVal = array.get(tradeSplitTp2Dist, tradeIndex)
            float splitTp3DistVal = array.get(tradeSplitTp3Dist, tradeIndex)
            float splitTp4DistVal = array.get(tradeSplitTp4Dist, tradeIndex)
            bool splitTp1HitVal = array.get(tradeSplitTp1Hit, tradeIndex)
            bool splitTp2HitVal = array.get(tradeSplitTp2Hit, tradeIndex)
            bool splitTp3HitVal = array.get(tradeSplitTp3Hit, tradeIndex)
            bool splitTp4HitVal = array.get(tradeSplitTp4Hit, tradeIndex)
            float splitNewSlDistVal = array.get(tradeSplitNewSlDist, tradeIndex)
            bool tp1WasHitBefore = splitTp1HitVal

            if not splitTp1HitVal and favorableMove >= splitTp1DistVal
                splitTp1HitVal := true
                if true and not bracketTpCancellationSignal and tradeBracketId == (tradeSide == 1 ? bracketLongArmId : bracketShortArmId)
                    if tradeSide == 1 and bracketShortPending
                        // bridge records entry_cancelled after successful cancel
                
                        bracketShortPending := false
                        bracketTpCancellationSignal := true
                    else if tradeSide == -1 and bracketLongPending
                        // bridge records entry_cancelled after successful cancel
                
                        bracketLongPending := false
                        bracketTpCancellationSignal := true
                    bracketOrdersActive := bracketLongPending or bracketShortPending

                float tp1R = tradeSlDist > 0 ? 0.25 * (splitTp1DistVal / tradeSlDist) : 0.25
                totalWins += 1
                totalR += tp1R
                totalTicks += 0.25 * (splitTp1DistVal / syminfo.mintick)
