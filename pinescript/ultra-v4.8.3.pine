                signalSellEntryLevel := pendingRetestEntry
            pendingRetestActive := false
            pendingRetestSide := 0
            pendingRetestPlacedBar := na

    bool hasActiveTrade = array.size(tradeSides) > 0 or (not bracketOrdersForcedOn and pendingRetestActive) or bracketOrdersActive or bracketLongFilled or bracketShortFilled
    bool hasPendingBreakoutSetup = not bracketOrdersForcedOn and (not na(pendingDownBreakoutBar) or not na(pendingUpBreakoutBar))
    bool canStartNewTrade = not hasActiveTrade and not hasPendingBreakoutSetup and not bracketPlacementEligible
    bool canFillPendingTrade = not hasActiveTrade
    float shortSignalLevel = orl
    float longSignalLevel = orh
    float shortBufferedSignalLevel = shortSignalLevel
    float longBufferedSignalLevel = longSignalLevel
