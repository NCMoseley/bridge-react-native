//@version=6

// Ultra 4.8.3 can report simulated lifecycle events to the relay through a TradingView (From GPT, please test)
// "Any alert() function call" alert. Configure that alert to use the proxy webhook;
// lifecycle payloads are relay-only and explicit trade_closed events are authoritative.
indicator("ULTRA 4.8.3", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
//inputs
//---------------------------------------------------------------------------------------------------------------------{

//─── Schedule ───────────────────────────────────────────────────────────────────

tz = "America/New_York"

