//Calculations
//---------------------------------------------------------------------------------------------------------------------{

orm = math.avg(orh,orl)
float _mintick = na(syminfo.mintick) or syminfo.mintick <= 0 ? 0.01 : syminfo.mintick
// Reset per-bar alert dedupe before any fireAlert calls
if bar_index != alertFiredBar
    array.clear(alertFiredThisBar)
    alertFiredBar := bar_index

orw = na(orh) or na(orl) ? _mintick : math.max(_mintick, math.abs(orh - orl))

//Establishing When the Range Session is

or_sesh := activeRangeEnabled and not na(time(timeframe.period, crSesh, tz))

or_start = or_sesh and not or_sesh[1]
or_end = or_sesh[1] and not or_sesh

//On Start of OR Session
if or_start
    // Always retain the previous range's bracket while the new range is forming.
    // The gate that cancels it happens at or_end, once the new range is fully formed.
    currentRangeId += 1
    rangeStartTime := time
    for targ in up_targs
        if showHist == false
            targ.ln.delete()
        targ.lab.delete()

    for targ in down_targs
        if showHist == false
            targ.ln.delete()
        targ.lab.delete()

    for lab in signals
        if showHist == false
            lab.delete()

    for guide in trade_guides
        guide.ln.delete()
        guide.lab.delete()

    if showHist == false and array.size(rangeResultLabels) > 0
        for i = 0 to array.size(rangeResultLabels) - 1
            oldRangeResultLabel = array.get(rangeResultLabels, i)
            if not na(oldRangeResultLabel)
                label.delete(oldRangeResultLabel)
                array.set(rangeResultLabels, i, na)

    if showHist == false
        or_bx.delete()
        h_ln.ln.delete()
        l_ln.ln.delete()
        m_ln.delete()
        range_height_label.delete()
    else
        range_height_label.delete()

    h_ln.lab.delete()
    l_ln.lab.delete()
    up_targs.clear()
    down_targs.clear()
    trade_guides.clear()
    if showHist
        while array.size(signals) > 250
            label.delete(array.shift(signals))
    else
        while array.size(signals) > 0
            label.delete(array.pop(signals))

    orh := high
    orl := low
    prev_orm := orm[1]
    up_count := 0
    down_count := 0
    lastResolvedEntrySide := 0
    lastResolvedEntrySideCount := 0
    up_check := true
    down_check := true
    upWickCount := 0
    downWickCount := 0
    upLastWickBar := na
    downLastWickBar := na
    upCooldownUntilBar := na
    downCooldownUntilBar := na
    pendingDownBreakoutBar := na
    pendingUpBreakoutBar := na
    pendingDownEntryLevel := na
    pendingUpEntryLevel := na
    pendingDownBreakoutSlDist := na
    pendingUpBreakoutSlDist := na
    pendingDownDeep := false
    pendingUpDeep := false
    pendingRetestActive := false
    pendingRetestSide := 0
    pendingRetestPlacedBar := na
    pendingRetestEntry := na
    pendingRetestTpDist := na
    pendingRetestSlDist := na
    pendingRetestRunner1Dist := na
    pendingRetestRunner2Dist := na
    pendingRetestRunner3Dist := na
    pendingRetestBeTriggerDist := na
    pendingRetestBeOffsetDist := na
    pendingRetestBeRequireClose := false
    pendingRetestRangeId := 0
    pendingRetestIsSplit := false
    pendingRetestIsHalfOut := false
    rangeSessionDayOfMonth := na
    activeBuyTp  := na
    activeSellTp := na
    rangeWins    := 0
    rangeLosses  := 0
    rangeR       := 0.0
    recoveryMode := false
    lastSignalEntry := na
    lastSignalSide  := 0
    lastSignalTpDist := na
    lastSignalSlDist := na
    lastSignalResolved := true

    or_bx := box.new(bar_index,high,bar_index,low, bgcolor = orFillColor, border_width = 0)

    or_token := false

    label rangeResultLabel = label.new(or_bx.get_left(), orm, formatRangeR(0.0), style = label.style_label_right, color = invis, textcolor = rangeRColor(0.0), size = size.large)
    array.push(rangeResultValues, 0.0)
    array.push(rangeResultLabels, rangeResultLabel)
    currentRangeResultIdx := array.size(rangeResultValues) - 1

//Running while OR Session is Live
if or_sesh
    if high > orh
        orh := high
    if low < orl
        orl := low
    or_bx.set_top(orh)
    or_bx.set_bottom(orl)
    or_bx.set_right(bar_index)
    or_bx.set_bgcolor(hideRangePaint ? color.new(orFillColor, 100) : orFillColor)
    if orh != orl
        or_token := true
        
        // Update range height label
        if showTicksLabel
            range_ticks = math.round((orh - orl) / syminfo.mintick)
