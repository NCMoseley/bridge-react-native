    float longEntryFilterLevel = not na(pendingUpEntryLevel) ? pendingUpEntryLevel : longBufferedSignalLevel
    float shortWickOvershoot = math.max(0.0, shortSignalLevel - low)
    float longWickOvershoot = math.max(0.0, high - longSignalLevel)
    bool shortWickDistanceValid = true
    bool longWickDistanceValid = true
    bool shortWickCrossBar = bearishWickBar and high >= orl and low < shortBufferedSignalLevel and shortWickDistanceValid
    bool longWickCrossBar = bullishWickBar and low <= orh and high > longBufferedSignalLevel and longWickDistanceValid
    bool shortSignalBar = shortWickCrossBar
    bool longSignalBar = longWickCrossBar
    bool shortPreviousWickTrigger = not na(pendingDownBreakoutBar) and not na(pendingDownEntryLevel) and bar_index > pendingDownBreakoutBar and high >= pendingDownEntryLevel and low < pendingDownEntryLevel and shortWickDistanceValid
    bool longPreviousWickTrigger = not na(pendingUpBreakoutBar) and not na(pendingUpEntryLevel) and bar_index > pendingUpBreakoutBar and low <= pendingUpEntryLevel and high > pendingUpEntryLevel and longWickDistanceValid
    bool requireSecondWick = false
    bool usesRetestLimitEntry = false
    bool usesDelayedWickEntry = false
    bool shortRetestPlacementBar = false
    bool longRetestPlacementBar = false
    bool canTakeMoreEntries = true
    bool directSignalEntriesAllowed = not bracketOrdersForcedOn
    bool canTakeMoreRangeEntries = not bracketOrdersForcedOn or bracketEntriesThisRange < maxBracketEntriesPerRange
    bool shortSideAvailable = true
    bool longSideAvailable = true
    bool canEnterNow = directSignalEntriesAllowed and canTakeMoreEntries and canTakeMoreRangeEntries and canStartNewTrade and tradingDayEntryAllowed
    bool canTriggerPendingEntry = directSignalEntriesAllowed and canTakeMoreEntries and canTakeMoreRangeEntries and canFillPendingTrade and tradingDayEntryAllowed
    bool setupQueuedThisBar = false

    bool shortSignalReady = shortSignalBar
    bool shortRetestPlacementReady = shortRetestPlacementBar
    if usesRetestLimitEntry and shortRetestPlacementReady and canEnterNow and shortSideAvailable and not up_signal and not down_signal and not setupQueuedThisBar
        signalSellEntryLevel := shortBufferedSignalLevel
        placeSellRetestLimit := true
        setupQueuedThisBar := true
        downWickCount := 0
        downLastWickBar := na
    if not usesDelayedWickEntry and not usesRetestLimitEntry and shortSignalReady and canEnterNow and shortSideAvailable and not up_signal and not down_signal
        down_signal := true
        down_signal_deep := false
        signalSellEntryLevel := shortBufferedSignalLevel
        downWickCount := 0
        downLastWickBar := na
        logSignal("down", "shortSignalReady")
    if usesDelayedWickEntry and shortSignalBar and canEnterNow and shortSideAvailable and not up_signal and not down_signal and not setupQueuedThisBar
        pendingDownBreakoutBar := bar_index
        pendingDownEntryLevel := shortBufferedSignalLevel
        pendingDownBreakoutSlDist := high - low
        pendingDownDeep := false
        setupQueuedThisBar := true
    if false and not na(pendingDownBreakoutBar) and bar_index > pendingDownBreakoutBar + 1
        pendingDownBreakoutBar := na
        pendingDownEntryLevel := na
        pendingDownBreakoutSlDist := na
        pendingDownDeep := false
    bool shortDelayedReady = false
    if usesDelayedWickEntry and shortDelayedReady and canTriggerPendingEntry and shortSideAvailable  and not up_signal and not down_signal
        down_signal := true
        down_signal_deep := pendingDownDeep
        signalSellEntryLevel := pendingDownEntryLevel
        signalSellSlOverride := na
        pendingDownBreakoutBar := na
        logSignal("down", "shortDelayedReady")
        pendingDownEntryLevel := na
        pendingDownBreakoutSlDist := na
        pendingDownDeep := false

    bool longSignalReady = longSignalBar
    bool longRetestPlacementReady = longRetestPlacementBar
    if usesRetestLimitEntry and longRetestPlacementReady and canEnterNow and longSideAvailable and not up_signal and not down_signal and not setupQueuedThisBar
        signalBuyEntryLevel := longBufferedSignalLevel
        placeBuyRetestLimit := true
        setupQueuedThisBar := true
        upWickCount := 0
        upLastWickBar := na
    if not usesDelayedWickEntry and not usesRetestLimitEntry and longSignalReady and canEnterNow and longSideAvailable  and not up_signal and not down_signal
        up_signal := true
        up_signal_deep := false
        signalBuyEntryLevel := longBufferedSignalLevel
        upWickCount := 0
        upLastWickBar := na
        logSignal("up", "longSignalReady")
    if usesDelayedWickEntry and longSignalBar and canEnterNow and longSideAvailable and not up_signal and not down_signal and not setupQueuedThisBar
        pendingUpBreakoutBar := bar_index
        pendingUpEntryLevel := longBufferedSignalLevel
        pendingUpBreakoutSlDist := high - low
        pendingUpDeep := false
        setupQueuedThisBar := true
    if false and not na(pendingUpBreakoutBar) and bar_index > pendingUpBreakoutBar + 1
        pendingUpBreakoutBar := na
        pendingUpEntryLevel := na
        pendingUpBreakoutSlDist := na
        pendingUpDeep := false
    bool longDelayedReady = false
    if usesDelayedWickEntry and longDelayedReady and canTriggerPendingEntry and longSideAvailable and not up_signal and not down_signal
        up_signal := true
        up_signal_deep := pendingUpDeep
        signalBuyEntryLevel := pendingUpEntryLevel
        signalBuySlOverride := na
        pendingUpBreakoutBar := na
        logSignal("up", "longDelayedReady")
        pendingUpEntryLevel := na
        pendingUpBreakoutSlDist := na
        pendingUpDeep := false

    if up_signal or down_signal
        pendingDownBreakoutBar := na
        pendingUpBreakoutBar := na
        pendingDownEntryLevel := na
        pendingUpEntryLevel := na
        pendingDownBreakoutSlDist := na
        pendingUpBreakoutSlDist := na
        pendingDownDeep := false
        pendingUpDeep := false

//---------------------------------------------------------------------------------------------------------------------}
//Display
//---------------------------------------------------------------------------------------------------------------------{

//Targets
if not or_sesh and or_token
    if up_count < up_max and up_count < 5 and tTog
        for i = (up_count+1) to up_max
            up_targs.push(target.new(
              line.new(bar_index-1,(orh+orw*tPer*i),bar_index,(orh+(orw*tPer*i)), color = green, style = linestyle(tStyle)),
              label.new(bar_index + rangeLabelOffsetBars,(orh+orw*tPer*i),text = formatTargetLabel(str.tostring(i), orh + orw * tPer * i, showTargetPrices),tooltip = str.tostring(orh+orw*tPer*i,format.mintick), style = label.style_label_left, color = invis, textcolor = color.new(green,0), size = txtSize)
              ))
            if i == up_max
                up_count := up_max
    if down_count < down_max and down_count < 5 and tTog
        for i = (down_count+1) to down_max
            down_targs.push(target.new(
              line.new(bar_index-1,(orl-orw*tPer*i),bar_index,(orl-(orw*tPer*i)), color = red, style = linestyle(tStyle)),
              label.new(bar_index + rangeLabelOffsetBars,(orl-orw*tPer*i),text = formatTargetLabel(str.tostring(i), orl - orw * tPer * i, showTargetPrices),tooltip = str.tostring(orl-orw*tPer*i,format.mintick), style = label.style_label_left, color = invis, textcolor = color.new(red,0), size = txtSize)
              ))
            if i == down_max
                down_count := down_max

//Extending to Current Bar
if tDispType == "Extended" and tTog
    for targ in up_targs
        targ.ln.set_x2(bar_index)
        targ.lab.set_x(bar_index + rangeLabelOffsetBars)
    for targ in down_targs
        targ.ln.set_x2(bar_index)
        targ.lab.set_x(bar_index + rangeLabelOffsetBars)

if tDispType == "Adaptive" and tTog
    for targ in up_targs
        if targ.ln.get_y1() <= (orh+(orw*tPer*(up_cur))) and targ.ln.get_y1() >= (orh+(orw*tPer*(up_cur-2)))
            targ.ln.set_x2(bar_index+1)
            targ.lab.set_x(bar_index+1)
    for targ in down_targs
        if targ.ln.get_y1() <= (orl-(orw*tPer*(down_cur-2))) and targ.ln.get_y1() >= (orl-(orw*tPer*(down_cur)))
            targ.ln.set_x2(bar_index+1)
            targ.lab.set_x(bar_index+1)

//Signals
if up_signal and sigTog
    float upEntryLevel = not na(signalBuyEntryLevel) ? signalBuyEntryLevel : up_signal_deep ? orh + orw * tPer : orh
    signals.push(label.new(bar_index, upEntryLevel,
      style = label.style_label_center,
      text = "▲",
      color = invis,
      textcolor = upSigColor,
      size = sigSize))

if down_signal and sigTog
    float downEntryLevel = not na(signalSellEntryLevel) ? signalSellEntryLevel : down_signal_deep ? orl - orw * tPer : orl
    signals.push(label.new(bar_index, downEntryLevel,
      style = label.style_label_center,
      text = "▼",
      color = invis,
      textcolor = downSigColor,
      size = sigSize))

//---------------------------------------------------------------------------------------------------------------------}
//Webhook Alerts
//---------------------------------------------------------------------------------------------------------------------{

// Resolve TP/SL as price distances (points)
rangeDistance = or_token ? orw : 0.0

string effectiveTpStyle = tpStyle
bool useDynamicSl = slRangeTickThreshold >= 0 and slStyle != "Ticks" and slStyle != "Range + buffer" and or_token and not na(orw) and orw > 0 and not na(syminfo.mintick) and syminfo.mintick > 0
int rangeTickCount = useDynamicSl ? math.round(orw / syminfo.mintick) : 0
string effectiveSlStyle = useDynamicSl and rangeTickCount > slRangeTickThreshold ? slAboveThresholdStyle : slStyle
// Derive multipliers and flags from effective styles
tpMultiplier = effectiveTpStyle == "½ range" ? 0.5 : effectiveTpStyle == "2/3 range" ? 2.0 / 3.0 : effectiveTpStyle == "1× range" ? 1.0 : effectiveTpStyle == "1.272 range" ? 0.272 : effectiveTpStyle == "1.414 range" ? 0.414 : effectiveTpStyle == "1.5× range" ? 1.5 : effectiveTpStyle == "2× range" ? 2.0 : effectiveTpStyle == "3× range" ? 3.0 : effectiveTpStyle == "4× range" ? 4.0 : effectiveTpStyle == "5× range" ? 5.0 : effectiveTpStyle == "6× range" ? 6.0 : effectiveTpStyle == "7× range" ? 7.0 : 1.0
bool tpIsTicks = effectiveTpStyle == "Ticks"
slMultiplier = effectiveSlStyle == "¼ range" ? 0.25 : effectiveSlStyle == "½ range" ? 0.5 : effectiveSlStyle == "2/3 range" ? 2.0 / 3.0 : effectiveSlStyle == "0.728 range" ? 0.728 : effectiveSlStyle == "0.862 range" ? 0.862 : effectiveSlStyle == "1.5× range" ? 1.5 : 1.0
bool slIsTicks = effectiveSlStyle == "Ticks"
bool hasSlBuffer = effectiveSlStyle == "Range + buffer"
float buyEntryRef = not na(signalBuyEntryLevel) ? signalBuyEntryLevel : close
float sellEntryRef = not na(signalSellEntryLevel) ? signalSellEntryLevel : close
bool buyAcrossRange = false
bool sellAcrossRange = false
bool buyBreakoutWickTrigger = false
bool sellBreakoutWickTrigger = false
bool buyRetestLimit = placeBuyRetestLimit
bool sellRetestLimit = placeSellRetestLimit

presetTpDist = tpIsTicks ? tpTicksOverride * syminfo.mintick : rangeDistance * tpMultiplier
presetSlDist = slIsTicks ? slTicksOverride * syminfo.mintick : rangeDistance * slMultiplier + (hasSlBuffer ? rangeDistance * 0.272 : 0)
bool tpIsOverridden = false
float tpDist = presetTpDist
float slDist = presetSlDist

// TP/SL distances anchored to range edge, not entry
// All TPs: orh + multiplier × range for buys, orl - multiplier × range for sells
bool slIsOverridden = false
// 0.862/0.728 are measured from ORL upward (SL near entry), so SL dist = (1 - mult) × range
bool slFromBottom = effectiveSlStyle == "0.862 range" or effectiveSlStyle == "0.728 range"
float slExtra = slFromBottom ? -(slMultiplier) * rangeDistance : (slMultiplier - 1) * rangeDistance + (hasSlBuffer ? rangeDistance * 0.272 : 0)
float baseRangeSlDist = rangeDistance + slExtra
float fibBuyTpDist  = tpIsOverridden ? tpDist : tpIsTicks ? presetTpDist : buyBreakoutWickTrigger ? presetTpDist : (or_token ? (orh + rangeDistance * tpMultiplier - buyEntryRef) : tpDist)
float fibSellTpDist = tpIsOverridden ? tpDist : tpIsTicks ? presetTpDist : sellBreakoutWickTrigger ? presetTpDist : (or_token ? (sellEntryRef - (orl - rangeDistance * tpMultiplier)) : tpDist)
float fibBuySlDist  = slIsOverridden ? slDist : slIsTicks ? presetSlDist : buyBreakoutWickTrigger ? baseRangeSlDist : (or_token ? (buyEntryRef - orl + slExtra) : slDist)
float fibSellSlDist = slIsOverridden ? slDist : slIsTicks ? presetSlDist : sellBreakoutWickTrigger ? baseRangeSlDist : (or_token ? (orh + slExtra - sellEntryRef) : slDist)
float buyRunner1Dist = runnerDistance(true, "2× range", 0, rangeDistance, orh, orl, buyEntryRef)
float sellRunner1Dist = runnerDistance(false, "2× range", 0, rangeDistance, orh, orl, sellEntryRef)
float buyRunner2Dist = runnerDistance(true, "3× range", 0, rangeDistance, orh, orl, buyEntryRef)
float sellRunner2Dist = runnerDistance(false, "3× range", 0, rangeDistance, orh, orl, sellEntryRef)
float buyRunner3Dist = runnerDistance(true, "3× range", 0, rangeDistance, orh, orl, buyEntryRef)
float sellRunner3Dist = runnerDistance(false, "3× range", 0, rangeDistance, orh, orl, sellEntryRef)

// Apply minimum SL floor (prevents tiny ranges from creating oversized positions)
// Deep-entry and minimum-stop overrides were removed from the 4.8.3 UI.

if not na(signalBuySlOverride)
    fibBuySlDist := signalBuySlOverride
if not na(signalSellSlOverride)
    fibSellSlDist := signalSellSlOverride

// Compute TP/SL prices based on entry (close at signal bar) and point distance
float buy_entry = buyEntryRef
float buy_tp = buyEntryRef + fibBuyTpDist
float buy_sl = buyEntryRef - fibBuySlDist
float sell_entry = sellEntryRef
float sell_tp = sellEntryRef - fibSellTpDist
float sell_sl = sellEntryRef + fibSellSlDist
string beStopField = ""
// pointValue is computed at the top of the script so it is available to lifecycle functions
float quantityFactor = quantityUnitSize()
float buyRiskPerUnit = fibBuySlDist * pointValue
float sellRiskPerUnit = fibSellSlDist * pointValue
float buyQuantity = buyRiskPerUnit > 0 ? roundSizedQuantity(riskAmountUsd / buyRiskPerUnit) : quantityStep()
float sellQuantity = sellRiskPerUnit > 0 ? roundSizedQuantity(riskAmountUsd / sellRiskPerUnit) : quantityStep()
float buyTpPercent = buy_entry != 0 ? math.abs(buy_tp - buy_entry) / math.abs(buy_entry) * 100.0 : 0.0
float buySlPercent = buy_entry != 0 ? math.abs(buy_entry - buy_sl) / math.abs(buy_entry) * 100.0 : 0.0
float sellTpPercent = sell_entry != 0 ? math.abs(sell_entry - sell_tp) / math.abs(sell_entry) * 100.0 : 0.0
float sellSlPercent = sell_entry != 0 ? math.abs(sell_sl - sell_entry) / math.abs(sell_entry) * 100.0 : 0.0
float bracketBuyAnchorEntry = orh
float bracketSellAnchorEntry = orl
float bracketBuyEntry = bracketBuyPlacementEntry
float bracketSellEntry = bracketSellPlacementEntry
float bracketBuyBaseSlDist = slIsOverridden ? slDist : slIsTicks ? presetSlDist : baseRangeSlDist
float bracketSellBaseSlDist = slIsOverridden ? slDist : slIsTicks ? presetSlDist : baseRangeSlDist
float bracketBuyBaseTpDist = tpIsOverridden ? tpDist : runnerDistance(true, tpStyle, tpTicksOverride, rangeDistance, orh, orl, bracketBuyAnchorEntry)
float bracketSellBaseTpDist = tpIsOverridden ? tpDist : runnerDistance(false, tpStyle, tpTicksOverride, rangeDistance, orh, orl, bracketSellAnchorEntry)
float bracketBuyTp = bracketBuyAnchorEntry + bracketBuyBaseTpDist
float bracketBuySl = bracketBuyAnchorEntry - bracketBuyBaseSlDist
float bracketSellTp = bracketSellAnchorEntry - bracketSellBaseTpDist
float bracketSellSl = bracketSellAnchorEntry + bracketSellBaseSlDist
float bracketBuyTpDist = bracketBuyTp - bracketBuyEntry
float bracketSellTpDist = bracketSellEntry - bracketSellTp
float bracketBuySlDist = bracketBuyEntry - bracketBuySl
float bracketSellSlDist = bracketSellSl - bracketSellEntry
float bracketBuyRiskPerUnit = bracketBuySlDist * pointValue
float bracketSellRiskPerUnit = bracketSellSlDist * pointValue
float bracketBuyQuantity = bracketBuyRiskPerUnit > 0 ? roundSizedQuantity(riskAmountUsd / bracketBuyRiskPerUnit) : quantityStep()
float bracketSellQuantity = bracketSellRiskPerUnit > 0 ? roundSizedQuantity(riskAmountUsd / bracketSellRiskPerUnit) : quantityStep()
float bracketBuyTpPercent = bracketBuyEntry != 0 ? math.abs(bracketBuyTp - bracketBuyEntry) / math.abs(bracketBuyEntry) * 100.0 : 0.0
float bracketBuySlPercent = bracketBuyEntry != 0 ? math.abs(bracketBuyEntry - bracketBuySl) / math.abs(bracketBuyEntry) * 100.0 : 0.0
float bracketSellTpPercent = bracketSellEntry != 0 ? math.abs(bracketSellEntry - bracketSellTp) / math.abs(bracketSellEntry) * 100.0 : 0.0
float bracketSellSlPercent = bracketSellEntry != 0 ? math.abs(bracketSellSl - bracketSellEntry) / math.abs(bracketSellEntry) * 100.0 : 0.0
float bracketBuyRunner1Price = bracketBuyAnchorEntry + runnerDistance(true, "2× range", 0, rangeDistance, orh, orl, bracketBuyAnchorEntry)
float bracketBuyRunner2Price = bracketBuyAnchorEntry + runnerDistance(true, "3× range", 0, rangeDistance, orh, orl, bracketBuyAnchorEntry)
float bracketBuyRunner3Price = bracketBuyAnchorEntry + runnerDistance(true, "3× range", 0, rangeDistance, orh, orl, bracketBuyAnchorEntry)
float bracketSellRunner1Price = bracketSellAnchorEntry - runnerDistance(false, "2× range", 0, rangeDistance, orh, orl, bracketSellAnchorEntry)
float bracketSellRunner2Price = bracketSellAnchorEntry - runnerDistance(false, "3× range", 0, rangeDistance, orh, orl, bracketSellAnchorEntry)
float bracketSellRunner3Price = bracketSellAnchorEntry - runnerDistance(false, "3× range", 0, rangeDistance, orh, orl, bracketSellAnchorEntry)
float bracketBuyRunner1Dist = bracketBuyRunner1Price - bracketBuyEntry
float bracketBuyRunner2Dist = bracketBuyRunner2Price - bracketBuyEntry
float bracketBuyRunner3Dist = bracketBuyRunner3Price - bracketBuyEntry
float bracketSellRunner1Dist = bracketSellEntry - bracketSellRunner1Price
float bracketSellRunner2Dist = bracketSellEntry - bracketSellRunner2Price
float bracketSellRunner3Dist = bracketSellEntry - bracketSellRunner3Price
string nextBracketId = "ultra-v4-" + syminfo.ticker + "-" + str.tostring(rangeStartTime) + "-" + str.tostring(currentRangeId)
if bracketPlacementSignal
    bracketLongEntryPrice := bracketBuyEntry
    bracketShortEntryPrice := bracketSellEntry
    bracketLongTpDistance := bracketBuyTpDist
    bracketShortTpDistance := bracketSellTpDist
    bracketLongSlDistance := bracketBuySlDist
    bracketShortSlDistance := bracketSellSlDist
    bracketLongRunner1Distance := bracketBuyRunner1Dist
    bracketShortRunner1Distance := bracketSellRunner1Dist
    bracketLongRunner2Distance := bracketBuyRunner2Dist
    bracketShortRunner2Distance := bracketSellRunner2Dist
    bracketLongRunner3Distance := bracketBuyRunner3Dist
    bracketShortRunner3Distance := bracketSellRunner3Dist
    bracketLongQuantity := bracketBuyQuantity
    bracketShortQuantity := bracketSellQuantity

// Build Ultra alert payloads
string buy_json = na
string sell_json = na
string exit_json = na
string be_exit_json = na
string eodFlattenExitJson = na
string bracketBuyJson = na
string bracketSellJson = na
string bracketBuySplitTp1Json = na
string bracketBuySplitTp2Json = na
string bracketBuySplitTp3Json = na
string bracketBuySplitTp4Json = na
string bracketSellSplitTp1Json = na
string bracketSellSplitTp2Json = na
string bracketSellSplitTp3Json = na
string bracketSellSplitTp4Json = na
string bracketBuyHalfTp1Json = na
string bracketBuyHalfRunnerJson = na
string bracketSellHalfTp1Json = na
string bracketSellHalfRunnerJson = na
string cancelLongBracketJson = na
string cancelShortBracketJson = na

bool effectiveSplit = false
bool effectiveHalfOut = false
bool buyUseLimitOrder = false
bool sellUseLimitOrder = false
bool buyUseStopOrder = true
bool sellUseStopOrder = true
bool useCloseConfirmedSl = false
string buyOrderFields = buyUseLimitOrder ? ',"orderType":"limit","limitPrice":' + str.tostring(roundAlertPrice(buy_entry), format.mintick) : buyUseStopOrder ? ',"orderType":"stop","stopPrice":' + str.tostring(roundAlertPrice(buy_entry), format.mintick) : ',"orderType":"market"'
string sellOrderFields = sellUseLimitOrder ? ',"orderType":"limit","limitPrice":' + str.tostring(roundAlertPrice(sell_entry), format.mintick) : sellUseStopOrder ? ',"orderType":"stop","stopPrice":' + str.tostring(roundAlertPrice(sell_entry), format.mintick) : ',"orderType":"market"'
string buyExitFields = ',"takeProfit":{"percent":' + str.tostring(buyTpPercent) + '},"stopLoss":{"type":"stop","percent":' + str.tostring(buySlPercent) + '}'
string sellExitFields = ',"takeProfit":{"percent":' + str.tostring(sellTpPercent) + '},"stopLoss":{"type":"stop","percent":' + str.tostring(sellSlPercent) + '}'
string strategyStopMode = "intrabar"
buy_json := '{"ticker":"' + syminfo.ticker + '","action":"buy","sentiment":"long","quantity":' + str.tostring(buyQuantity) + ',"quantityType":"fixed_quantity","price":' + str.tostring(roundAlertPrice(close), format.mintick) + ',"signalPrice":' + str.tostring(roundAlertPrice(buy_entry), format.mintick) + buyOrderFields + ',"time":"' + str.tostring(alertTimeMs()) + '","interval":"' + timeframe.period + '"' + buyExitFields + beStopField + ',"extras":{"source":"ultra-v4.8","strategyStopPrice":' + str.tostring(roundAlertPrice(buy_sl), format.mintick) + ',"strategyStopMode":"' + strategyStopMode + '","rangeName":"' + lifecycleEscape(activeRangeName) + '"}}'
sell_json := '{"ticker":"' + syminfo.ticker + '","action":"sell","sentiment":"short","quantity":' + str.tostring(sellQuantity) + ',"quantityType":"fixed_quantity","price":' + str.tostring(roundAlertPrice(close), format.mintick) + ',"signalPrice":' + str.tostring(roundAlertPrice(sell_entry), format.mintick) + sellOrderFields + ',"time":"' + str.tostring(alertTimeMs()) + '","interval":"' + timeframe.period + '"' + sellExitFields + beStopField + ',"extras":{"source":"ultra-v4.8","strategyStopPrice":' + str.tostring(roundAlertPrice(sell_sl), format.mintick) + ',"strategyStopMode":"' + strategyStopMode + '","rangeName":"' + lifecycleEscape(activeRangeName) + '"}}'
exit_json := '{"ticker":"' + syminfo.ticker + '","action":"exit","orderType":"market","price":' + str.tostring(roundAlertPrice(close), format.mintick) + ',"time":"' + str.tostring(alertTimeMs()) + '","interval":"' + timeframe.period + '","extras":{"reason":"stop_loss","source":"ultra-v4.8","rangeName":"' + lifecycleEscape(activeRangeName) + '"}}'
be_exit_json := '{"ticker":"' + syminfo.ticker + '","action":"exit","orderType":"market","price":' + str.tostring(roundAlertPrice(close), format.mintick) + ',"time":"' + str.tostring(alertTimeMs()) + '","interval":"' + timeframe.period + '","extras":{"reason":"protected_stop_hit","source":"ultra-v4.8","rangeName":"' + lifecycleEscape(activeRangeName) + '"}}'
eodFlattenExitJson := '{"ticker":"' + syminfo.ticker + '","action":"exit","orderType":"market","price":' + str.tostring(roundAlertPrice(close), format.mintick) + ',"time":"' + str.tostring(alertTimeMs()) + '","interval":"' + timeframe.period + '","extras":{"reason":"eod_flatten","source":"ultra-v4.8","rangeName":"' + lifecycleEscape(activeRangeName) + '"}}'
float bracketLongTpPercent = not na(bracketLongEntryPrice) and bracketLongEntryPrice != 0 ? math.abs(bracketLongTpDistance) / math.abs(bracketLongEntryPrice) * 100.0 : 0.0
float bracketShortTpPercent = not na(bracketShortEntryPrice) and bracketShortEntryPrice != 0 ? math.abs(bracketShortTpDistance) / math.abs(bracketShortEntryPrice) * 100.0 : 0.0
float bracketLongRunner1Percent = not na(bracketLongEntryPrice) and bracketLongEntryPrice != 0 ? math.abs(bracketLongRunner1Distance) / math.abs(bracketLongEntryPrice) * 100.0 : 0.0
float bracketShortRunner1Percent = not na(bracketShortEntryPrice) and bracketShortEntryPrice != 0 ? math.abs(bracketShortRunner1Distance) / math.abs(bracketShortEntryPrice) * 100.0 : 0.0
float bracketLongRunner2Percent = not na(bracketLongEntryPrice) and bracketLongEntryPrice != 0 ? math.abs(bracketLongRunner2Distance) / math.abs(bracketLongEntryPrice) * 100.0 : 0.0
float bracketShortRunner2Percent = not na(bracketShortEntryPrice) and bracketShortEntryPrice != 0 ? math.abs(bracketShortRunner2Distance) / math.abs(bracketShortEntryPrice) * 100.0 : 0.0
float bracketLongRunner3Percent = not na(bracketLongEntryPrice) and bracketLongEntryPrice != 0 ? math.abs(bracketLongRunner3Distance) / math.abs(bracketLongEntryPrice) * 100.0 : 0.0
float bracketShortRunner3Percent = not na(bracketShortEntryPrice) and bracketShortEntryPrice != 0 ? math.abs(bracketShortRunner3Distance) / math.abs(bracketShortEntryPrice) * 100.0 : 0.0
float bracketLongSlPercent = not na(bracketLongEntryPrice) and bracketLongEntryPrice != 0 ? math.abs(bracketLongSlDistance) / math.abs(bracketLongEntryPrice) * 100.0 : 0.0
float bracketShortSlPercent = not na(bracketShortEntryPrice) and bracketShortEntryPrice != 0 ? math.abs(bracketShortSlDistance) / math.abs(bracketShortEntryPrice) * 100.0 : 0.0
string bracketBuyTp1ExitFields = tradersPostRangeBracketExitFields(true, bracketLongEntryPrice, bracketLongTpDistance, bracketLongSlDistance, bracketLongTpPercent, bracketLongSlPercent)
string bracketSellTp1ExitFields = tradersPostRangeBracketExitFields(false, bracketShortEntryPrice, bracketShortTpDistance, bracketShortSlDistance, bracketShortTpPercent, bracketShortSlPercent)
string bracketBuyRunner1ExitFields = tradersPostRangeBracketExitFields(true, bracketLongEntryPrice, bracketLongRunner1Distance, bracketLongSlDistance, bracketLongRunner1Percent, bracketLongSlPercent)
string bracketSellRunner1ExitFields = tradersPostRangeBracketExitFields(false, bracketShortEntryPrice, bracketShortRunner1Distance, bracketShortSlDistance, bracketShortRunner1Percent, bracketShortSlPercent)
string bracketBuyRunner2ExitFields = tradersPostRangeBracketExitFields(true, bracketLongEntryPrice, bracketLongRunner2Distance, bracketLongSlDistance, bracketLongRunner2Percent, bracketLongSlPercent)
string bracketSellRunner2ExitFields = tradersPostRangeBracketExitFields(false, bracketShortEntryPrice, bracketShortRunner2Distance, bracketShortSlDistance, bracketShortRunner2Percent, bracketShortSlPercent)
string bracketBuyRunner3ExitFields = tradersPostRangeBracketExitFields(true, bracketLongEntryPrice, bracketLongRunner3Distance, bracketLongSlDistance, bracketLongRunner3Percent, bracketLongSlPercent)
string bracketSellRunner3ExitFields = tradersPostRangeBracketExitFields(false, bracketShortEntryPrice, bracketShortRunner3Distance, bracketShortSlDistance, bracketShortRunner3Percent, bracketShortSlPercent)
float bracketBuySplitTp1Quantity = allocateBracketQuantity(bracketLongQuantity, 4, 0, quantityFactor)
float bracketBuySplitTp2Quantity = allocateBracketQuantity(bracketLongQuantity, 4, 1, quantityFactor)
float bracketBuySplitTp3Quantity = allocateBracketQuantity(bracketLongQuantity, 4, 2, quantityFactor)
float bracketBuySplitTp4Quantity = allocateBracketQuantity(bracketLongQuantity, 4, 3, quantityFactor)
float bracketSellSplitTp1Quantity = allocateBracketQuantity(bracketShortQuantity, 4, 0, quantityFactor)
float bracketSellSplitTp2Quantity = allocateBracketQuantity(bracketShortQuantity, 4, 1, quantityFactor)
float bracketSellSplitTp3Quantity = allocateBracketQuantity(bracketShortQuantity, 4, 2, quantityFactor)
float bracketSellSplitTp4Quantity = allocateBracketQuantity(bracketShortQuantity, 4, 3, quantityFactor)
float bracketBuyHalfTp1Quantity = allocateBracketQuantity(bracketLongQuantity, 2, 0, quantityFactor)
float bracketBuyHalfRunnerQuantity = allocateBracketQuantity(bracketLongQuantity, 2, 1, quantityFactor)
float bracketSellHalfTp1Quantity = allocateBracketQuantity(bracketShortQuantity, 2, 0, quantityFactor)
float bracketSellHalfRunnerQuantity = allocateBracketQuantity(bracketShortQuantity, 2, 1, quantityFactor)
bracketBuyJson := rangeBracketAlertJson("buy", "long", bracketLongQuantity, bracketLongEntryPrice, bracketLongEntryPrice - bracketLongSlDistance, bracketLongArmId, "long", bracketBuyTp1ExitFields, beStopField, "single")
bracketSellJson := rangeBracketAlertJson("sell", "short", bracketShortQuantity, bracketShortEntryPrice, bracketShortEntryPrice + bracketShortSlDistance, bracketShortArmId, "short", bracketSellTp1ExitFields, beStopField, "single")
bracketBuySplitTp1Json := rangeBracketAlertJson("buy", "long", bracketBuySplitTp1Quantity, bracketLongEntryPrice, bracketLongEntryPrice - bracketLongSlDistance, bracketLongArmId, "long", bracketBuyTp1ExitFields, beStopField, "tp1")
bracketBuySplitTp2Json := rangeBracketAlertJson("buy", "long", bracketBuySplitTp2Quantity, bracketLongEntryPrice, bracketLongEntryPrice - bracketLongSlDistance, bracketLongArmId, "long", bracketBuyRunner1ExitFields, beStopField, "runner1")
bracketBuySplitTp3Json := rangeBracketAlertJson("buy", "long", bracketBuySplitTp3Quantity, bracketLongEntryPrice, bracketLongEntryPrice - bracketLongSlDistance, bracketLongArmId, "long", bracketBuyRunner2ExitFields, beStopField, "runner2")
bracketBuySplitTp4Json := rangeBracketAlertJson("buy", "long", bracketBuySplitTp4Quantity, bracketLongEntryPrice, bracketLongEntryPrice - bracketLongSlDistance, bracketLongArmId, "long", bracketBuyRunner3ExitFields, beStopField, "runner3")
bracketSellSplitTp1Json := rangeBracketAlertJson("sell", "short", bracketSellSplitTp1Quantity, bracketShortEntryPrice, bracketShortEntryPrice + bracketShortSlDistance, bracketShortArmId, "short", bracketSellTp1ExitFields, beStopField, "tp1")
bracketSellSplitTp2Json := rangeBracketAlertJson("sell", "short", bracketSellSplitTp2Quantity, bracketShortEntryPrice, bracketShortEntryPrice + bracketShortSlDistance, bracketShortArmId, "short", bracketSellRunner1ExitFields, beStopField, "runner1")
bracketSellSplitTp3Json := rangeBracketAlertJson("sell", "short", bracketSellSplitTp3Quantity, bracketShortEntryPrice, bracketShortEntryPrice + bracketShortSlDistance, bracketShortArmId, "short", bracketSellRunner2ExitFields, beStopField, "runner2")
bracketSellSplitTp4Json := rangeBracketAlertJson("sell", "short", bracketSellSplitTp4Quantity, bracketShortEntryPrice, bracketShortEntryPrice + bracketShortSlDistance, bracketShortArmId, "short", bracketSellRunner3ExitFields, beStopField, "runner3")
bracketBuyHalfTp1Json := rangeBracketAlertJson("buy", "long", bracketBuyHalfTp1Quantity, bracketLongEntryPrice, bracketLongEntryPrice - bracketLongSlDistance, bracketLongArmId, "long", bracketBuyTp1ExitFields, beStopField, "tp1")
bracketBuyHalfRunnerJson := rangeBracketAlertJson("buy", "long", bracketBuyHalfRunnerQuantity, bracketLongEntryPrice, bracketLongEntryPrice - bracketLongSlDistance, bracketLongArmId, "long", bracketBuyRunner1ExitFields, beStopField, "runner1")
bracketSellHalfTp1Json := rangeBracketAlertJson("sell", "short", bracketSellHalfTp1Quantity, bracketShortEntryPrice, bracketShortEntryPrice + bracketShortSlDistance, bracketShortArmId, "short", bracketSellTp1ExitFields, beStopField, "tp1")
bracketSellHalfRunnerJson := rangeBracketAlertJson("sell", "short", bracketSellHalfRunnerQuantity, bracketShortEntryPrice, bracketShortEntryPrice + bracketShortSlDistance, bracketShortArmId, "short", bracketSellRunner1ExitFields, beStopField, "runner1")
// Set active position TP when signals fire (blocks re-entry until TP hit)
// Track signal for win/loss outcome detection
if placeBuyRetestLimit
    pendingRetestActive := true
    pendingRetestSide := 1
    pendingRetestPlacedBar := bar_index
    pendingRetestEntry := buy_entry
    pendingRetestTpDist := fibBuyTpDist
    pendingRetestSlDist := fibBuySlDist
    pendingRetestRunner1Dist := buyRunner1Dist
    pendingRetestRunner2Dist := buyRunner2Dist
    pendingRetestRunner3Dist := buyRunner3Dist
    pendingRetestBeTriggerDist := beTriggerDistance
    pendingRetestBeOffsetDist := beOffsetDistance
    pendingRetestBeRequireClose := beTriggerConfirmation == "Candle Close Beyond Trigger"
    pendingRetestRangeId := currentRangeId
    pendingRetestIsSplit := effectiveSplit
    pendingRetestIsHalfOut := effectiveHalfOut
if placeSellRetestLimit
    pendingRetestActive := true
    pendingRetestSide := -1
    pendingRetestPlacedBar := bar_index
    pendingRetestEntry := sell_entry
    pendingRetestTpDist := fibSellTpDist
    pendingRetestSlDist := fibSellSlDist
    pendingRetestRunner1Dist := sellRunner1Dist
    pendingRetestRunner2Dist := sellRunner2Dist
    pendingRetestRunner3Dist := sellRunner3Dist
    pendingRetestBeTriggerDist := beTriggerDistance
    pendingRetestBeOffsetDist := beOffsetDistance
    pendingRetestBeRequireClose := beTriggerConfirmation == "Candle Close Beyond Trigger"
    pendingRetestRangeId := currentRangeId
    pendingRetestIsSplit := effectiveSplit
    pendingRetestIsHalfOut := effectiveHalfOut

if fillBuyRetestLimit
    activeBuyTp := pendingRetestEntry + pendingRetestTpDist
    string lifecycleTradeId = lifecycleMarketTradeId(rangeStartTime, pendingRetestRangeId, bar_index, 1, pendingRetestEntry)
    array.push(tradeEntries, pendingRetestEntry)
    array.push(tradeEntryBars, bar_index)
    array.push(tradeSides, 1)
    array.push(tradeTpDists, pendingRetestTpDist)
    array.push(tradeSlDists, pendingRetestSlDist)
    array.push(tradeSlRequireCloseConfirm, useCloseConfirmedSl)
    array.push(tradeBeTriggerDists, pendingRetestBeTriggerDist)
    array.push(tradeBeOffsetDists, pendingRetestBeOffsetDist)
    array.push(tradeBeRequireCloseConfirm, pendingRetestBeRequireClose)
    array.push(tradeUsesMarketBe, true)
    array.push(tradeRangeIds, pendingRetestRangeId)
    array.push(tradeRangeResultIdxs, currentRangeResultIdx)
    array.push(tradeBracketIds, "")
    array.push(tradeLifecycleIds, lifecycleTradeId)
    array.push(tradeQuantities, buyQuantity)
    array.push(tradeIsSplit, pendingRetestIsSplit)
    array.push(tradeIsHalfOut, pendingRetestIsHalfOut)
    array.push(tradeSplitTp1Dist, pendingRetestIsSplit ? pendingRetestTpDist : na)
    array.push(tradeSplitTp2Dist, pendingRetestIsSplit ? pendingRetestRunner1Dist : na)
    array.push(tradeSplitTp3Dist, pendingRetestIsSplit ? pendingRetestRunner2Dist : na)
    array.push(tradeSplitTp4Dist, pendingRetestIsSplit ? pendingRetestRunner3Dist : na)
    array.push(tradeSplitTp1Hit, false)
    array.push(tradeSplitTp2Hit, false)
    array.push(tradeSplitTp3Hit, false)
    array.push(tradeSplitTp4Hit, false)
    array.push(tradeSplitNewSlDist, pendingRetestIsSplit ? 0.0 : na)
    array.push(tradeHalfTp1Dist, pendingRetestIsHalfOut ? pendingRetestTpDist : na)
    array.push(tradeHalfTp2Dist, pendingRetestIsHalfOut ? pendingRetestRunner1Dist : na)
    array.push(tradeHalfTp1Hit, false)
    array.push(tradeHalfTp2Hit, false)
    array.push(tradeHalfNewSlDist, pendingRetestIsHalfOut ? 0.0 : na)
    array.push(tradeBeTriggered, false)
    if sendLifecycleAlerts and buyQuantity > 0
        fireAlert(lifecycleEntryJson("entry_filled", lifecycleTradeId, 1, buyQuantity, pendingRetestEntry, "buy"))
    pendingRetestEntry := na
    pendingRetestTpDist := na
    pendingRetestSlDist := na
    pendingRetestRunner1Dist := na
    pendingRetestRunner2Dist := na
    pendingRetestRunner3Dist := na
    pendingRetestBeTriggerDist := na
    pendingRetestBeOffsetDist := na
    pendingRetestBeRequireClose := false
    pendingRetestRangeId := 0
    pendingRetestIsSplit := false
    pendingRetestIsHalfOut := false
if fillSellRetestLimit
    activeSellTp := pendingRetestEntry - pendingRetestTpDist
    string lifecycleTradeId = lifecycleMarketTradeId(rangeStartTime, pendingRetestRangeId, bar_index, -1, pendingRetestEntry)
    array.push(tradeEntries, pendingRetestEntry)
    array.push(tradeEntryBars, bar_index)
    array.push(tradeSides, -1)
    array.push(tradeTpDists, pendingRetestTpDist)
    array.push(tradeSlDists, pendingRetestSlDist)
    array.push(tradeSlRequireCloseConfirm, useCloseConfirmedSl)
    array.push(tradeBeTriggerDists, pendingRetestBeTriggerDist)
    array.push(tradeBeOffsetDists, pendingRetestBeOffsetDist)
    array.push(tradeBeRequireCloseConfirm, pendingRetestBeRequireClose)
    array.push(tradeUsesMarketBe, true)
    array.push(tradeRangeIds, pendingRetestRangeId)
    array.push(tradeRangeResultIdxs, currentRangeResultIdx)
    array.push(tradeBracketIds, "")
    array.push(tradeLifecycleIds, lifecycleTradeId)
