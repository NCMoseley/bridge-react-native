//─── Alert Configuration ───────────────────────────────────────────────────────
// Controls that affect when and how alerts fire
tradingSession = str.length(tradingSessionOverride) > 0 ? tradingSessionOverride : presetTradingSession
flattenAtEod = input.bool(true, title = "Flatten At EOD", group = "Alert Configuration", tooltip = "Sends a market exit for any open position at the configured EOD time, or 17:00 if none is configured. Still allows active ranges that are forming through EOD to fire entries after EOD.")
alertBurstCount = input.int(2, title = "Alert Burst Count", minval = 1, group = "Alert Configuration", tooltip = "Number of alert() calls to allow in quick succession when a signal first forms. After this burst, the cooldown applies.")
alertCooldownBars = input.int(2, title = "Alert Cooldown (bars)", minval = 0, group = "Alert Configuration", tooltip = "Minimum bars to wait after the last same-side alert before a new alert can fire. Set to 0 to disable the cooldown.")
eodFlattenTime = str.length(eodFlattenTimeOverride) > 0 ? eodFlattenTimeOverride : (str.length(presetEodFlattenTime) > 0 ? presetEodFlattenTime : "17:00")
riskAmountUsd = riskAmountUsdOverride >= 0 ? riskAmountUsdOverride : presetRiskAmountUsd
// TradersPost TP/SL fields are always included so every order payload carries the current exits.
bool sendTradersPostExits = true
bool useBeStop = input.bool(false, title = "Use Break-Even Stop", group = "Break-Even Stop", tooltip = "When enabled, moves the stop-loss to the entry price (plus any offset) once the price reaches the trigger distance in the trade's favor.")
string beTriggerStyle = "Ticks"
int beTriggerTicks = input.int(20, title = "BE Trigger (ticks)", minval = 0, group = "Break-Even Stop", tooltip = "Number of ticks the trade must move in the favorable direction before the BE stop is applied.")
string beOffsetStyle = "Ticks"
int beOffsetTicks = input.int(0, title = "BE Offset (ticks)", minval = -100, group = "Break-Even Stop", tooltip = "Number of ticks to offset the BE stop from the entry. 0 = move to exact entry. Positive values lock in profit; negative values place it below/above entry.")
string beTriggerConfirmation = "Intrabar"
bool sendBeStopExitAlerts = true

// Lifecycle reporting is always on so bracket and trade lifecycle events are always emitted.
bool sendLifecycleAlerts = true

//─── Range Bracket Orders ──────────────────────────────────────────────────────
bool bracketOrdersForcedOn = true
bracketEntryOffsetTicks = input.int(1, title = "Entry Offset (ticks)", step = 1, group = "Range Bracket Orders", tooltip = "Signed offset from each range edge. Positive values move entries outside the range beyond ORH/ORL. Negative values move entries inside the range for earlier fills. Ultra sends a stop order when the entry is beyond the current price, otherwise a limit order.")
maxBracketEntriesPerRange = maxBracketEntriesOverride >= 0 ? maxBracketEntriesOverride : presetEntriesPerRange
oneFillPerSidePerRange = input.bool(false, title = "One Fill Per Side Per Range", group = "Range Bracket Orders", tooltip = "When enabled, each range can fill at most one long bracket and one short bracket. Same-side re-arms are blocked once that side has already filled.")
rearmSameSideStopAfterSl = input.bool(true, title = "Rearm Same-Side Stop After SL", group = "Range Bracket Orders", tooltip = "After a bracket trade reaches its stop-loss, sends a new pending stop-order alert at the same range edge with the current TP and SL settings.")
rearmSameSideStopAfterTp = input.bool(false, title = "Rearm Same-Side Stop After TP", group = "Range Bracket Orders", tooltip = "After a bracket trade reaches its final take-profit, waits for price to return through that range edge, then sends a new same-side pending stop-order alert. This avoids immediately re-entering while price remains beyond the edge.")

// The previous range's unfilled bracket is retained while the next range is forming, then canceled at or_end.

//─── Strategy Settings ─────────────────────────────────────────────────────────
tpStyle = tpStyleOverride != "Preset" ? tpStyleOverride : presetTpStyle
tpTicksOverride = tpTicksOverrideInput >= 0 ? tpTicksOverrideInput : presetTpTicksOverride
slStyle = slStyleOverride != "Preset" ? slStyleOverride : presetSlStyle
slTicksOverride = slTicksOverrideInput >= 0 ? slTicksOverrideInput : presetSlTicksOverride
crSesh = str.length(rangeSessionOverride) > 0 ? rangeSessionOverride : activeRangeSession
bool presetHasRangeSession = str.length(activeRangeSession) == 9 and activeRangeSession != "0000-0000"
activeRangeEnabled := str.length(crSesh) == 9 and crSesh != "0000-0000"
bool enablePineAlertLogs = true

//─── Display ───────────────────────────────────────────────────────────────────
// Visual and cosmetic controls
showHist = input.bool(false, title = "Show Historical Data", group = "Display", tooltip = "Displays All Data from Previous Sessions")
showPresetInfo = input.bool(true, title = "Show Settings Info", group = "Display", tooltip = "Displays a panel on the chart showing the active configuration.")
showPerformanceSummary = input.bool(false, title = "Show Performance Summary", group = "Display", tooltip = "Displays an independent top-left table with risk-based performance, sizing, and drawdown.")
useLightTableTheme = input.bool(false, title = "Use Light Table Theme", group = "Display", tooltip = "Uses a light blue and gray palette for the settings table. Disable for the dark blue and gray palette.")
sigTog = input.bool(true, title = "Show Signals", group = "Display")
bool showBeStopLevels = false
showTradeLevels = input.bool(false, title = "Show TP/SL Levels", group = "Display", tooltip = "Draws the active trade's take-profit and stop-loss prices on the chart.")
showTargetPrices = input.bool(false, title = "Show Target Prices", group = "Display", tooltip = "Adds the price value to each target label.")
showRangeEdgePrices = input.bool(false, title = "Show Range Edge Prices", group = "Display", tooltip = "Adds the ORH and ORL price values to the range-edge labels.")
sigSize = "huge"
upSigColor = color.black
downSigColor = color.black
tTog = true
showTicksLabel = false
float tPer = 1.0
string tDispType = "Adaptive"

//─── Style ─────────────────────────────────────────────────────────────────────
color green = color.new(#089981,60)
color red = color.new(#f23645,60)
color greenFill = color.new(#089981,80)
color redFill = color.new(#f23645,80)
color orColor = #787b86
color orFillColor = color.new(color.gray,90)
string tStyle = "___"
string txtSize = "small"

invis = color.rgb(0,0,0,100)

tradingCalendarAllowsEntries() =>
    true

currentHour = hour(time, tz)
currentMinute = minute(time, tz)
// Convert current time to minutes-since-midnight for EOD comparisons.
int currentTimeMin = currentHour * 60 + currentMinute
int eodHour = str.length(eodFlattenTime) >= 5 ? int(str.tonumber(str.substring(eodFlattenTime, 0, 2))) : -1
int eodMinute = str.length(eodFlattenTime) >= 5 ? int(str.tonumber(str.substring(eodFlattenTime, 3, 5))) : -1
bool hasValidEodFlattenTime = eodHour >= 0 and eodHour <= 23 and eodMinute >= 0 and eodMinute <= 59
int eodFlattenTimeMin = eodHour * 60 + eodMinute
int currentDateKey = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)
varip int eodFlattenDateKey = na
varip int eodFlattenAlertBar = na
bool eodFlattenNow = flattenAtEod and hasValidEodFlattenTime and currentTimeMin >= eodFlattenTimeMin and (na(eodFlattenDateKey) or eodFlattenDateKey != currentDateKey)
if eodFlattenNow
    eodFlattenDateKey := currentDateKey
    eodFlattenAlertBar := bar_index
bool eodFlattenActiveBar = hasValidEodFlattenTime and not na(eodFlattenAlertBar) and eodFlattenAlertBar == bar_index
bool inTradingSession = str.length(tradingSession) == 0 or not na(time(timeframe.period, tradingSession, tz))
bool hideRangePaint = str.length(tradingSession) > 0 and not inTradingSession
//---------------------------------------------------------------------------------------------------------------------}
//Error
//---------------------------------------------------------------------------------------------------------------------{
if timeframe.in_seconds(timeframe.period) >= timeframe.in_seconds("D")
    runtime.error("Timeframe is too High! Please Reduce Timeframe to be Less-Than 1 Day.")

//---------------------------------------------------------------------------------------------------------------------}
//Functions
//---------------------------------------------------------------------------------------------------------------------{
fz(_val) => _val == 0 ? 1 : _val

dash() => (bar_index/2 - math.floor(bar_index/2)) > 0

linestyle(_input) =>
    _input == "___"?line.style_solid:
     _input == "- - -"?line.style_dashed:
     _input == ". . ."?line.style_dotted:
     na

get_1up(_val) => (_val - math.floor(_val)) > 0 ? int(math.floor(_val) + 1) : int(_val)

formatRangeR(float _r) => (_r >= 0 ? "+" : "") + str.tostring(_r, "#.##") + "R"

rangeRColor(float _r) => _r > 0 ? #089981 : _r < 0 ? #f23645 : color.white

formatPriceValue(float _price) => str.tostring(_price, format.mintick)

formatTargetLabel(string _label, float _price, bool _showPrice) => _showPrice ? _label + "\n" + formatPriceValue(_price) : _label

formatGuideLabel(string _label, float _price) => _label + "\n" + formatPriceValue(_price)

int rangeLabelOffsetBars = 2
int guideLabelOffsetBars = 6

targetStyleMultiplier(string _style) =>
    _style == "½ range" ? 0.5 :
     _style == "2/3 range" ? 2.0 / 3.0 :
     _style == "1× range" ? 1.0 :
     _style == "1.272 range" ? 0.272 :
     _style == "1.414 range" ? 0.414 :
     _style == "1.5× range" ? 1.5 :
     _style == "2× range" ? 2.0 :
     _style == "2.8× range" ? 2.8 :
     _style == "3× range" ? 3.0 :
     _style == "4× range" ? 4.0 :
     _style == "5× range" ? 5.0 :
     _style == "6× range" ? 6.0 :
     _style == "7× range" ? 7.0 :
     1.0

stopStyleMultiplier(string _style) =>
    _style == "¼ range" ? 0.25 :
     _style == "½ range" ? 0.5 :
     _style == "2/3 range" ? 2.0 / 3.0 :
     _style == "0.728 range" ? 0.728 :
     _style == "0.862 range" ? 0.862 :
     _style == "1.5× range" ? 1.5 :
     1.0

stopStyleDistance(string _style, int _ticks, float _rangeDistance) =>
    _style == "Ticks" ? _ticks * syminfo.mintick :
     _rangeDistance * stopStyleMultiplier(_style) + (_style == "Range + buffer" ? _rangeDistance * 0.272 : 0.0)

runnerDistance(bool _isBuy, string _style, int _ticks, float _rangeDistance, float _rangeHigh, float _rangeLow, float _entryPrice) =>
    _style == "Ticks" ? _ticks * syminfo.mintick :
     _isBuy ? (_rangeHigh + _rangeDistance * targetStyleMultiplier(_style) - _entryPrice) :
      (_entryPrice - (_rangeLow - _rangeDistance * targetStyleMultiplier(_style)))

isMiniProxyRoot() =>
    syminfo.root == "NQ" or syminfo.root == "ES" or syminfo.root == "YM" or syminfo.root == "GC" or syminfo.root == "BT"

quantityStep() =>
    syminfo.type == "futures" ? (isMiniProxyRoot() ? 0.1 : 1.0) : 0.01

quantityUnitSize() =>
    1.0 / quantityStep()

roundSizedQuantity(float _quantity) =>
    float _step = quantityStep()
    float _unitSize = quantityUnitSize()
    float _rounded = math.round(_quantity * _unitSize) / _unitSize
    math.max(_step, _rounded)

allocateBracketQuantity(float _quantity, int _parts, int _partIndex, float _unitSize) =>
    int totalUnits = int(math.round(_quantity * _unitSize))
    int baseUnits = int(math.floor(totalUnits / _parts))
    int remainderUnits = totalUnits - baseUnits * _parts
    float allocatedUnits = baseUnits + (_partIndex < remainderUnits ? 1 : 0)
    allocatedUnits / _unitSize

alertPriceIncrement() =>
    syminfo.type == "futures" and (syminfo.root == "MGC" or syminfo.root == "GC") ? 0.1 : 0.25

roundAlertPrice(float _price) =>
    math.round(_price / alertPriceIncrement()) * alertPriceIncrement()

lifecycleEscape(string _value) =>
    string _escaped = str.replace_all(_value, "\\", "\\\\")
    _escaped := str.replace_all(_escaped, "\"", "\\\"")
    str.replace_all(_escaped, "\n", "\\n")
    // NOTE: \\r is not a recognized escape in Pine and "\\r" would be interpreted as the literal letter r,
    // which corrupted every r in tradeId/eventId strings into a carriage return. We do not escape CRs here
    // because Pine strings built from code do not contain literal CRs.

alertTimeMs() =>
    na(time_close) ? time : time_close

rangeBracketAlertJson(string _action, string _sentiment, float _quantity, float _entry, float _strategyStopPrice, string _id, string _side, string _exitFields, string _beStopFields, string _leg) =>
    float _roundedEntry = roundAlertPrice(_entry)
    float _roundedStrategyStop = roundAlertPrice(_strategyStopPrice)
    bool _isStop = _action == "buy" ? _roundedEntry > close : _roundedEntry < close
    string _orderFields = _isStop ? ',"orderType":"stop","stopPrice":' + str.tostring(_roundedEntry, format.mintick) : ',"orderType":"limit","limitPrice":' + str.tostring(_roundedEntry, format.mintick)
    string _strategyStopMode = "intrabar"
    '{"ticker":"' + syminfo.ticker + '","action":"' + _action + '","sentiment":"' + _sentiment + '","quantity":' + str.tostring(_quantity) + ',"quantityType":"fixed_quantity","price":' + str.tostring(_roundedEntry, format.mintick) + ',"signalPrice":' + str.tostring(_roundedEntry, format.mintick) + _orderFields + ',"bracketId":"' + _id + '","bracketSide":"' + _side + '","time":"' + str.tostring(alertTimeMs()) + '","interval":"' + timeframe.period + '"' + _exitFields + _beStopFields + ',"extras":{"source":"ultra-v4.8","strategyStopPrice":' + str.tostring(_roundedStrategyStop, format.mintick) + ',"strategyStopMode":"' + _strategyStopMode + '","orderRole":"range_bracket","orderLeg":"' + _leg + '","rangeName":"' + lifecycleEscape(activeRangeName) + '"}}'

tradersPostRangeBracketExitFields(bool _isBuy, float _entry, float _tpDistance, float _slDistance, float _tpPercent, float _slPercent) =>
    string _takeProfit = ',"takeProfit":{"percent":' + str.tostring(_tpPercent) + '}'
    string _stopLoss = ',"stopLoss":{"type":"stop","percent":' + str.tostring(_slPercent) + '}'
    _takeProfit + _stopLoss


lifecycleSide(int _side) =>
    _side == 1 ? "long" : "short"

lifecycleNumber(float _value) =>
    float _rounded = math.round(_value * 100.0) / 100.0
    str.tostring(_rounded == 0 ? 0.0 : _rounded, "#.##")

lifecycleQuantity(float _quantity) =>
    str.tostring(_quantity, "#.######")

lifecycleTime() =>
    // Always use the bar close time for lifecycle timestamps.
    // Using timenow in realtime made every trade_closed payload different on each tick,
    // bypassing the per-bar alertFiredThisBar dedupe and causing duplicate/crashing alerts.
    int _barTime = na(time_close) ? time : time_close
    str.format_time(_barTime, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")

lifecycleMarketTradeId(int _rangeStartTime, int _rangeId, int _entryBar, int _side, float _entryPrice) =>
    "ultra-v4.8-" + syminfo.ticker + "-range-" + str.tostring(_rangeStartTime) + "-" + str.tostring(_rangeId) + "-bar-" + str.tostring(_entryBar) + "-" + lifecycleSide(_side) + "-" + str.tostring(_entryPrice, format.mintick)

lifecycleBracketTradeId(string _bracketId, int _side, int _armIndex) =>
    _bracketId + "-lifecycle-" + lifecycleSide(_side) + "-" + str.tostring(_armIndex)

lifecycleEventId(string _tradeId, string _eventType, int _leg) =>
    _tradeId + "-" + _eventType + "-leg-" + str.tostring(_leg)

lifecycleEventJson(string _eventType, string _eventId, string _tradeId, int _side, string _action, float _quantity, float _entryPrice, float _exitPrice, float _realizedTicks, float _realizedDollars, string _outcome, bool _isClosed, string _exitReason) =>
    string _entryField = na(_entryPrice) ? "" : ',"entryPrice":' + str.tostring(_entryPrice, format.mintick)
    string _exitField = na(_exitPrice) ? "" : ',"exitPrice":' + str.tostring(_exitPrice, format.mintick)
    string _closeFields = _isClosed ? ',"closedAt":"' + lifecycleTime() + '","realizedTicks":' + lifecycleNumber(_realizedTicks) + ',"realizedDollars":' + lifecycleNumber(_realizedDollars) + ',"outcome":"' + _outcome + '"' : ""
    string _exitReasonField = _isClosed ? ',"exitReason":"' + _exitReason + '"' : ""
    '{"eventType":"' + _eventType + '","eventId":"' + lifecycleEscape(_eventId) + '","tradeId":"' + lifecycleEscape(_tradeId) + '","ticker":"' + lifecycleEscape(syminfo.ticker) + '","side":"' + lifecycleSide(_side) + '","action":"' + _action + '","quantity":' + lifecycleQuantity(_quantity) + _entryField + _exitField + _closeFields + ',"extras":{"source":"ultra-v4.8","rangeName":"' + lifecycleEscape(activeRangeName) + '"' + _exitReasonField + '}}'

lifecycleEntryJson(string _eventType, string _tradeId, int _side, float _quantity, float _entryPrice, string _action) =>
    lifecycleEventJson(_eventType, lifecycleEventId(_tradeId, _eventType, 0), _tradeId, _side, _action, _quantity, _entryPrice, na, na, na, "", false, "")

lifecycleTradeClosedJson(string _tradeId, int _side, int _leg, float _quantity, float _entryPrice, float _exitPrice, string _exitReason) =>
    float _signedMove = (_exitPrice - _entryPrice) * (_side == 1 ? 1.0 : -1.0)
    float _realizedTicks = _signedMove / syminfo.mintick
    float _realizedDollars = _signedMove * pointValue * _quantity
    string _outcome = _realizedTicks > 0 ? "win" : _realizedTicks < 0 ? "loss" : "breakeven"
    lifecycleEventJson("trade_closed", lifecycleEventId(_tradeId, "trade_closed", _leg), _tradeId, _side, "exit", _quantity, _entryPrice, _exitPrice, _realizedTicks, _realizedDollars, _outcome, true, _exitReason)

lifecycleLegQuantity(float _quantity, int _parts, int _leg) =>
    allocateBracketQuantity(_quantity, _parts, _leg, quantityUnitSize())

//---------------------------------------------------------------------------------------------------------------------}
//UDTs
//---------------------------------------------------------------------------------------------------------------------{

type target
    line ln
    label lab

pushPriceGuide(array<target> _guides, int _startBar, float _price, color _guideColor, string _guideText) =>
    array.push(_guides, target.new(
      line.new(_startBar, _price, bar_index + guideLabelOffsetBars, _price, color = _guideColor, style = line.style_dashed),
      label.new(bar_index + guideLabelOffsetBars, _price, text = _guideText, tooltip = formatPriceValue(_price), style = label.style_label_left, color = invis, textcolor = _guideColor, size = txtSize)
      ))

