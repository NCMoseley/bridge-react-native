                range_height_label := label.new(bar_index + 20, orh, text = str.tostring(range_ticks) + " ticks", style = label.style_label_lower_right, color = color.blue, textcolor = color.white, size = txtSize)
            else
                range_height_label.set_xy(bar_index, orh)
                range_height_label.set_text(str.tostring(range_ticks) + " ticks")
        
//On End of OR Session
if or_end and or_token
    rangeSessionDayOfMonth := dayofmonth(time, tz)
    h_ln := target.new(line.new(bar_index,orh,bar_index,orh, color = orColor),label.new(bar_index + rangeLabelOffsetBars,orh,text = formatTargetLabel("ORH", orh, showRangeEdgePrices),tooltip = str.tostring(orh,format.mintick), style = label.style_label_left, color = invis, textcolor = color.new(orColor,0), size = txtSize))
    l_ln := target.new(line.new(bar_index,orl,bar_index,orl, color = orColor),label.new(bar_index + rangeLabelOffsetBars,orl,text = formatTargetLabel("ORL", orl, showRangeEdgePrices),tooltip = str.tostring(orl,format.mintick), style = label.style_label_left, color = invis, textcolor = color.new(orColor,0), size = txtSize))
    m_ln := line.new(bar_index,orm,bar_index,orm, style = line.style_dashed, color = orColor)
    hst := orh + (orw*tPer)
    lst := orl - (orw*tPer)

    range_ticks = math.round((orh - orl) / syminfo.mintick)
    if showTicksLabel
        range_height_label := label.new(bar_index + 20, orh, text = str.tostring(range_ticks) + " ticks", style = label.style_label_lower_right, color = color.blue, textcolor = color.white, size = txtSize)
    day_dir := orm > prev_orm ? 1 : orm < prev_orm ? -1 : 0
    rangeFill := linefill.new(h_ln.ln, l_ln.ln, hideRangePaint ? color.new(orFillColor, 100) : orFillColor)
    // The new range is now fully formed. The previous range's bracket stays active
    // until the predefined or fallback EOD cancels it.

    // Move the current range's result label to the right edge of the completed range
    int completedRangeIdx = currentRangeResultIdx
    if completedRangeIdx >= 0
        label completedRangeLabel = array.get(rangeResultLabels, completedRangeIdx)
        if not na(completedRangeLabel)
            completedRangeLabel.set_xy(or_bx.get_right(), orm)
            completedRangeLabel.set_style(label.style_label_left)

//Running outside of OR Session
if not or_sesh and or_token
    h_ln.ln.set_x2(bar_index)
    l_ln.ln.set_x2(bar_index)
    h_ln.lab.set_x(bar_index + rangeLabelOffsetBars)
    h_ln.lab.set_text(formatTargetLabel("ORH", orh, showRangeEdgePrices))
    l_ln.lab.set_x(bar_index + rangeLabelOffsetBars)
    l_ln.lab.set_text(formatTargetLabel("ORL", orl, showRangeEdgePrices))
    m_ln.set_x2(bar_index)
    if not na(rangeFill)
        rangeFill.set_color(hideRangePaint ? color.new(orFillColor, 100) : rangeR > 0 ? rangeWinColor : rangeR < 0 ? rangeLossColor : orFillColor)
    
    // Update range height label position and outcome status
    if showTicksLabel and not na(range_height_label)
        range_height_label.set_x(bar_index)
        string outcomeStr = (rangeWins > 0 or rangeLosses > 0) ? " " + str.tostring(rangeWins) + "W/" + str.tostring(rangeLosses) + "L" : ""
        range_ticks_running = math.round((orh - orl) / syminfo.mintick)
        range_height_label.set_text(str.tostring(range_ticks_running) + " ticks" + outcomeStr)

//Target Calculations
if high > hst
    hst := high
if low < lst
    lst := low

up_max = get_1up((hst - orh)/(orw*tPer))
down_max = get_1up((orl - lst)/(orw*tPer))

up_cur = math.max(0,get_1up((high - orh)/(orw*tPer)))
down_cur = math.max(0,get_1up((orl - low)/(orw*tPer)))

// Signal calcs are fixed to Ultra 4.8.3's current-candle wick breakout behavior.
bool bullishWickBar = true
bool bearishWickBar = true
xdown = low < orl and low[1] >= orl
xdown2 = low < (orl - orw * tPer) and low[1] >= (orl - orw * tPer)
xup = high > orh and high[1] <= orh
xup2 = high > (orh + orw * tPer) and high[1] <= (orh + orw * tPer)
float beTriggerDistance = stopStyleDistance(beTriggerStyle, beTriggerTicks, orw)
float beOffsetDistance = stopStyleDistance(beOffsetStyle, beOffsetTicks, orw)

bool tradingDayEntryAllowed = eodEntryAllowed and inTradingSession and tradingCalendarAllowsEntries()
bool bracketPlacementEligible = bracketOrdersForcedOn and or_end and or_token and not bracketOrdersActive and tradingDayEntryAllowed
bool bracketPlacementSignal = bracketPlacementEligible and (na(bracketPlacementAlertBar) or bracketPlacementAlertBar != bar_index)
float bracketBuyPlacementEntry = orh + bracketEntryOffsetTicks * syminfo.mintick
float bracketSellPlacementEntry = orl - bracketEntryOffsetTicks * syminfo.mintick
bool bracketBuyPlacementIsStop = bracketBuyPlacementEntry > close
bool bracketSellPlacementIsStop = bracketSellPlacementEntry < close
if bracketPlacementSignal
    bracketOrdersActive := true
    bracketLongPending := true
    bracketShortPending := true
    bracketLongFilledThisRange := false
    bracketShortFilledThisRange := false
    bracketLongIsStop := bracketBuyPlacementIsStop
    bracketShortIsStop := bracketSellPlacementIsStop
    bracketPlacedBar := bar_index
    bracketId := "ultra-v4-" + syminfo.ticker + "-" + str.tostring(rangeStartTime) + "-" + str.tostring(currentRangeId)
    bracketRangeId := currentRangeId
    bracketRangeResultIdx := currentRangeResultIdx
    bracketEntriesThisRange := 0
    bracketLongLifecycleArmIndex += 1
    bracketShortLifecycleArmIndex += 1
    bracketLongArmId := bracketId + "-arm-" + str.tostring(bracketLongLifecycleArmIndex)
    bracketShortArmId := bracketId + "-arm-" + str.tostring(bracketShortLifecycleArmIndex)
    bracketLongLifecycleTradeId := lifecycleBracketTradeId(bracketLongArmId, 1, 0)
    bracketShortLifecycleTradeId := lifecycleBracketTradeId(bracketShortArmId, -1, 0)
    bracketPlacementAlertBar := bar_index
    pendingRetestActive := false
    pendingRetestSide := 0
    pendingRetestPlacedBar := na
    pendingRetestEntry := na
    pendingRetestTpDist := na
    pendingRetestSlDist := na
    pendingRetestRunner1Dist := na
    pendingRetestRunner2Dist := na
    pendingRetestRunner3Dist := na
    pendingRetestBeTriggerDist := na
    pendingRetestBeOffsetDist := na
    pendingRetestBeRequireClose := false
    pendingRetestRangeId := 0
    pendingRetestIsSplit := false
    pendingRetestIsHalfOut := false
    pendingDownBreakoutBar := na
    pendingUpBreakoutBar := na
    pendingDownEntryLevel := na
    pendingUpEntryLevel := na
    pendingDownBreakoutSlDist := na
    pendingUpBreakoutSlDist := na
    pendingDownDeep := false
    pendingUpDeep := false
if bracketLongRearmAwaitingReset and bar_index > bracketLongRearmEligibleAfterBar and low < bracketLongEntryPrice and tradingDayEntryAllowed
    bracketLongRearmAwaitingReset := false
    bracketLongRearmEligibleAfterBar := na
    bracketLongPending := true
    bracketLongLifecycleArmIndex += 1
    bracketLongArmId := bracketId + "-arm-" + str.tostring(bracketLongLifecycleArmIndex)
    bracketLongLifecycleTradeId := lifecycleBracketTradeId(bracketLongArmId, 1, 0)
    bracketLongIsStop := bracketLongEntryPrice > close
    bracketOrdersActive := true
    bracketPlacedBar := bar_index
    rearmLongAlertBar := bar_index
    rearmLongBracketOrder := true
if bracketShortRearmAwaitingReset and bar_index > bracketShortRearmEligibleAfterBar and high > bracketShortEntryPrice and tradingDayEntryAllowed
    bracketShortRearmAwaitingReset := false
    bracketShortRearmEligibleAfterBar := na
    bracketShortPending := true
    bracketShortLifecycleArmIndex += 1
    bracketShortArmId := bracketId + "-arm-" + str.tostring(bracketShortLifecycleArmIndex)
    bracketShortLifecycleTradeId := lifecycleBracketTradeId(bracketShortArmId, -1, 0)
    bracketShortIsStop := bracketShortEntryPrice < close
    bracketOrdersActive := true
    bracketPlacedBar := bar_index
    rearmShortAlertBar := bar_index
    rearmShortBracketOrder := true
bool bracketCanFillThisBar = bracketPlacementSignal or (not na(bracketPlacedBar) and bar_index > bracketPlacedBar)
bool bracketLongSideAvailable = not oneFillPerSidePerRange or not bracketLongFilledThisRange
bool bracketShortSideAvailable = not oneFillPerSidePerRange or not bracketShortFilledThisRange
bool bracketLongFilled = not eodFlattenActiveBar and tradingDayEntryAllowed and bracketOrdersActive and bracketLongPending and bracketLongSideAvailable and bracketCanFillThisBar and bracketEntriesThisRange < maxBracketEntriesPerRange and (bracketPlacementSignal ? (bracketBuyPlacementIsStop ? high >= bracketBuyPlacementEntry : low <= bracketBuyPlacementEntry) : (bracketLongIsStop ? high >= bracketLongEntryPrice : low <= bracketLongEntryPrice))
if bracketLongFilled
    bracketEntriesThisRange += 1
    bracketLongFilledThisRange := true
    bracketLongPending := false
    bracketLongFillPendingConfirmation := true
    bracketOrdersActive := bracketLongPending or bracketShortPending
bool bracketShortFilled = not eodFlattenActiveBar and tradingDayEntryAllowed and bracketOrdersActive and bracketShortPending and bracketShortSideAvailable and bracketCanFillThisBar and bracketEntriesThisRange < maxBracketEntriesPerRange and (bracketPlacementSignal ? (bracketSellPlacementIsStop ? low <= bracketSellPlacementEntry : high >= bracketSellPlacementEntry) : (bracketShortIsStop ? low <= bracketShortEntryPrice : high >= bracketShortEntryPrice))
if bracketShortFilled
    bracketEntriesThisRange += 1
    bracketShortFilledThisRange := true
    bracketShortPending := false
    bracketShortFillPendingConfirmation := true
    bracketOrdersActive := bracketLongPending or bracketShortPending

if not or_sesh and or_token
    signalBuyEntryLevel := na
    signalSellEntryLevel := na
    signalBuySlOverride := na
    signalSellSlOverride := na
    if pendingRetestActive and bar_index > pendingRetestPlacedBar
        bool pendingRetestFilled = not bracketOrdersForcedOn and tradingDayEntryAllowed and low <= pendingRetestEntry and high >= pendingRetestEntry
