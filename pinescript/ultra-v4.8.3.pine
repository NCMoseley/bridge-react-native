//Variables
//---------------------------------------------------------------------------------------------------------------------{

var up_targs = array.new<target>(na)
var down_targs = array.new<target>(na)
var be_guides = array.new<target>(na)
var trade_guides = array.new<target>(na)
var signals = array.new_label()
var tradeEntries = array.new_float(0)
var tradeEntryBars = array.new_int(0)
var tradeSides = array.new_int(0)
var tradeTpDists = array.new_float(0)
var tradeSlDists = array.new_float(0)
var tradeSlRequireCloseConfirm = array.new_bool(0)
var tradeBeTriggerDists = array.new_float(0)
var tradeBeOffsetDists = array.new_float(0)
var tradeBeRequireCloseConfirm = array.new_bool(0)
var tradeUsesMarketBe = array.new_bool(0)
var tradeRangeIds = array.new_int(0)
var tradeRangeResultIdxs = array.new_int(0)
var tradeBracketIds = array.new_string()
var tradeLifecycleIds = array.new_string()
var tradeQuantities = array.new_float(0)
var tradeIsSplit = array.new_bool(0)
var tradeIsHalfOut = array.new_bool(0)
var tradeSplitTp1Dist = array.new_float(0)
var tradeSplitTp2Dist = array.new_float(0)
var tradeSplitTp3Dist = array.new_float(0)
var tradeSplitTp4Dist = array.new_float(0)
var tradeSplitTp1Hit = array.new_bool(0)
var tradeSplitTp2Hit = array.new_bool(0)
var tradeSplitTp3Hit = array.new_bool(0)
var tradeSplitTp4Hit = array.new_bool(0)
var tradeSplitNewSlDist = array.new_float(0)
var tradeHalfTp1Dist = array.new_float(0)
var tradeHalfTp2Dist = array.new_float(0)
var tradeHalfTp1Hit = array.new_bool(0)
var tradeHalfTp2Hit = array.new_bool(0)
var tradeHalfNewSlDist = array.new_float(0)
var tradeBeTriggered = array.new_bool(0)
var rangeResultValues = array.new_float()
var rangeResultLabels = array.new_label()

// Debug logging functions (must be after signals array is declared)
logSignal(string _signalType, string _reason) =>
    if enablePineAlertLogs
        string _side = _signalType == "up" ? "buy" : "sell"
        log.info("ULTRA 4.8.3 EXPECT side=" + _side + " reason=" + _reason + " bar=" + str.tostring(bar_index))

logAlertFiring(string _alertType, string _condition) =>
    if enablePineAlertLogs
        log.info("ULTRA 4.8.3 FIRE side=" + _alertType + " reason=" + _condition + " bar=" + str.tostring(bar_index))

logAlertBlocked(string _alertType, string _reason) =>
    if enablePineAlertLogs
        log.info("ULTRA 4.8.3 BLOCK side=" + _alertType + " reason=" + _reason + " bar=" + str.tostring(bar_index))

logAudit(string _scope, string _detail) =>
    if enablePineAlertLogs
        log.info("ULTRA 4.8.3 CHECK scope=" + _scope + " detail=" + _detail + " bar=" + str.tostring(bar_index))

varip int alertFiredBar = -1
varip array<string> alertFiredThisBar = array.new<string>(0)
varip array<string> alertQueue = array.new<string>(0)

fireAlert(string _payload) =>
    if not na(_payload) and not array.includes(alertFiredThisBar, _payload)
        array.push(alertFiredThisBar, _payload)
        array.push(alertQueue, _payload)

dispatchBracketBuyAlerts(bool _dispatch, bool _effectiveSplit, bool _effectiveHalfOut, float _splitTp1Qty, float _splitTp2Qty, float _splitTp3Qty, float _splitTp4Qty, float _halfTp1Qty, float _halfRunnerQty, float _quantity, string _splitTp1Json, string _splitTp2Json, string _splitTp3Json, string _splitTp4Json, string _halfTp1Json, string _halfRunnerJson, string _singleJson, bool _sendLifecycle, string _lifecycleTradeId, float _entryPrice) =>
    if _dispatch
        if _quantity > 0
            logAlertFiring("bracket_buy", "range_end/single qty=" + str.tostring(_quantity, "#.##"))
            fireAlert(_singleJson)
        else
            logAlertBlocked("bracket_buy", "zero_quantity")
        if _sendLifecycle and _quantity > 0
            fireAlert(lifecycleEntryJson("entry_armed", _lifecycleTradeId, 1, _quantity, _entryPrice, "buy"))

dispatchBracketSellAlerts(bool _dispatch, bool _effectiveSplit, bool _effectiveHalfOut, float _splitTp1Qty, float _splitTp2Qty, float _splitTp3Qty, float _splitTp4Qty, float _halfTp1Qty, float _halfRunnerQty, float _quantity, string _splitTp1Json, string _splitTp2Json, string _splitTp3Json, string _splitTp4Json, string _halfTp1Json, string _halfRunnerJson, string _singleJson, bool _sendLifecycle, string _lifecycleTradeId, float _entryPrice) =>
    if _dispatch
        if _quantity > 0
            logAlertFiring("bracket_sell", "range_end/single qty=" + str.tostring(_quantity, "#.##"))
            fireAlert(_singleJson)
        else
            logAlertBlocked("bracket_sell", "zero_quantity")
        if _sendLifecycle and _quantity > 0
            fireAlert(lifecycleEntryJson("entry_armed", _lifecycleTradeId, -1, _quantity, _entryPrice, "sell"))

varip bool cancelLongAlertFired = false
varip bool cancelShortAlertFired = false
var int lastCancelLongAlertBar = na
var int lastCancelShortAlertBar = na

int exitEodCancelCooldownBars = 2

dispatchCancelAlert(bool _dispatch, bool _sendLifecycle, string _cancelJson, string _cancelLifecycleTradeId, string _cancelBracketId, int _side, float _quantity, float _entryPrice) =>
    bool _cancelAlreadyFired = _side == 1 ? cancelLongAlertFired : cancelShortAlertFired
    bool _cancelCooldownPassed = _side == 1 ? (na(lastCancelLongAlertBar) ? true : bar_index - lastCancelLongAlertBar >= exitEodCancelCooldownBars) : (na(lastCancelShortAlertBar) ? true : bar_index - lastCancelShortAlertBar >= exitEodCancelCooldownBars)
    bool didFire = false
    if _dispatch and not _cancelAlreadyFired and _cancelCooldownPassed
        logAlertFiring("cancel", _side == 1 ? "long_bracket" : "short_bracket")
        fireAlert(_cancelJson)
        if _sendLifecycle and _quantity > 0
            string _lifecycleTradeId = str.length(_cancelLifecycleTradeId) > 0 ? _cancelLifecycleTradeId : lifecycleBracketTradeId(_cancelBracketId, _side, 0)
            fireAlert(lifecycleEntryJson("entry_cancelled", _lifecycleTradeId, _side, _quantity, _entryPrice, "cancel"))
        didFire := true
    didFire

varip int upAlertFireCount = 0
varip int downAlertFireCount = 0
var int lastUpAlertBar = na
var int lastDownAlertBar = na

varip bool slExitAlertFired = false
varip bool beExitAlertFired = false
varip bool eodExitAlertFired = false

var int lastSlExitAlertBar = na
var int lastBeExitAlertBar = na
var int lastEodExitAlertBar = na

dispatchBuySignalAlerts(bool _placeBuyRetestLimit, bool _upSignal, bool _eodFlattenActiveBar, string _effectiveTrigger, bool _fillBuyRetestLimit, string _buyJson) =>
    bool buyCooldownPassed = na(lastUpAlertBar) ? true : bar_index - lastUpAlertBar >= alertCooldownBars
    bool buyAlertReady = (barstate.isrealtime and upAlertFireCount < alertBurstCount and (upAlertFireCount > 0 or buyCooldownPassed)) or (not barstate.isrealtime and barstate.isconfirmed and buyCooldownPassed)
    bool didFire = false
    if _placeBuyRetestLimit and sigTog and buyAlertReady
        if _eodFlattenActiveBar
            logAlertBlocked("buy", "eodFlattenActiveBar")
        else if _effectiveTrigger != "Wick"
            logAlertBlocked("buy", "trigger=" + _effectiveTrigger)
    if _placeBuyRetestLimit and not _eodFlattenActiveBar and _effectiveTrigger == "Wick" and buyAlertReady
        logAlertFiring("buy", "placeBuyRetestLimit")
        fireAlert(_buyJson)
        didFire := true
    if _upSignal and sigTog and _effectiveTrigger == "Wick" and buyAlertReady
        if _eodFlattenActiveBar
            logAlertBlocked("buy", "eodFlattenActiveBar")
        else if _fillBuyRetestLimit
            logAlertBlocked("buy", "fillBuyRetestLimit")
    if _upSignal and not _eodFlattenActiveBar and _effectiveTrigger == "Wick" and not _fillBuyRetestLimit and buyAlertReady
        logAlertFiring("buy", "up_signal/Wick")
        fireAlert(_buyJson)
        didFire := true
    if _upSignal and sigTog and _effectiveTrigger == "Close" and buyAlertReady
        if _eodFlattenActiveBar
            logAlertBlocked("buy", "eodFlattenActiveBar")
        else if _fillBuyRetestLimit
            logAlertBlocked("buy", "fillBuyRetestLimit")
    if _upSignal and not _eodFlattenActiveBar and _effectiveTrigger == "Close" and not _fillBuyRetestLimit and buyAlertReady
        logAlertFiring("buy", "up_signal/Close")
        fireAlert(_buyJson)
        didFire := true
    didFire

dispatchSellSignalAlerts(bool _placeSellRetestLimit, bool _downSignal, bool _eodFlattenActiveBar, string _effectiveTrigger, bool _fillSellRetestLimit, string _sellJson) =>
    bool sellCooldownPassed = na(lastDownAlertBar) ? true : bar_index - lastDownAlertBar >= alertCooldownBars
    bool sellAlertReady = (barstate.isrealtime and downAlertFireCount < alertBurstCount and (downAlertFireCount > 0 or sellCooldownPassed)) or (not barstate.isrealtime and barstate.isconfirmed and sellCooldownPassed)
    bool didFire = false
    if _placeSellRetestLimit and sigTog and sellAlertReady
        if _eodFlattenActiveBar
            logAlertBlocked("sell", "eodFlattenActiveBar")
        else if _effectiveTrigger != "Wick"
            logAlertBlocked("sell", "trigger=" + _effectiveTrigger)
    if _placeSellRetestLimit and not _eodFlattenActiveBar and _effectiveTrigger == "Wick" and sellAlertReady
        logAlertFiring("sell", "placeSellRetestLimit")
        fireAlert(_sellJson)
        didFire := true
    if _downSignal and sigTog and _effectiveTrigger == "Wick" and sellAlertReady
        if _eodFlattenActiveBar
            logAlertBlocked("sell", "eodFlattenActiveBar")
        else if _fillSellRetestLimit
            logAlertBlocked("sell", "fillSellRetestLimit")
    if _downSignal and not _eodFlattenActiveBar and _effectiveTrigger == "Wick" and not _fillSellRetestLimit and sellAlertReady
        logAlertFiring("sell", "down_signal/Wick")
        fireAlert(_sellJson)
        didFire := true
    if _downSignal and sigTog and _effectiveTrigger == "Close" and sellAlertReady
        if _eodFlattenActiveBar
            logAlertBlocked("sell", "eodFlattenActiveBar")
        else if _fillSellRetestLimit
            logAlertBlocked("sell", "fillSellRetestLimit")
    if _downSignal and not _eodFlattenActiveBar and _effectiveTrigger == "Close" and not _fillSellRetestLimit and sellAlertReady
        logAlertFiring("sell", "down_signal/Close")
        fireAlert(_sellJson)
        didFire := true
    didFire

dispatchExitAlerts(bool _eodFlattenNow, string _eodCancelLongJson, string _eodCancelShortJson, string _eodFlattenExitJson, bool _slExitSignal, bool _beExitSignal, bool _eodFlattenActiveBar, bool _useCloseConfirmedSl, bool _sendBeStopExitAlerts, string _exitJson, string _beExitJson) =>
    bool eodCooldownPassed = na(lastEodExitAlertBar) ? true : bar_index - lastEodExitAlertBar >= exitEodCancelCooldownBars
    bool slCooldownPassed = na(lastSlExitAlertBar) ? true : bar_index - lastSlExitAlertBar >= exitEodCancelCooldownBars
    bool beCooldownPassed = na(lastBeExitAlertBar) ? true : bar_index - lastBeExitAlertBar >= exitEodCancelCooldownBars
    int exitFiredMask = 0
    if _eodFlattenNow and not eodExitAlertFired and eodCooldownPassed
        logAlertFiring("exit", "eod_flatten")
        if str.length(_eodCancelLongJson) > 0
            fireAlert(_eodCancelLongJson)
        if str.length(_eodCancelShortJson) > 0
            fireAlert(_eodCancelShortJson)
        fireAlert(_eodFlattenExitJson)
        exitFiredMask := exitFiredMask + 1
    if _slExitSignal and not _eodFlattenActiveBar and not slExitAlertFired and slCooldownPassed
        logAlertFiring("exit", "stop_loss")
