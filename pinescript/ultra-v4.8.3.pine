        exitFiredMask := exitFiredMask + 2
    if _beExitSignal and not _eodFlattenActiveBar and _sendBeStopExitAlerts and not beExitAlertFired and beCooldownPassed
        logAlertFiring("exit", "protected_stop")
        fireAlert(_beExitJson)
        exitFiredMask := exitFiredMask + 4
    exitFiredMask

