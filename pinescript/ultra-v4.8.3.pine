slRangeTickThreshold = input.int(-1, title = "Fallback SL at:", minval = -1, group = "Preset Overrides", tooltip = "If the opening range is wider than this many ticks, the SL style is forced to the 'Fallback SL Style'. Set to -1 to disable.")
slAboveThresholdStyle = input.string("½ range", title = "Fallback SL Style", options = ["¼ range", "½ range", "2/3 range", "0.728 range", "0.862 range", "1× range", "1.5× range", "Range + buffer"], group = "Preset Overrides", tooltip = "SL style to use when the opening range is wider than the fallback SL at threshold.")
rangeNameOverride = input.string("", title = "Range Name", group = "Preset Overrides", tooltip = "Optional override for the preset range name.\nLeave blank to keep the preset value.")
pointValueOverride = input.float(-1.0, title = "Point Value ($/point)", step = 0.01, group = "Preset Overrides", tooltip = "Optional override for syminfo.pointvalue.\nSet to -1 to use the built-in value.\nUseful for MGC/GC when the built-in is missing or wrong (e.g. MGC ~10.0, GC ~100.0).")

