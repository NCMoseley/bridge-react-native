//@version=6

// Ultra 5.5 can report simulated lifecycle events to the relay through a TradingView (From GPT, please test)
// "Any alert() function call" alert. Configure that alert to use the proxy webhook;
// lifecycle payloads are relay-only and explicit trade_closed events are authoritative.
indicator("ULTRA 5.5", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
//inputs
//---------------------------------------------------------------------------------------------------------------------{

//─── Schedule ───────────────────────────────────────────────────────────────────

tz = "America/New_York"

// Single source of truth for the script version — bump this as the
// alert/lifecycle code iterates. Feeds payload "source" tags and bracket IDs.
string ultraVersion = "5.5"
string ultraSource = "ultra-v" + ultraVersion      // payload extras.source
string ultraIdPrefix = ultraSource + "-"           // bracketId/tradeId prefix

// Bracket ids must carry the range name: ranges sharing a ticker + anchor epoch
// otherwise mint identical ids, which collapses two strategies into one
// physical NT8 bracket (shared legs, shared close) instead of independent
// positions with their own SL/TP/BE behavior.
rangeSlug(string name) =>
    string out = ""
    // Case preserved — tracked_ranges is case-sensitive server-side, so 'A'
    // and 'a' are distinct ranges and must mint distinct slugs.
    string ALNUM = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
    if str.length(name) > 0
        for i = 0 to str.length(name) - 1
            string c = str.substring(name, i, i + 1)
            string enc = switch c
                "-"  => "--"
                " "  => "-20"
                "/"  => "-2F"
                "&"  => "-26"
                "."  => "-2E"
                "+"  => "-2B"
                ":"  => "-3A"
                "!"  => "-21"
                "'"  => "-27"
                "("  => "-28"
                ")"  => "-29"
                ","  => "-2C"
                "="  => "-3D"
                "@"  => "-40"
                "["  => "-5B"
                "]"  => "-5D"
                "_"  => "-5F"
                "#"  => "-23"
                "%"  => "-25"
                "*"  => "-2A"
                ";"  => "-3B"
                "?"  => "-3F"
                "~"  => "-7E"
                => "-5F"
            out += str.contains(ALNUM, c) ? c : enc
    out

// Earliest possible heartbeat — proves the script is executing at all, before
// any preset tables or inputs are touched. If this is the ONLY log you see,
// the failure is in the declarations below.
if barstate.isfirst
    log.info("ULTRA 5.5 BOOT v=" + ultraVersion + " src=" + ultraSource + " t=" + str.format_time(time, "MM-dd HH:mm:ss", tz))

