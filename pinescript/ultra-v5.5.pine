rangeSessionOverride = input.string("", title = "Range Session", group = "Preset Overrides", tooltip = "Optional override for the preset range session.\nLeave blank to keep the preset value.")
riskAmountUsdOverride = input.float(-1.0, title = "Risk ($)", step = 1.0, group = "Preset Overrides", tooltip = "Optional override for preset risk.\nSet to -1 to keep the preset value.")

