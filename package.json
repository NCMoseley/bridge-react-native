{
  "name": "tradovate-browser-bridge",
  "version": "0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "npm run build:extension && (npm run dev:server & npm run build:client:watch; wait)",
    "dev:server": "tsx watch src/index.ts",
    "dev:client": "cd client && npm run dev",
    "build": "npm run build:server && npm run build:client && npm run build:extension",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "cd client && npm run build",
    "build:client:watch": "cd client && npm run build:watch",
    "build:extension": "node scripts/build-extension.mjs",
    "typecheck:extension": "tsc -p extension/tsconfig.json --noEmit",
    "package:extension": "npm run build:extension",
    "start": "node dist/server/index.js",
    "create-user": "tsx src/scripts/create-user.ts",
    "migrate:render": "node scripts/migrate-to-render.mjs",
    "test": "vitest run && cd client && npm test",
    "test:e2e": "bash scripts/e2e/run.sh && node scripts/e2e/ct-run.mjs",
    "test:e2e:tp": "bash scripts/e2e/run.sh",
    "test:e2e:ct": "node scripts/e2e/ct-run.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@emnapi/core": "^2.0.0-alpha.3",
    "@emnapi/runtime": "^2.0.0-alpha.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/chrome": "^0.1.34",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.27.2",
    "pinets": "^0.10.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "yazl": "^3.3.1"
  }
}
